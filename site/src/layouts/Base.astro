---
// 자체 호스팅 웹폰트(CDN 비의존). 한글은 unicode-range로 나뉜 dynamic-subset이라
// 방문 페이지에 필요한 글자 조각만 받는다. mono는 라벨·날짜·코드에 쓰는 JetBrains Mono.
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FeedbackModal from "../components/FeedbackModal.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
}
const { title, description, ogType = "website" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteName = "daily.mcp";
const desc = description ?? "MCP 서버로 글을 발행하며 배운 것을 기록하는 블로그";
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
// OG 이미지(절대 URL). 링크 공유 시 미리보기 썸네일.
const ogImage = Astro.site
  ? new URL(`${base}/og.png`, Astro.site).href
  : `${base}/og.png`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 테마·목록뷰: 렌더 전에 즉시 적용해 깜빡임(FOUC) 방지 */}
    <script is:inline>
      (() => {
        // JS 사용 가능 표시(paint 전 동기 실행). 진입 reveal의 '숨김' 스타일은
        // 이 .js 아래에서만 걸린다 → JS 없으면 콘텐츠가 처음부터 보인다.
        document.documentElement.classList.add("js");
        try {
          const t = localStorage.getItem("theme");
          if (t === "light" || t === "dark")
            document.documentElement.dataset.theme = t;
          // 카드가 기본이라 "list"일 때만 표시한다(없으면 카드).
          if (localStorage.getItem("postview") === "list")
            document.documentElement.dataset.view = "list";
        } catch {}
        // reveal 백스톱: 진입 애니메이션 스크립트가 무슨 이유로든 무장(arm)되지
        // 않으면(모듈 로드 실패·에러) load 직후 숨겨진 .reveal을 전부 노출해
        // "빈 화면"을 막는다. 정상 동작 시엔 reveal-armed가 있어 건너뛴다.
        addEventListener("load", () => {
          setTimeout(() => {
            if (!document.documentElement.classList.contains("reveal-armed"))
              document
                .querySelectorAll(".reveal:not(.in)")
                .forEach((el) => el.classList.add("in"));
          }, 700);
        });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    {/* Cloudflare Web Analytics(#59) — 쿠키리스 방문 통계. dev 잡음 방지로 프로덕션 빌드만.
        beacon이 History API를 후킹해 View Transitions(SPA 전환) 페이지뷰도 집계한다. */}
    {
      import.meta.env.PROD && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "8cd332ae0c714ab6af5476bfb325f388"}'
        />
      )
    }
    <meta
      name="google-site-verification"
      content="ZzTHOda-3IRnq_9Pixa05iTAsexkiSW42I2XB7FM5fQ"
    />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={`${base}/rss.xml`}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ko_KR" />

    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 페이지 전환 애니메이션(다른 글로 이동 시 매끄럽게) -->
    <ClientRouter />
  </head>
  <body class="shell">
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
    <FeedbackModal />

    <button type="button" class="to-top" aria-label="맨 위로" data-to-top>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path
          d="M10 15V6M6 9l4-4 4 4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <script>
      // 테마 토글 + 맨 위로 버튼. 문서 위임으로 한 번만 등록(View Transitions 유지).
      if (!(window as any).__uiBound) {
        (window as any).__uiBound = true;

        const applyTheme = (t: string | null) => {
          const root = document.documentElement;
          if (t === "light" || t === "dark") root.dataset.theme = t;
          else delete root.dataset.theme;
        };
        const currentTheme = () => {
          const set = document.documentElement.dataset.theme;
          if (set) return set;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        };

        // 목록 뷰(카드/리스트). 카드가 기본이라 "list"일 때만 속성을 둔다.
        const applyView = (v: string | null) => {
          const root = document.documentElement;
          if (v === "list") root.dataset.view = "list";
          else delete root.dataset.view;
          document
            .querySelectorAll<HTMLElement>("[data-view-set]")
            .forEach((btn) => {
              const on = btn.dataset.viewSet === (v === "list" ? "list" : "cards");
              btn.setAttribute("aria-pressed", String(on));
            });
        };
        const storedView = () => {
          try {
            return localStorage.getItem("postview");
          } catch {
            return null;
          }
        };

        // View Transitions로 문서를 교체하면 <html>의 data-theme·data-view가
        // 사라지므로 스왑 직후 localStorage 값으로 다시 적용한다(페인트 전).
        document.addEventListener("astro:after-swap", () => {
          try {
            applyTheme(localStorage.getItem("theme"));
          } catch {}
          applyView(storedView());
        });
        // 최초 로드 시 토글 버튼의 aria-pressed를 저장값에 맞춘다
        // (data-view 자체는 head 인라인 스크립트가 이미 적용했다).
        document.addEventListener("astro:page-load", () =>
          applyView(storedView()),
        );

        document.addEventListener("click", async (e) => {
          const target = e.target as HTMLElement;
          if (target.closest("[data-theme-toggle]")) {
            const next = currentTheme() === "dark" ? "light" : "dark";
            applyTheme(next);
            try {
              localStorage.setItem("theme", next);
            } catch {}
          } else if (target.closest("[data-view-set]")) {
            const next =
              target.closest<HTMLElement>("[data-view-set]")!.dataset.viewSet ??
              "cards";
            applyView(next);
            try {
              localStorage.setItem("postview", next);
            } catch {}
          } else if (target.closest("[data-to-top]")) {
            const reduce = window.matchMedia(
              "(prefers-reduced-motion: reduce)",
            ).matches;
            window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
          } else {
            const copyBtn = target.closest<HTMLElement>("[data-copy-code]");
            if (copyBtn) {
              const pre = copyBtn.closest("pre");
              const code = pre?.querySelector("code")?.textContent ?? "";
              try {
                await navigator.clipboard.writeText(code);
              } catch {
                /* 실패 무시 */
              }
              const label = copyBtn.querySelector(".code-copy-label");
              if (label) {
                const prev = label.textContent;
                label.textContent = "복사됨!";
                copyBtn.classList.add("copied");
                window.setTimeout(() => {
                  label.textContent = prev;
                  copyBtn.classList.remove("copied");
                }, 1400);
              }
            }
          }
        });

        // 코드블록마다 복사 버튼 주입(중복 방지)
        const initCodeCopy = () => {
          document.querySelectorAll("pre").forEach((pre) => {
            if (pre.querySelector(".code-copy")) return;
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "code-copy";
            btn.setAttribute("data-copy-code", "");
            btn.setAttribute("aria-label", "코드 복사");
            btn.innerHTML = '<span class="code-copy-label">복사</span>';
            pre.appendChild(btn);
          });
        };
        document.addEventListener("astro:page-load", initCodeCopy);

        // 맨 위로 버튼: 일정 스크롤 이상에서만 표시
        const toTop = () =>
          document.querySelector<HTMLElement>("[data-to-top]");
        const onScroll = () => {
          const btn = toTop();
          if (btn) btn.classList.toggle("show", window.scrollY > 600);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        document.addEventListener("astro:page-load", onScroll);
        onScroll();
      }
    </script>
  </body>
</html>
