---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PostViews from "../../../components/PostViews.astro";
import Pagination from "../../../components/Pagination.astro";
import BlogFilterLinks from "../../../components/BlogFilterLinks.astro";
import { PAGE_SIZE } from "../../../lib/pagination.ts";

// 2페이지 이후만 여기서 생성한다(1페이지는 /posts/index.astro).
// 글 상세는 base 바로 밑(/<slug>/)이라 이 경로와 겹치지 않는다.
export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  const paths = [];
  for (let n = 2; n <= lastPage; n++) {
    paths.push({
      params: { page: String(n) },
      props: {
        pageNum: n,
        items: posts.slice((n - 1) * PAGE_SIZE, n * PAGE_SIZE),
        lastPage,
        total: posts.length,
      },
    });
  }
  return paths;
}

interface Props {
  pageNum: number;
  items: Awaited<ReturnType<typeof getCollection<"blog">>>;
  lastPage: number;
  total: number;
}
const { pageNum, items, lastPage, total } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageHref = (n: number) => (n <= 1 ? `${base}/posts/` : `${base}/posts/page/${n}/`);
---

<Base title={`Posts (${pageNum}페이지)`} description="블로그의 전체 글. 카테고리·태그로도 볼 수 있습니다.">
  <h1>Posts</h1>
  <p class="muted">{total}개의 글 · 최신순 · {pageNum} / {lastPage} 페이지</p>

  <BlogFilterLinks />
  <hr />

  <PostViews posts={items} toggle={false} />
  <Pagination currentPage={pageNum} lastPage={lastPage} hrefFor={pageHref} />
</Base>
