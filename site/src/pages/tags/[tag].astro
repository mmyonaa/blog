---
import Base from "../../layouts/Base.astro";
import { getTagMap, type Post } from "../../lib/tags.ts";
import { fmtDateTime } from "../../lib/date.ts";

export async function getStaticPaths() {
  const map = await getTagMap();
  return [...map.entries()].map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;
---

<Base title={`#${tag} — blog`} description={`${tag} 태그가 달린 글 목록`}>
  <p class="muted"><a href={`${base}/tags/`}>← 전체 태그</a></p>
  <h1>#{tag}</h1>
  <p class="muted">{posts.length}개의 글</p>
  <hr />
  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-item">
          <a href={href(post.id)} class="post-title">
            {post.data.title}
          </a>
          <div class="muted">{fmtDateTime(post.data.pubDate)}</div>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--c-border);
  }
  .post-title {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-text);
  }
  .post-title:hover {
    color: var(--c-accent);
  }
</style>
