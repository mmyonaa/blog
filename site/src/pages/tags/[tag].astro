---
import Base from "../../layouts/Base.astro";
import { getTagMap, type Post } from "../../lib/tags.ts";
import { fmtDateTime } from "../../lib/date.ts";

export async function getStaticPaths() {
  const map = await getTagMap();
  return [...map.entries()].map(([tag, posts]) => ({
    params: { tag },
    props: { tag, posts },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

/** 본문 미리보기. 한 줄을 꽉 채우고 CSS가 끝을 …로 말줄임. */
const preview = (post: Post) => {
  const body = (post.body ?? "")
    .replace(/[`#>*_~\[\]()|-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  const desc = post.data.description?.trim();
  const text = desc ? `${desc} ${body}` : body;
  return text.slice(0, 300);
};
---

<Base title={`#${tag} — blog`} description={`${tag} 태그가 달린 글 목록`}>
  <p class="muted"><a href={`${base}/tags/`}>← 전체 태그</a></p>
  <h1>#{tag}</h1>
  <p class="muted">{posts.length}개의 글</p>
  <hr />
  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-item">
          <a href={href(post.id)} class="post-title">
            {post.data.title}
          </a>
          <div class="muted">{fmtDateTime(post.data.pubDate)}</div>
          <p class="post-desc">{preview(post)}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--c-border);
  }
  .post-title {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-text);
  }
  .post-title:hover {
    color: var(--c-accent);
  }
  .post-desc {
    color: var(--c-muted);
    margin: var(--space-2) 0 0;
    line-height: var(--lh-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
