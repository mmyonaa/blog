---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import PostViews from "../../../components/PostViews.astro";
import Pagination from "../../../components/Pagination.astro";
import { getTagMap, tagSlug } from "../../../lib/tags.ts";
import { PAGE_SIZE } from "../../../lib/pagination.ts";

export const getStaticPaths = (async ({ paginate }) => {
  const map = await getTagMap();
  // URL은 로마자 슬러그로, 화면 표기용 원본 태그는 props로 넘긴다.
  return [...map.entries()].flatMap(([tag, posts]) =>
    paginate(posts, {
      params: { tag: tagSlug(tag) },
      props: { tag },
      pageSize: PAGE_SIZE,
    }),
  );
}) satisfies GetStaticPaths;

const { page, tag } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const seg = Astro.params.tag!;
const pageHref = (n: number) =>
  n <= 1 ? `${base}/tags/${seg}/` : `${base}/tags/${seg}/${n}/`;
---

{/* noindex: 태그 목록은 글 1~2개짜리 얇은 페이지가 대부분 — 색인 대신 링크 추적만 허용 */}
<Base title={`#${tag}`} description={`${tag} 태그가 달린 글 목록`} noindex>
  <p class="muted"><a href={`${base}/topics/#tags`}>← 전체 태그</a></p>
  <h1>#{tag}</h1>
  <p class="muted">
    {page.total}개의 글{page.lastPage > 1 && ` · ${page.currentPage} / ${page.lastPage} 페이지`}
  </p>
  <hr />
  <PostViews posts={page.data} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} hrefFor={pageHref} />
</Base>
