---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import PostViews from "../../../components/PostViews.astro";
import Pagination from "../../../components/Pagination.astro";
import { getTagMap, tagSlug } from "../../../lib/tags.ts";
import { PAGE_SIZE } from "../../../lib/pagination.ts";

export const getStaticPaths = (async ({ paginate }) => {
  const map = await getTagMap();
  // URL은 로마자 슬러그로, 화면 표기용 원본 태그는 props로 넘긴다.
  return [...map.entries()].flatMap(([tag, posts]) =>
    paginate(posts, {
      params: { tag: tagSlug(tag) },
      props: { tag },
      pageSize: PAGE_SIZE,
    }),
  );
}) satisfies GetStaticPaths;

const { page, tag } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const seg = Astro.params.tag!;
const pageHref = (n: number) =>
  n <= 1 ? `${base}/tags/${seg}/` : `${base}/tags/${seg}/${n}/`;
---

{/*
  noindex: 태그 페이지는 카테고리 페이지와 거의 같은 글을 나열한다 — 색인하면
  자기 글끼리 경쟁시키는 꼴이라 링크 추적만 허용한다. 사이트맵에서도 뺀다
  (astro.config.mjs의 filter와 짝).

  ⚠️ "글이 N개 이상인 태그는 열어주자"는 발상은 역효과다. 2026-10-18 전수 확인
  결과 큰 태그일수록 섹션 복제본이었다 — 정보보안기사 12편 = boangisa 섹션 12편
  (100% 동일), mcp 46편 ≈ mcp 섹션 49편, typescript-sdk 10편·ssg 9편은 각각 한
  섹션 안에 전부 들어간다. 편수 임계값은 가장 중복인 페이지부터 고른다.

  GSC에서 태그 URL에 색인을 요청하면 'NOINDEX 태그에 의해 제외' 로 실패하는데,
  이건 설정대로 동작한 것이지 버그가 아니다. 색인 요청은 글 URL로만 넣는다.
*/}
<Base title={`#${tag}`} description={`${tag} 태그가 달린 글 목록`} noindex>
  <p class="muted"><a href={`${base}/topics/#tags`}>← 전체 태그</a></p>
  <h1>#{tag}</h1>
  <p class="muted">
    {page.total}개의 글{page.lastPage > 1 && ` · ${page.currentPage} / ${page.lastPage} 페이지`}
  </p>
  <hr />
  <PostViews posts={page.data} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} hrefFor={pageHref} />
</Base>
