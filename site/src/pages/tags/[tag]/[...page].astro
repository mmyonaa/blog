---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import PostList from "../../../components/PostList.astro";
import Pagination from "../../../components/Pagination.astro";
import { getTagMap } from "../../../lib/tags.ts";
import { PAGE_SIZE } from "../../../lib/pagination.ts";

export const getStaticPaths = (async ({ paginate }) => {
  const map = await getTagMap();
  return [...map.entries()].flatMap(([tag, posts]) =>
    paginate(posts, { params: { tag }, pageSize: PAGE_SIZE }),
  );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const tag = Astro.params.tag!;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const seg = encodeURIComponent(tag);
const pageHref = (n: number) =>
  n <= 1 ? `${base}/tags/${seg}/` : `${base}/tags/${seg}/${n}/`;
---

<Base title={`#${tag} — blog`} description={`${tag} 태그가 달린 글 목록`}>
  <p class="muted"><a href={`${base}/tags/`}>← 전체 태그</a></p>
  <h1>#{tag}</h1>
  <p class="muted">
    {page.total}개의 글{page.lastPage > 1 && ` · ${page.currentPage} / ${page.lastPage} 페이지`}
  </p>
  <hr />
  <PostList posts={page.data} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} hrefFor={pageHref} />
</Base>
