---
// 버전 이력 페이지 — 단일 출처는 레포 루트 CHANGELOG.md.
// 빌드 타임에 그 마크다운을 그대로 가져와 사이트 디자인으로 렌더한다(내용 이중화 없음).
import Base from "../layouts/Base.astro";
import { Content as Changelog } from "../../../CHANGELOG.md";
---

<Base
  title="Changelog"
  description="이 블로그와 MCP 서버의 버전별 변경 이력"
>
  <article class="cl-body">
    <Changelog />
  </article>
</Base>

<style>
  .cl-body {
    max-width: 44rem;
    margin: 0 auto;
    padding-top: var(--space-6);
  }
  .cl-body :global(h1) {
    /* 크기는 global h1 clamp(모바일 축소)에 맡긴다 — 여기서 고정하면 좁은 폰에서 안 줄어듦. */
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3);
  }
  /* 버전 헤딩 — 릴리스 단위 구분선 */
  .cl-body :global(h2) {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-border);
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }
  .cl-body :global(h3) {
    margin-top: var(--space-5);
    font-size: var(--fs-base);
  }
  .cl-body :global(p),
  .cl-body :global(li) {
    line-height: 1.8;
    word-break: keep-all;
  }
  .cl-body :global(ul) {
    padding-left: 1.2em;
  }
  .cl-body :global(li)::marker {
    color: var(--c-muted);
  }
  .cl-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--c-surface-2, var(--c-surface));
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.35em;
  }
  .cl-body :global(a) {
    color: var(--c-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
