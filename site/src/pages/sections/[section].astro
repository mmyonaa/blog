---
import Base from "../../layouts/Base.astro";
import { getSectionMap, sectionLabel, type Post } from "../../lib/sections.ts";
import { tagHref } from "../../lib/tags.ts";
import { fmtDateTime } from "../../lib/date.ts";

export async function getStaticPaths() {
  const map = await getSectionMap();
  return [...map.entries()].map(([section, posts]) => ({
    params: { section },
    props: { section, posts },
  }));
}

interface Props {
  section: string;
  posts: Post[];
}
const { section, posts } = Astro.props as Props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;
const label = sectionLabel(section);
---

<Base title={`${label} — blog`} description={`${label} 섹션의 글 목록`}>
  <p class="muted"><a href={`${base}/sections/`}>← 전체 섹션</a></p>
  <h1>{label}</h1>
  <p class="muted">{posts.length}개의 글</p>
  <hr />
  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-item">
          <div class="muted post-date">{fmtDateTime(post.data.pubDate)}</div>
          <h2 class="post-title">
            <a href={href(post.id)}>{post.data.title}</a>
          </h2>
          {post.data.description && <p class="post-desc">{post.data.description}</p>}
          {post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((t) => (
                <a class="pill" href={tagHref(base, t)}>
                  {t}
                </a>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--c-border);
  }
  .post-date {
    font-size: var(--fs-xs);
  }
  .post-title {
    font-size: var(--fs-xl);
    margin: var(--space-1) 0 var(--space-2);
  }
  .post-title a {
    color: var(--c-text);
  }
  .post-title a:hover {
    color: var(--c-accent);
    text-decoration: none;
  }
  .post-desc {
    color: var(--c-muted);
    margin: 0 0 var(--space-3);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
