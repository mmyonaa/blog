---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;
---

<Base title="blog-mcp" description="MCP를 배우며 자동 발행하는 블로그">
  <h1>blog-mcp</h1>
  <p class="muted">MCP를 직접 만들어 배우고, 그 과정을 자동으로 기록하는 블로그.</p>
  <hr />
  {
    posts.length === 0 ? (
      <p>아직 발행된 글이 없습니다.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={href(post.id)} class="post-title">
              {post.data.title}
            </a>
            <div class="muted post-meta">
              {post.data.pubDate.toISOString().slice(0, 10)}
              {post.data.tags.length > 0 && <> · {post.data.tags.join(", ")}</>}
            </div>
            {post.data.description && <p class="post-desc">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--c-border);
  }
  .post-title {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-text);
  }
  .post-title:hover {
    color: var(--c-accent);
  }
  .post-meta {
    margin-top: var(--space-1);
  }
  .post-desc {
    margin: var(--space-2) 0 0;
    color: var(--c-muted);
  }
</style>
