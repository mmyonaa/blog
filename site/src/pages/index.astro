---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { tagHref } from "../lib/tags.ts";
import { getSectionCounts, sectionHref } from "../lib/sections.ts";
import { fmtDateTime } from "../lib/date.ts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const sections = await getSectionCounts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

// 랜딩엔 최신 글만: featured 1개 + 최근 글 최대 6개. 나머지는 '전체 글 보기'로.
const RECENT_MAX = 6;
const [featured, ...others] = posts;
const rest = others.slice(0, RECENT_MAX);
---

<Base title="blog" description="MCP 만들기와 정보처리기사 개념을 매일 기록하는 학습 블로그">
  <section class="hero">
    <h1 class="hero-title">blog</h1>
    <p class="hero-sub">
      MCP를 직접 만들며 배운 것과 정보처리기사 개념을, 매일 한 편씩 기록합니다.
    </p>
    {
      sections.length > 0 && (
        <nav class="sections-strip" aria-label="카테고리">
          {sections.map((s) => (
            <a class="sec-pill" href={sectionHref(base, s.id)}>
              {s.label} <span class="sec-pill-count">{s.count}</span>
            </a>
          ))}
        </nav>
      )
    }
  </section>

  {
    posts.length === 0 ? (
      <p class="muted">아직 발행된 글이 없습니다.</p>
    ) : (
      <>
        <article class="featured">
          <span class="featured-label">FEATURED · {fmtDateTime(featured.data.pubDate)}</span>
          <h2 class="featured-title">
            <a href={href(featured.id)}>{featured.data.title}</a>
          </h2>
          {featured.data.description && <p class="featured-desc">{featured.data.description}</p>}
          <span class="read">읽기 →</span>
          {featured.data.tags.length > 0 && (
            <div class="tags">
              {featured.data.tags.map((t) => (
                <a class="pill" href={tagHref(base, t)}>
                  {t}
                </a>
              ))}
            </div>
          )}
        </article>

        {rest.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="section-title">최근 글</h2>
              <a class="more" href={`${base}/blog/`}>전체 글 보기 →</a>
            </div>
            <div class="grid">
              {rest.map((post) => (
                <article class="card">
                  <div class="muted card-meta">{fmtDateTime(post.data.pubDate)}</div>
                  <h3 class="card-title">
                    <a href={href(post.id)}>{post.data.title}</a>
                  </h3>
                  {post.data.description && <p class="card-desc">{post.data.description}</p>}
                  {post.data.tags.length > 0 && (
                    <div class="tags">
                      {post.data.tags.map((t) => (
                        <a class="pill" href={tagHref(base, t)}>
                          {t}
                        </a>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </>
        )}
      </>
    )
  }
</Base>

<style>
  .hero {
    padding: var(--space-6) 0 var(--space-8);
  }
  .hero-title {
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    margin: 0 0 var(--space-3);
  }
  .hero-sub {
    color: var(--c-muted);
    font-size: var(--fs-lg);
    max-width: 40ch;
    margin: 0;
  }
  .sections-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .sec-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.9em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full, 999px);
    background: var(--c-surface);
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .sec-pill:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    background: var(--c-accent-soft);
  }
  .sec-pill-count {
    color: var(--c-accent);
    font-weight: 700;
  }

  /* stretched-link 패턴: 카드는 div, 제목 링크가 카드 전체를 덮고,
     태그 링크는 그 위(z-index)로 올려 별도 클릭 가능하게 유지 */
  .featured,
  .card {
    position: relative;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .featured:hover,
  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .featured-title a,
  .card-title a {
    color: inherit;
    text-decoration: none;
  }
  .featured-title a::after,
  .card-title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .tags {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .featured {
    padding: var(--space-6);
    background: var(--c-accent-soft);
    box-shadow: var(--shadow-sm);
  }
  .featured:hover {
    border-color: var(--c-accent);
  }
  .featured-label {
    color: var(--c-accent);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .featured-title {
    font-size: var(--fs-2xl);
    margin: var(--space-2) 0 var(--space-3);
  }
  .featured-desc {
    color: var(--c-muted);
    margin: 0 0 var(--space-4);
  }
  .read {
    display: inline-block;
    color: var(--c-accent);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-8) 0 var(--space-4);
  }
  .section-title {
    font-size: var(--fs-lg);
    margin: 0;
  }
  .more {
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    /* 3열이 컨테이너 폭을 균등 분할 → 오른쪽 끝이 featured·'전체 글 보기'와 정렬 */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .card {
    padding: var(--space-5);
    background: var(--c-surface);
  }
  .card:hover {
    border-color: var(--c-accent);
  }
  .card-title {
    font-size: var(--fs-lg);
    margin: var(--space-1) 0 var(--space-2);
  }
  .card-title a:hover {
    color: var(--c-accent);
  }
  .card-desc {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-3);
  }

  /* 태블릿: 3열이 좁아지기 전에 2열로 */
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ── 모바일 (#27) ── */
  @media (max-width: 640px) {
    .hero {
      padding: var(--space-5) 0 var(--space-6);
    }
    /* featured 카드: 좁은 화면에서 패딩을 줄여 본문 폭 확보 */
    .featured {
      padding: var(--space-5);
    }
    /* 최근 글: 카드가 featured와 같은 폭으로 꽉 차게(좌측 고정 폭 → 단일 풀폭) */
    .grid {
      grid-template-columns: 1fr;
    }
    /* section-head: 제목과 '전체 글 보기'가 좁을 땐 세로로 */
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
  }
</style>
