---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { tagHref, getTagCounts } from "../lib/tags.ts";
import { getSectionCounts, sectionHref, hueOf } from "../lib/sections.ts";
import { fmtDateTime } from "../lib/date.ts";
import { buildActivity, heatLevel } from "../lib/activity.ts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const sections = await getSectionCounts();
const tags = await getTagCounts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

// 랜딩엔 최신 글만: featured 1개 + 최근 글 최대 6개. 나머지는 '전체 글 보기'로.
const RECENT_MAX = 6;
const [featured, ...others] = posts;
const rest = others.slice(0, RECENT_MAX);

// ── 히어로 통계 ──
// 로컬 날짜 키(YYYY-MM-DD). '연속 발행'은 가장 최근 글 날짜부터 하루씩 거슬러
// 글이 있는 날이 이어지는 최대 길이.
const dayKey = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};
const daySet = new Set(posts.map((p) => dayKey(p.data.pubDate)));
let streak = 0;
if (posts.length > 0) {
  const cursor = new Date(posts[0].data.pubDate);
  while (daySet.has(dayKey(cursor))) {
    streak++;
    cursor.setDate(cursor.getDate() - 1);
  }
}
const stats = [
  { value: posts.length, label: "발행 글", href: `${base}/blog/` },
  { value: streak, label: "일 연속 발행" },
  { value: sections.length, label: "카테고리", href: `${base}/categories/` },
  { value: tags.length, label: "태그", href: `${base}/tags/` },
];

// 발행 스트릭 잔디(heatmap): 글 pubDate를 주×요일 격자로.
const activity = buildActivity(posts.map((p) => p.data.pubDate));

// 카테고리별 액센트 hue는 lib/sections.ts에 있다(카드뷰와 공유).
---

<Base title="blog" description="MCP 서버로 글을 발행하며 배운 것을 기록하는 블로그">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
    </div>
    <div class="hero-inner">
      <h1 class="hero-title reveal" style="--i: 0">blog</h1>
      <p class="hero-sub reveal" style="--i: 1">
        직접 만든 MCP 서버가 쓰고, 제가 배운 걸로 채웁니다.
      </p>
      {
        posts.length > 0 && (
          <dl class="stats reveal" style="--i: 2">
            {stats.map((s) => (
              <div class:list={["stat", { "stat-link": s.href }]}>
                <dt class="stat-value" data-countup={s.value}>{s.value}</dt>
                <dd class="stat-label">
                  {s.href ? (
                    <a href={s.href} class="stat-a">{s.label}</a>
                  ) : (
                    s.label
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        posts.length > 0 && (
          <section class="activity reveal" style="--i: 3" aria-label="발행 활동">
            <div class="heatmap" role="img" aria-label={`최근 ${activity.weeks}주 발행 활동 · 총 ${activity.total}편`}>
              <div class="heatmap-months" style={`--weeks: ${activity.weeks}`}>
                {activity.months.map((m) => (
                  <span class="hm-month" style={`grid-column: ${m.col} / span ${m.span}`}>
                    {m.name}
                  </span>
                ))}
              </div>
              <div class="heatmap-grid" style={`--weeks: ${activity.weeks}`}>
                {activity.cells.map((c) => (
                  <span
                    class:list={["hm-cell", `lv${heatLevel(c.count)}`, { "hm-future": c.future }]}
                    data-tip={c.future ? undefined : `${c.date.getFullYear()}. ${c.date.getMonth() + 1}. ${c.date.getDate()}. · ${c.count}편`}
                  />
                ))}
              </div>
            </div>
            <div class="heatmap-legend">
              <span>적음</span>
              <span class="hm-cell lv0" data-tip="0편" />
              <span class="hm-cell lv1" data-tip="1~4편" />
              <span class="hm-cell lv2" data-tip="5~9편" />
              <span class="hm-cell lv3" data-tip="10편 이상" />
              <span>많음</span>
            </div>
            <div class="hm-tip" role="status" aria-live="polite" hidden></div>
          </section>
        )
      }
      {
        sections.length > 0 && (
          <nav class="sections-strip reveal" style="--i: 4" aria-label="카테고리">
            {sections.map((s) => (
              <a
                class="sec-pill"
                href={sectionHref(base, s.id)}
                style={`--pill-accent: ${hueOf(s.id)}`}
              >
                {s.label} <span class="sec-pill-count">{s.count}</span>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </section>

  {
    posts.length === 0 ? (
      <p class="muted">아직 발행된 글이 없습니다.</p>
    ) : (
      <>
        <article class="featured reveal" style="--i: 5" data-spot>
          <span class="featured-label">
            <span class="badge-new">NEW</span>
            FEATURED · {fmtDateTime(featured.data.pubDate)}
          </span>
          <h2 class="featured-title">
            <a href={href(featured.id)}>{featured.data.title}</a>
          </h2>
          {featured.data.description && <p class="featured-desc">{featured.data.description}</p>}
          <span class="read">읽기 →</span>
          {featured.data.tags.length > 0 && (
            <div class="tags">
              {featured.data.tags.map((t) => (
                <a class="pill" href={tagHref(base, t)}>
                  {t}
                </a>
              ))}
            </div>
          )}
        </article>

        {rest.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="section-title">최근 글</h2>
              <a class="more" href={`${base}/blog/`}>전체 글 보기 →</a>
            </div>
            <div class="grid">
              {rest.map((post, i) => (
                <article class="card reveal" style={`--i: ${6 + i}`} data-spot>
                  <div class="muted card-meta">{fmtDateTime(post.data.pubDate)}</div>
                  <h3 class="card-title">
                    <a href={href(post.id)}>{post.data.title}</a>
                  </h3>
                  {post.data.description && <p class="card-desc">{post.data.description}</p>}
                  {post.data.tags.length > 0 && (
                    <div class="tags">
                      {post.data.tags.map((t) => (
                        <a class="pill" href={tagHref(base, t)}>
                          {t}
                        </a>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </>
        )}
      </>
    )
  }
</Base>

<script>
  // 카드 커서 스포트라이트: [data-spot] 위에서 마우스 좌표를 CSS 변수로 흘려보낸다.
  // 문서 위임 + 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__spotBound) {
    (window as any).__spotBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce) {
      document.addEventListener(
        "pointermove",
        (e) => {
          const el = (e.target as HTMLElement)?.closest?.<HTMLElement>("[data-spot]");
          if (!el) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty("--mx", `${e.clientX - r.left}px`);
          el.style.setProperty("--my", `${e.clientY - r.top}px`);
        },
        { passive: true },
      );
    }

    // 통계 카운트업: [data-countup]을 0→값으로. reduced-motion이면 즉시 최종값.
    const runCountUp = () => {
      document.querySelectorAll<HTMLElement>("[data-countup]").forEach((el) => {
        const target = parseInt(el.getAttribute("data-countup") || "0", 10);
        if (!Number.isFinite(target) || reduce || target <= 0) {
          el.textContent = String(Number.isFinite(target) ? target : 0);
          return;
        }
        const dur = 850;
        let startT = 0;
        el.textContent = "0";
        const tick = (now: number) => {
          if (!startT) startT = now;
          const t = Math.min(1, (now - startT) / dur);
          const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      });
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runCountUp);

    // 잔디 칸/범례 호버 툴팁: '날짜 · N편'(칸) 또는 레벨 범위(범례)를 표시.
    // 툴팁은 .activity 기준 absolute. (.activity가 reveal 애니메이션으로 항등 transform을
    // 남겨 containing block이 되므로, 그 기준으로 좌표를 계산해야 어긋나지 않는다.)
    const showTip = (cell: HTMLElement) => {
      const tip = document.querySelector<HTMLElement>(".hm-tip");
      const host = tip?.parentElement;
      const text = cell.getAttribute("data-tip");
      if (!tip || !host || !text) return;
      tip.textContent = text;
      tip.hidden = false;
      const c = cell.getBoundingClientRect();
      const h = host.getBoundingClientRect();
      const t = tip.getBoundingClientRect();
      tip.style.left = `${c.left - h.left + c.width / 2 - t.width / 2}px`;
      const above = c.top - h.top - t.height - 6;
      // 카드 위로 넘치면 칸 아래에 표시
      tip.style.top = `${above < 0 ? c.bottom - h.top + 6 : above}px`;
    };
    const hideTip = () => {
      const tip = document.querySelector<HTMLElement>(".hm-tip");
      if (tip) tip.hidden = true;
    };
    document.addEventListener("pointerover", (e) => {
      const cell = (e.target as HTMLElement)?.closest?.<HTMLElement>(".hm-cell[data-tip]");
      if (cell) showTip(cell);
    });
    document.addEventListener("pointerout", (e) => {
      const cell = (e.target as HTMLElement)?.closest?.<HTMLElement>(".hm-cell[data-tip]");
      if (cell) hideTip();
    });
  }
</script>

<style>
  /* ══════════════════════════════════════════════════════════
     히어로 — 오로라 블롭 배경 + 도트 패턴 + 그라디언트 제목
     ══════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    padding: var(--space-8) 0 var(--space-8);
    isolation: isolate;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }

  /* 미세 도트 패턴: 뷰포트 전체 폭(풀블리드)으로 깔고 아래로 페이드아웃.
     컨테이너 폭에 갇히지 않도록 100vw를 히어로 중심에 맞춰 배치. */
  .hero::before {
    content: "";
    position: absolute;
    top: -20%;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -2;
    background-image: radial-gradient(
      var(--c-border) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(
      120% 90% at 50% 0%,
      #000 0%,
      transparent 70%
    );
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 0%, transparent 70%);
    opacity: 0.4;
    /* 장식 레이어 — 헤더/콘텐츠 클릭을 절대 가로채지 않게 */
    pointer-events: none;
  }

  /* 오로라 블롭: 뷰포트 전체 폭(풀블리드)에 흐릿한 광원 2~3개 */
  .hero-bg {
    position: absolute;
    top: -40%;
    bottom: -20%;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.3;
    will-change: transform;
  }
  .blob-1 {
    width: 42vw;
    max-width: 460px;
    aspect-ratio: 1;
    top: -8%;
    left: -6%;
    background: radial-gradient(circle, #a855f7, transparent 68%);
  }
  .blob-2 {
    width: 34vw;
    max-width: 380px;
    aspect-ratio: 1;
    top: -14%;
    right: 4%;
    background: radial-gradient(circle, #6366f1, transparent 68%);
    opacity: 0.24;
  }
  .blob-3 {
    width: 30vw;
    max-width: 340px;
    aspect-ratio: 1;
    top: 22%;
    left: 34%;
    background: radial-gradient(circle, #ec4899, transparent 70%);
    opacity: 0.15;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .blob {
      opacity: 0.22;
    }
    :root:not([data-theme="light"]) .hero::before {
      opacity: 0.25;
    }
  }
  :root[data-theme="dark"] .blob {
    opacity: 0.22;
  }
  :root[data-theme="dark"] .hero::before {
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: no-preference) {
    .blob-1 {
      animation: drift1 18s ease-in-out infinite alternate;
    }
    .blob-2 {
      animation: drift2 22s ease-in-out infinite alternate;
    }
    .blob-3 {
      animation: drift3 26s ease-in-out infinite alternate;
    }
  }
  @keyframes drift1 {
    to {
      transform: translate(8%, 12%) scale(1.12);
    }
  }
  @keyframes drift2 {
    to {
      transform: translate(-10%, 8%) scale(1.08);
    }
  }
  @keyframes drift3 {
    to {
      transform: translate(6%, -10%) scale(1.15);
    }
  }

  .hero-title {
    font-size: clamp(2.75rem, 8vw, 4rem);
    /* background-clip:text에선 배경 박스 높이가 line-height라, 너무 좁으면
       'g' 같은 descender가 배경 밖으로 나가 투명 처리(잘림)된다. 여유 확보. */
    line-height: 1.18;
    padding-bottom: 0.06em;
    margin: 0 0 var(--space-3);
    background: linear-gradient(115deg, #7c3aed 0%, #a855f7 45%, #ec4899 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-title {
      animation: sheen 8s ease-in-out infinite alternate;
    }
  }
  @keyframes sheen {
    to {
      background-position: 100% center;
    }
  }
  .hero-sub {
    color: var(--c-muted);
    font-size: var(--fs-lg);
    max-width: 42ch;
    margin: 0;
  }

  /* ── 통계 스트립 ── */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: var(--space-5) 0 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  /* 클릭 가능한 통계: 라벨 링크가 stat 전체를 덮어 숫자까지 클릭되게 */
  .stat-link {
    position: relative;
  }
  .stat-a {
    color: inherit;
    text-decoration: none;
  }
  .stat-a::after {
    content: "";
    position: absolute;
    inset: -0.2em -0.3em;
    border-radius: var(--radius-sm);
  }
  .stat-link:hover .stat-label {
    color: var(--c-accent);
  }
  .stat-value {
    font-size: var(--fs-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(120deg, var(--c-accent), var(--c-accent-hover));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .stat-label {
    margin: 0.15em 0 0;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    letter-spacing: 0.02em;
  }

  /* ── 발행 스트릭 잔디(heatmap) ── */
  .activity {
    position: relative;
    margin-top: var(--space-6);
    max-width: 100%;
  }
  /* 좁은 화면에선 격자가 넘칠 수 있으니 가로 스크롤 허용 */
  .heatmap {
    overflow-x: auto;
    padding-bottom: 2px;
  }
  /* 월 라벨과 칸 격자는 같은 고정 열 폭(16px)을 써서 정렬을 맞춘다 */
  .heatmap-months {
    display: grid;
    grid-template-columns: repeat(var(--weeks), 16px);
    gap: 3px;
    margin-bottom: 5px;
    min-width: max-content;
  }
  .hm-month {
    font-size: 0.7rem;
    line-height: 1;
    color: var(--c-muted);
    white-space: nowrap;
    overflow: visible;
  }
  .heatmap-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 16px);
    grid-auto-columns: 16px;
    gap: 3px;
    min-width: max-content;
  }
  .hm-cell {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--c-surface-2);
  }
  .hm-cell.lv1 {
    background: color-mix(in srgb, var(--c-accent) 32%, var(--c-surface-2));
  }
  .hm-cell.lv2 {
    background: color-mix(in srgb, var(--c-accent) 62%, var(--c-surface-2));
  }
  .hm-cell.lv3 {
    background: var(--c-accent);
  }
  .hm-future {
    visibility: hidden;
  }
  .heatmap-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: var(--space-3);
    font-size: 0.7rem;
    color: var(--c-muted);
  }
  .heatmap-legend .hm-cell {
    width: 13px;
    height: 13px;
  }
  /* 잔디 칸/범례 호버 툴팁 */
  .hm-cell[data-tip] {
    cursor: pointer;
  }
  .hm-tip {
    position: absolute;
    z-index: 50;
    padding: 0.35em 0.6em;
    border-radius: var(--radius-sm);
    background: var(--c-text);
    color: var(--c-bg);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: var(--shadow-md);
  }
  .hm-tip[hidden] {
    display: none;
  }

  .sections-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .sec-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.9em;
    border: 1px solid
      color-mix(in srgb, var(--pill-accent) 35%, var(--c-border));
    border-radius: var(--radius-pill, 999px);
    background: color-mix(in srgb, var(--pill-accent) 8%, var(--c-surface));
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease,
      background 0.15s ease, transform 0.15s ease;
  }
  .sec-pill:hover {
    border-color: var(--pill-accent);
    color: var(--pill-accent);
    background: color-mix(in srgb, var(--pill-accent) 16%, transparent);
    transform: translateY(-1px);
  }
  .sec-pill-count {
    color: var(--pill-accent);
    font-weight: 700;
  }

  /* ══════════════════════════════════════════════════════════
     카드 — 스포트라이트 + 글로우 보더
     ══════════════════════════════════════════════════════════ */
  /* stretched-link 패턴: 카드는 div, 제목 링크가 카드 전체를 덮고,
     태그 링크는 그 위(z-index)로 올려 별도 클릭 가능하게 유지 */
  .featured,
  .card {
    position: relative;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    transition: box-shadow 0.2s ease, transform 0.2s ease,
      border-color 0.2s ease;
    isolation: isolate;
  }
  /* 커서 스포트라이트: 마우스 위치(--mx/--my)에 은은한 광원 */
  .featured::before,
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--c-accent) 22%, transparent),
      transparent 45%
    );
    opacity: 0;
