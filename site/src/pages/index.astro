---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import FeaturedCard from "../components/home/FeaturedCard.astro";
import TopReads from "../components/home/TopReads.astro";
import PostCard from "../components/home/PostCard.astro";
import SectionNav from "../components/home/SectionNav.astro";
import { getTagCounts } from "../lib/tags.ts";
import { getSectionCounts, sectionOf } from "../lib/sections.ts";
import { buildActivity } from "../lib/activity.ts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const sections = await getSectionCounts();
const tags = await getTagCounts();
// 히어로 카테고리 아래 인기 태그: 글 수 상위 순. 어떤 폭에서도 2줄이 꽉 차도록 전량을
// 넘기고, PopularTags가 CSS로 2줄만 남기고 클립한다(적게 넘기면 둘째 줄이 중간에서 빈다).
// 클립돼 안 보이는 태그는 컴포넌트 스크립트가 탭 순서·스크린리더에서 제외한다(#4).
const topTags = tags;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// 랜딩 상단: 왼쪽 '최신 글'(featured 1개) + 오른쪽 'Top Reads'(카테고리별 최신).
// 조회수 데이터가 없으므로 오른쪽은 가짜 인기순 대신 카테고리별 최신 글로 채운다
// (스프레드 → 사실상 '읽을거리 top picks'). 그 아래 '최근 글' 그리드가 이어진다.
// 최근 글 5개: 첫 카드가 2칸 폭(wide)이라 2+1+1+1+1 = 6유닛 = 3열×2행이 깔끔하게 찬다
// (6개면 7유닛이 되어 마지막 칸이 붕 뜬다).
const RECENT_MAX = 5;
const TOP_READS_MAX = 4;
const [featured, ...others] = posts;


// 오른쪽: 카테고리(getSectionCounts 순서)별 최신 글, featured 제외, 최대 4개.
const usedIds = new Set([featured?.id]);
const topReads: typeof others = [];
for (const s of sections) {
  if (topReads.length >= TOP_READS_MAX) break;
  const p = others.find((o) => sectionOf(o) === s.id && !usedIds.has(o.id));
  if (p) {
    topReads.push(p);
    usedIds.add(p.id);
  }
}
// 그 아래 '최근 글' 그리드: featured·topReads에 안 쓰인 최신 글.
const rest = others.filter((o) => !usedIds.has(o.id)).slice(0, RECENT_MAX);

// ── 히어로 통계 ──
// 로컬 날짜 키(YYYY-MM-DD). '연속 발행'은 가장 최근 글 날짜부터 하루씩 거슬러
// 글이 있는 날이 이어지는 최대 길이.
const dayKey = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};
const daySet = new Set(posts.map((p) => dayKey(p.data.pubDate)));
// 오늘(아직 안 썼으면 어제)부터 거슬러 센다. 발행이 끊겼으면 0 → 통계에서 숨김.
let streak = 0;
if (posts.length > 0) {
  const cursor = new Date();
  if (!daySet.has(dayKey(cursor))) cursor.setDate(cursor.getDate() - 1);
  while (daySet.has(dayKey(cursor))) {
    streak++;
    cursor.setDate(cursor.getDate() - 1);
  }
}
const stats = [
  { value: posts.length, label: "발행 글", href: `${base}/blog/` },
  ...(streak > 0 ? [{ value: streak, label: "일 연속 발행" }] : []),
  { value: sections.length, label: "카테고리", href: `${base}/topics/` },
  { value: tags.length, label: "태그", href: `${base}/topics/#tags` },
];

// 발행 스트릭 잔디(heatmap): 글 pubDate를 주×요일 격자로.
// minWeeks 25는 히어로 오른쪽 열 폭(Hero.astro의 30rem)을 채우는 주 수 — 함께 조정.
const activity = buildActivity(posts.map((p) => p.data.pubDate), { minWeeks: 25 });
---

<Base title="daily.mcp" description="MCP 서버로 글을 발행하며 배운 것을 기록하는 블로그">
  <noscript>
    {/* reveal은 스크립트가 트리거하므로, JS 미실행 환경에선 숨김을 해제 */}
    <style is:inline>
      .reveal {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>

  <Hero
    hasPosts={posts.length > 0}
    stats={stats}
    activity={activity}
    topTags={topTags}
    base={base}
  />

  {
    posts.length === 0 ? (
      <p class="muted">아직 발행된 글이 없습니다.</p>
    ) : (
      <>
        <section class="top-section">
          <div class="latest-col">
            <div class="section-head">
              <h2 class="section-title">최신 글</h2>
            </div>
            <FeaturedCard post={featured} />
          </div>
          {topReads.length > 0 && (
            <aside class="reads-col">
              <div class="section-head">
                <h2 class="section-title">카테고리별 새 글</h2>
              </div>
              <TopReads posts={topReads} />
            </aside>
          )}
        </section>

        {sections.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="section-title">카테고리</h2>
              <a class="more" href={`${base}/topics/`}>전체 분류 →</a>
            </div>
            <SectionNav sections={sections} base={base} />
          </>
        )}

        {rest.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="section-title">최근 글</h2>
              <a class="more" href={`${base}/blog/`}>전체 글 보기 →</a>
            </div>
            <div class="grid">
              {rest.map((post, i) => (
                <PostCard post={post} wide={i === 0} />
              ))}
            </div>
          </>
        )}
      </>
    )
  }
</Base>

<script>
  // 페이지 공통 인터랙션(진입 reveal)만 여기서 담당.
  // 히어로·잔디 등 컴포넌트 고유 동작은 각 컴포넌트의 <script>에 있다.
  // 문서 위임 + 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__spotBound) {
    (window as any).__spotBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 진입 reveal: 뷰포트에 들어온 .reveal에 .in을 부여해 애니메이션 시작.
    // 최초 로드 땐 화면 위 요소들이 한 배치로 들어와 기존과 같은 stagger,
    // 폴드 아래 카드는 스크롤로 보일 때 각자 작은 stagger로 뜬다.
    const runReveal = () => {
      const els = document.querySelectorAll<HTMLElement>(".reveal:not(.in)");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          let batch = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            el.style.setProperty("--d", `${batch++ * 70}ms`);
            el.classList.add("in");
            io.unobserve(el);
          }
        },
        { threshold: 0.1 },
      );
      els.forEach((el) => io.observe(el));
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runReveal);
  }
</script>

<style is:global>
  /* ══════════════════════════════════════════════════════════
     진입 애니메이션 — 뷰포트에 들어올 때 스크립트가 .in을 부여.
     같은 배치로 들어온 요소끼리 --d(70ms 간격)로 stagger.
     .reveal은 히어로·잔디·카드 등 여러 컴포넌트에 걸쳐 쓰여 전역으로 둔다.
     ══════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      opacity: 0;
      transform: translateY(14px);
    }
    .reveal.in {
      animation: reveal-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes reveal-up {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-8) 0 var(--space-4);
  }
  .section-title {
    font-size: var(--fs-lg);
    margin: 0;
  }
  .more {
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  /* ── 상단 2단: 왼쪽 '최신 글'(대표) + 오른쪽 'Top Reads' 리스트 ── */
  .top-section {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    margin-top: var(--space-6);
  }
  .top-section .section-head {
    /* 두 열 제목을 상단에 맞춘다(기본 section-head의 큰 top 마진 제거) */
    margin: 0 0 var(--space-4);
  }
  /* 오른쪽 리스트가 왼쪽 대표 카드와 세로로 맞물리게 카드처럼 감싼다 */
  .reads-col :global(.top-reads) {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: var(--space-4) var(--space-5);
  }
  @media (max-width: 900px) {
    .top-section {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  .grid {
    display: grid;
    /* 3열이 컨테이너 폭을 균등 분할 → 오른쪽 끝이 featured·'전체 글 보기'와 정렬.
       카드가 배경 상자 없이 상단 룰로만 구획되므로 열 간격을 넉넉히 둬 칼럼처럼 읽힌다. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  /* 태블릿: 3열이 좁아지기 전에 2열로 */
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 모바일 (#27): 카드가 featured와 같은 폭으로 꽉 차게 + section-head 세로 스택 */
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
  }
</style>
