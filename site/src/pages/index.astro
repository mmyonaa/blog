---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import PostCard from "../components/home/PostCard.astro";
import SectionNav from "../components/home/SectionNav.astro";
import PopularTags from "../components/home/PopularTags.astro";
import { getTagCounts } from "../lib/tags.ts";
import { getSectionCounts } from "../lib/sections.ts";
import { buildActivity } from "../lib/activity.ts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const sections = await getSectionCounts();
const tags = await getTagCounts();
// 카테고리 블록 아래 인기 태그: 글 수 상위 순. 어떤 폭에서도 2줄이 꽉 차도록 전량을
// 넘기고, PopularTags가 CSS로 2줄만 남기고 클립한다(적게 넘기면 둘째 줄이 중간에서 빈다).
// 클립돼 안 보이는 태그는 컴포넌트 스크립트가 탭 순서·스크린리더에서 제외한다(#4).
const topTags = tags;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// 랜딩 본문: '최근 글' 그리드 하나. 첫 카드가 2칸 폭(wide)이라 사실상 featured 자리.
// 8개: 2 + 1×7 = 9유닛 = 3열×3행이 딱 맞는다(칸이 붕 뜨지 않게).
const RECENT_MAX = 8;
const rest = posts.slice(0, RECENT_MAX);

// ── 히어로 통계 ──
// 로컬 날짜 키(YYYY-MM-DD). '연속 발행'은 가장 최근 글 날짜부터 하루씩 거슬러
// 글이 있는 날이 이어지는 최대 길이.
const dayKey = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};
const daySet = new Set(posts.map((p) => dayKey(p.data.pubDate)));
// 오늘(아직 안 썼으면 어제)부터 거슬러 센다. 발행이 끊겼으면 0 → 통계에서 숨김.
let streak = 0;
if (posts.length > 0) {
  const cursor = new Date();
  if (!daySet.has(dayKey(cursor))) cursor.setDate(cursor.getDate() - 1);
  while (daySet.has(dayKey(cursor))) {
    streak++;
    cursor.setDate(cursor.getDate() - 1);
  }
}
const stats = [
  { value: posts.length, label: "발행 글", href: `${base}/blog/` },
  ...(streak > 0 ? [{ value: streak, label: "일 연속 발행" }] : []),
  { value: sections.length, label: "카테고리", href: `${base}/topics/` },
  { value: tags.length, label: "태그", href: `${base}/topics/#tags` },
];

// 발행 스트릭 잔디(heatmap): 글 pubDate를 주×요일 격자로.
// minWeeks 25는 히어로 오른쪽 열 폭(Hero.astro의 30rem)을 채우는 주 수 — 함께 조정.
const activity = buildActivity(posts.map((p) => p.data.pubDate), { minWeeks: 25 });
---

<Base title="daily.mcp" description="MCP 서버로 글을 발행하며 배운 것을 기록하는 블로그">
  <Hero
    hasPosts={posts.length > 0}
    stats={stats}
    activity={activity}
  />

  {
    posts.length === 0 ? (
      <p class="muted">아직 발행된 글이 없습니다.</p>
    ) : (
      <>
        {sections.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="section-title">카테고리</h2>
              <a class="more" href={`${base}/topics/`}>전체 분류 →</a>
            </div>
            <SectionNav sections={sections} base={base} />
          </>
        )}

        {topTags.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="section-title">인기 태그</h2>
              <a class="more" href={`${base}/topics/#tags`}>태그 전체 →</a>
            </div>
            <PopularTags tags={topTags} base={base} />
          </>
        )}

        {rest.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="section-title">최근 글</h2>
              <a class="more" href={`${base}/blog/`}>전체 글 보기 →</a>
            </div>
            <div class="grid">
              {rest.map((post, i) => (
                <PostCard post={post} wide={i === 0} />
              ))}
            </div>
          </>
        )}
      </>
    )
  }
</Base>

<script>
  // 페이지 공통 인터랙션(진입 reveal)만 여기서 담당.
  // 히어로·잔디 등 컴포넌트 고유 동작은 각 컴포넌트의 <script>에 있다.
  // 문서 위임 + 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__spotBound) {
    (window as any).__spotBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 진입 reveal: 뷰포트에 들어온 .reveal에 .in을 부여해 애니메이션 시작.
    // 최초 로드 땐 화면 위 요소들이 한 배치로 들어와 기존과 같은 stagger,
    // 폴드 아래 카드는 스크롤로 보일 때 각자 작은 stagger로 뜬다.
    const runReveal = () => {
      // 무장 표시 — 백스톱(Base head)이 이걸 보고 정상 동작 시 건너뛴다.
      document.documentElement.classList.add("reveal-armed");
      const els = document.querySelectorAll<HTMLElement>(".reveal:not(.in)");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          let batch = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            el.style.setProperty("--d", `${batch++ * 70}ms`);
            el.classList.add("in");
            io.unobserve(el);
          }
        },
        { threshold: 0.1 },
      );
      els.forEach((el) => io.observe(el));
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runReveal);
  }
</script>

<style is:global>
  /* ══════════════════════════════════════════════════════════
     진입 애니메이션 — 뷰포트에 들어올 때 스크립트가 .in을 부여.
     같은 배치로 들어온 요소끼리 --d(70ms 간격)로 stagger.
     .reveal은 히어로·잔디·카드 등 여러 컴포넌트에 걸쳐 쓰여 전역으로 둔다.
     ══════════════════════════════════════════════════════════ */
  /* 숨김은 .js 아래에서만 — JS가 있어야(=reveal 스크립트가 살아있을 때만)
     감춘다. JS 없거나 스크립트가 죽으면 콘텐츠는 처음부터 보인다. */
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal {
      opacity: 0;
      transform: translateY(14px);
    }
    .js .reveal.in {
      animation: reveal-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes reveal-up {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-8) 0 var(--space-4);
  }
  .section-title {
    font-size: var(--fs-lg);
    margin: 0;
  }
  .more {
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    /* 3열이 컨테이너 폭을 균등 분할 → 오른쪽 끝이 featured·'전체 글 보기'와 정렬.
       카드가 배경 상자 없이 상단 룰로만 구획되므로 열 간격을 넉넉히 둬 칼럼처럼 읽힌다. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  /* 태블릿: 3열이 좁아지기 전에 2열로 */
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 모바일 (#27): 카드가 featured와 같은 폭으로 꽉 차게.
     섹션 제목·더보기 링크는 짧아 한 줄에 들어가므로 baseline 행을 유지하고(스택 시 4px
     간격이 미완성처럼 보였다), 섹션 간 세로 리듬만 데스크톱보다 살짝 좁힌다. */
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      margin-top: var(--space-6);
      gap: var(--space-3);
    }
    .grid {
      gap: var(--space-5) var(--space-4);
    }
  }
</style>
