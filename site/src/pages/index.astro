---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);

const [featured, ...rest] = posts;
---

<Base title="blog-mcp" description="MCP를 직접 만들어 배우고, 그 과정을 자동으로 기록하는 블로그">
  <section class="hero">
    <h1 class="hero-title">blog-mcp</h1>
    <p class="hero-sub">
      MCP를 직접 만들어 배우고, 그 과정을 자동으로 기록합니다. 매일 한 편씩.
    </p>
  </section>

  {
    posts.length === 0 ? (
      <p class="muted">아직 발행된 글이 없습니다.</p>
    ) : (
      <>
        <a class="featured" href={href(featured.id)}>
          <span class="featured-label">FEATURED · {fmtDate(featured.data.pubDate)}</span>
          <h2 class="featured-title">{featured.data.title}</h2>
          {featured.data.description && <p class="featured-desc">{featured.data.description}</p>}
          <div class="tags">
            {featured.data.tags.map((t) => <span class="pill">{t}</span>)}
          </div>
          <span class="read">읽기 →</span>
        </a>

        {rest.length > 0 && (
          <>
            <h2 class="section-title">최근 글</h2>
            <div class="grid">
              {rest.map((post) => (
                <a class="card" href={href(post.id)}>
                  <div class="muted card-meta">{fmtDate(post.data.pubDate)}</div>
                  <h3 class="card-title">{post.data.title}</h3>
                  {post.data.description && <p class="card-desc">{post.data.description}</p>}
                  <div class="tags">
                    {post.data.tags.map((t) => <span class="pill">{t}</span>)}
                  </div>
                </a>
              ))}
            </div>
          </>
        )}
      </>
    )
  }
</Base>

<style>
  .hero {
    padding: var(--space-6) 0 var(--space-8);
  }
  .hero-title {
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    margin: 0 0 var(--space-3);
  }
  .hero-sub {
    color: var(--c-muted);
    font-size: var(--fs-lg);
    max-width: 40ch;
    margin: 0;
  }

  .featured {
    display: block;
    padding: var(--space-6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-accent-soft);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
    color: var(--c-text);
  }
  .featured:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .featured-label {
    color: var(--c-accent);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .featured-title {
    font-size: var(--fs-2xl);
    margin: var(--space-2) 0 var(--space-3);
  }
  .featured-desc {
    color: var(--c-muted);
    margin: 0 0 var(--space-4);
  }
  .read {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--c-accent);
    font-weight: 700;
  }

  .section-title {
    font-size: var(--fs-lg);
    margin: var(--space-8) 0 var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .card {
    display: block;
    padding: var(--space-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    color: var(--c-text);
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: var(--c-accent);
    text-decoration: none;
  }
  .card-title {
    font-size: var(--fs-lg);
    margin: var(--space-1) 0 var(--space-2);
  }
  .card-desc {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-3);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
