---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import FeaturedCard from "../components/home/FeaturedCard.astro";
import PostCard from "../components/home/PostCard.astro";
import { getTagCounts } from "../lib/tags.ts";
import { getSectionCounts } from "../lib/sections.ts";
import { buildActivity } from "../lib/activity.ts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const sections = await getSectionCounts();
const tags = await getTagCounts();
// 히어로 카테고리 아래 인기 태그: 글 수 상위 순으로 상위 일부만(전체는 /topics/#tags).
// 예전엔 넉넉히(60개) 넘기고 CSS로 줄 클립했으나, overflow:hidden은 탭 순서·스크린리더
// 에서 요소를 지우지 못해 '안 보이는 링크 수십 개'가 남았다. '인기' 취지에 맞게 상위
// 14개만 넘겨 노출·초점 대상을 좁힌다(2줄 클립과 함께 대부분 폭에서 전량 표시된다).
const topTags = tags.slice(0, 14);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// RSS 안내 팝오버에 보여줄 절대 피드 주소(리더 앱에 그대로 등록하는 값)
const feedUrl = new URL(`${base}/rss.xml`, Astro.site ?? Astro.url).href;

// 랜딩엔 최신 글만: featured 1개 + 최근 글 최대 6개. 나머지는 '전체 글 보기'로.
const RECENT_MAX = 6;
const [featured, ...others] = posts;
const rest = others.slice(0, RECENT_MAX);

// ── 히어로 통계 ──
// 로컬 날짜 키(YYYY-MM-DD). '연속 발행'은 가장 최근 글 날짜부터 하루씩 거슬러
// 글이 있는 날이 이어지는 최대 길이.
const dayKey = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};
const daySet = new Set(posts.map((p) => dayKey(p.data.pubDate)));
// 오늘(아직 안 썼으면 어제)부터 거슬러 센다. 발행이 끊겼으면 0 → 통계에서 숨김.
let streak = 0;
if (posts.length > 0) {
  const cursor = new Date();
  if (!daySet.has(dayKey(cursor))) cursor.setDate(cursor.getDate() - 1);
  while (daySet.has(dayKey(cursor))) {
    streak++;
    cursor.setDate(cursor.getDate() - 1);
  }
}
const stats = [
  { value: posts.length, label: "발행 글", href: `${base}/blog/` },
  ...(streak > 0 ? [{ value: streak, label: "일 연속 발행" }] : []),
  { value: sections.length, label: "카테고리", href: `${base}/topics/` },
  { value: tags.length, label: "태그", href: `${base}/topics/#tags` },
];

// 발행 스트릭 잔디(heatmap): 글 pubDate를 주×요일 격자로.
// minWeeks 25는 히어로 오른쪽 열 폭(Hero.astro의 30rem)을 채우는 주 수 — 함께 조정.
const activity = buildActivity(posts.map((p) => p.data.pubDate), { minWeeks: 25 });
---

<Base title="blog" description="MCP 서버로 글을 발행하며 배운 것을 기록하는 블로그">
  <noscript>
    {/* reveal은 스크립트가 트리거하므로, JS 미실행 환경에선 숨김을 해제 */}
    <style is:inline>
      .reveal {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>

  <Hero
    hasPosts={posts.length > 0}
    featuredHref={posts.length > 0 ? `${base}/blog/${featured.id}/` : `${base}/blog/`}
    feedUrl={feedUrl}
    stats={stats}
    activity={activity}
    sections={sections}
    topTags={topTags}
    base={base}
  />

  {
    posts.length === 0 ? (
      <p class="muted">아직 발행된 글이 없습니다.</p>
    ) : (
      <>
        <FeaturedCard post={featured} />

        {rest.length > 0 && (
          <>
            <div class="section-head">
              <h2 class="section-title">최근 글</h2>
              <a class="more" href={`${base}/blog/`}>전체 글 보기 →</a>
            </div>
            <div class="grid">
              {rest.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          </>
        )}
      </>
    )
  }
</Base>

<script>
  // 페이지 공통 인터랙션(커서 스포트라이트·진입 reveal)만 여기서 담당.
  // 히어로·잔디 등 컴포넌트 고유 동작은 각 컴포넌트의 <script>에 있다.
  // 문서 위임 + 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__spotBound) {
    (window as any).__spotBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 카드 커서 스포트라이트: [data-spot] 위에서 마우스 좌표를 CSS 변수로 흘려보낸다.
    if (!reduce) {
      document.addEventListener(
        "pointermove",
        (e) => {
          const el = (e.target as HTMLElement)?.closest?.<HTMLElement>("[data-spot]");
          if (!el) return;
          const r = el.getBoundingClientRect();
          el.style.setProperty("--mx", `${e.clientX - r.left}px`);
          el.style.setProperty("--my", `${e.clientY - r.top}px`);
        },
        { passive: true },
      );
    }

    // 진입 reveal: 뷰포트에 들어온 .reveal에 .in을 부여해 애니메이션 시작.
    // 최초 로드 땐 화면 위 요소들이 한 배치로 들어와 기존과 같은 stagger,
    // 폴드 아래 카드는 스크롤로 보일 때 각자 작은 stagger로 뜬다.
    const runReveal = () => {
      const els = document.querySelectorAll<HTMLElement>(".reveal:not(.in)");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          let batch = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            el.style.setProperty("--d", `${batch++ * 70}ms`);
            el.classList.add("in");
            io.unobserve(el);
          }
        },
        { threshold: 0.1 },
      );
      els.forEach((el) => io.observe(el));
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runReveal);
  }
</script>

<style is:global>
  /* ══════════════════════════════════════════════════════════
     진입 애니메이션 — 뷰포트에 들어올 때 스크립트가 .in을 부여.
     같은 배치로 들어온 요소끼리 --d(70ms 간격)로 stagger.
     .reveal은 히어로·잔디·카드 등 여러 컴포넌트에 걸쳐 쓰여 전역으로 둔다.
     ══════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      opacity: 0;
      transform: translateY(14px);
    }
    .reveal.in {
      animation: reveal-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes reveal-up {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-8) 0 var(--space-4);
  }
  .section-title {
    font-size: var(--fs-lg);
    margin: 0;
  }
  .more {
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    /* 3열이 컨테이너 폭을 균등 분할 → 오른쪽 끝이 featured·'전체 글 보기'와 정렬 */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  /* 태블릿: 3열이 좁아지기 전에 2열로 */
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 모바일 (#27): 카드가 featured와 같은 폭으로 꽉 차게 + section-head 세로 스택 */
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
  }
</style>
