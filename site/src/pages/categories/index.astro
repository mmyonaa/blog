---
import Base from "../../layouts/Base.astro";
import { getSectionCounts, sectionHref } from "../../lib/sections.ts";

const sections = await getSectionCounts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="카테고리 — blog" description="카테고리별로 글을 모아봅니다">
  <h1>카테고리</h1>
  <p class="muted">이 블로그는 카테고리별로 나뉘어 있습니다.</p>
  <hr />
  {
    sections.length === 0 ? (
      <p class="muted">아직 카테고리가 없습니다.</p>
    ) : (
      <div class="sec-grid">
        {sections.map((s) => (
          <a class="sec-card" href={sectionHref(base, s.id)}>
            <span class="sec-name">{s.label}</span>
            <span class="sec-count">{s.count}편</span>
          </a>
        ))}
      </div>
    )
  }
</Base>

<style>
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .sec-card {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .sec-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: var(--c-accent);
  }
  .sec-name {
    font-size: var(--fs-lg);
    font-weight: 700;
  }
  .sec-count {
    color: var(--c-accent);
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .sec-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
