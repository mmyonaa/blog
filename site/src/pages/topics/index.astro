---
// 분류 허브: 카테고리(큰 분류)와 태그(세부 소재)를 한 페이지에서 보여준다.
// 상세 페이지(/categories/[section]/, /tags/[tag]/)의 진입점 역할.
import Base from "../../layouts/Base.astro";
import { getSectionCounts, sectionHref, hueOf } from "../../lib/sections.ts";
import { getTagCounts, tagHref } from "../../lib/tags.ts";

const sections = await getSectionCounts();
const tags = await getTagCounts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="분류 — blog" description="카테고리와 태그로 글을 모아봅니다">
  <h1>분류</h1>
  <p class="muted">큰 줄기는 카테고리로, 세부 소재는 태그로 글을 모아봅니다.</p>
  <hr />

  <h2 class="hub-title">카테고리</h2>
  {
    sections.length === 0 ? (
      <p class="muted">아직 카테고리가 없습니다.</p>
    ) : (
      <div class="sec-grid">
        {sections.map((s) => (
          <a class="sec-card" href={sectionHref(base, s.id)} style={`--hue: ${hueOf(s.id)}`}>
            <span class="sec-name">{s.label}</span>
            <span class="sec-count">{s.count}편</span>
          </a>
        ))}
      </div>
    )
  }

  <h2 class="hub-title" id="tags">태그</h2>
  {
    tags.length === 0 ? (
      <p class="muted">아직 태그가 없습니다.</p>
    ) : (
      <div class="taglist">
        {tags.map(({ tag, count }) => (
          <a class="pill tag-pill" href={tagHref(base, tag)}>
            #{tag} <span class="count">{count}</span>
          </a>
        ))}
      </div>
    )
  }
</Base>

<style>
  .hub-title {
    font-size: var(--fs-lg);
    margin: var(--space-7) 0 var(--space-4);
  }
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .sec-card {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--c-border);
    border-left: 3px solid var(--hue, var(--c-accent));
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .sec-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: var(--c-accent);
    border-left-color: var(--hue, var(--c-accent));
  }
  .sec-name {
    font-size: var(--fs-lg);
    font-weight: 700;
  }
  .sec-count {
    color: var(--c-accent);
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .sec-grid {
      grid-template-columns: 1fr;
    }
  }
  .taglist {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .tag-pill {
    font-size: var(--fs-sm);
    padding: 0.35em 0.9em;
  }
  .count {
    color: var(--c-accent);
    font-weight: 700;
    margin-left: 0.15em;
  }
</style>
