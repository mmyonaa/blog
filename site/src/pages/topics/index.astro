---
// 분류 허브: 카테고리(큰 분류)와 태그(세부 소재)를 한 페이지에서 보여준다.
// 카테고리·태그 모두 상세 페이지(/categories/[section]/, /tags/[tag]/) 진입점.
// 발행 그래프의 인플레이스 필터링은 그래프 위 범례(legend)가 담당한다.
import Base from "../../layouts/Base.astro";
import { getSectionCounts, sectionHref, hueOf } from "../../lib/sections.ts";
import { getTagCounts, tagHref } from "../../lib/tags.ts";
import PostGraph from "../../components/PostGraph.astro";

const sections = await getSectionCounts();
const tags = await getTagCounts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Topics — blog" description="카테고리와 태그로 글을 모아봅니다">
  <h1>Topics</h1>
  <p class="muted">큰 줄기는 카테고리로, 세부 소재는 태그로 글을 모아봅니다.</p>
  <hr />

  <h2 class="hub-title">카테고리</h2>
  {
    sections.length === 0 ? (
      <p class="muted">아직 카테고리가 없습니다.</p>
    ) : (
      <ul class="sec-grid">
        {sections.map((s) => (
          <li class="sec-item" style={`--hue: ${hueOf(s.id)}`}>
            <a class="sec-link" href={sectionHref(base, s.id)}>
              <span class="sec-name">{s.label}</span>
              <span class="sec-leader" aria-hidden="true" />
              <span class="sec-count">{s.count}편</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <hr />
  <h2 class="hub-title" id="tags">태그</h2>
  {
    tags.length === 0 ? (
      <p class="muted">아직 태그가 없습니다.</p>
    ) : (
      <>
        {/* data-collapsed: 모바일에선 빈도순 상위 20개만 기본 노출(CSS가 가림).
            데스크톱은 미디어쿼리 밖이라 항상 전체 표시. */}
        <div class="taglist" data-collapsed>
          {tags.map(({ tag, count }) => (
            <a class="tag tag-pill" href={tagHref(base, tag)}>
              {tag} <span class="count">{count}</span>
            </a>
          ))}
        </div>
        {tags.length > 20 && (
          <button
            class="taglist-more"
            type="button"
            aria-expanded="false"
            data-taglist-toggle
            data-more={`태그 ${tags.length}개 모두 보기`}
            data-less="태그 접기"
          >
            태그 {tags.length}개 모두 보기
          </button>
        )}
      </>
    )
  }

  <hr />
  <h2 class="hub-title" id="graph">발행 그래프</h2>
  <script>
    // 태그 접기/펼치기(모바일). 문서 위임으로 한 번만 바인딩(View Transitions 안전).
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-taglist-toggle]",
      );
      if (!btn) return;
      const list = document.querySelector(".taglist");
      if (!list) return;
      const collapsed = list.toggleAttribute("data-collapsed");
      btn.textContent = collapsed ? btn.dataset.more! : btn.dataset.less!;
      btn.setAttribute("aria-expanded", String(!collapsed)); // chevron 방향도 이걸 따른다
    });
  </script>
  <p class="muted">
    발행한 모든 글을 시간축 위 git 그래프로. 세로 트렁크는 카테고리, 옆으로 뻗는 가지는
    그 안의 세부 갈래, 화살표 곡선은 글의 후속입니다.
  </p>
  <PostGraph />
</Base>

<style>
  /* 섹션 타이틀 — 항목(.sec-name, fs-lg 700)과 같은 스타일이라 위계가 안 보였다.
     푸터(.footer-head)·글 상세(.side-title)와 같은 아이브로우 라벨 결로 낮춰
     '작은 라벨 → 큰 항목'의 대비를 만든다. */
  .hub-title {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--c-muted);
    margin: var(--space-8) 0 var(--space-4);
  }
  /* 섹션 사이는 hr이 구분을 담당 — 구분선 바로 아래 타이틀은 큰 top 마진을
     버리고 hr의 리듬(데스크톱 32/모바일 16, global.css)에 맡긴다. */
  hr + .hub-title {
    margin-top: var(--space-4);
  }
  /* 모바일: 카테고리 목록 위 여백을 살짝 죈다(섹션 구분은 hr이 담당). */
  @media (max-width: 640px) {
    .sec-grid {
      margin-top: var(--space-3);
    }
  }
  /* 카테고리 — '차례'식 점선 리더는 유지하되(이 사이트 고유의 결),
     한 줄 전체 대신 다열 그리드로 압축: 데스크톱은 한 줄에 다 들어가고
     좁은 화면에선 2열로 흐른다. 카드·보더·점 장식 없이 텍스트+점선만. */
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    column-gap: var(--space-6);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }
  .sec-item {
    /* --hue는 인라인 style로 주입. 다크에선 채도를 낮춘 파생색으로 보정. */
    --hue-on: var(--hue, var(--c-accent));
  }
  :global(:root[data-theme="dark"]) .sec-item {
    --hue-on: oklch(from var(--hue, var(--c-accent)) 0.78 calc(c * 0.52) h);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sec-item {
      --hue-on: oklch(from var(--hue, var(--c-accent)) 0.78 calc(c * 0.52) h);
    }
  }
  .sec-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    color: var(--c-text);
    text-decoration: none;
  }
  .sec-name {
    flex: none;
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  /* 점선 리더 — 이름과 편수 사이를 점선으로 채운다(차례 특유의 결). */
  .sec-leader {
    flex: 1;
    min-width: 0.75rem;
    align-self: flex-end;
    height: 0;
    margin-bottom: 0.3em;
    border-bottom: 1px dotted var(--c-border);
  }
  .sec-count {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sec-link:hover .sec-name,
  .sec-link:hover .sec-count {
    color: var(--hue-on);
  }
  .taglist {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  /* 태그 허브에선 태그를 목록 본문만큼 키운다(기본 .tag는 xs). */
  .tag-pill {
    font-size: var(--fs-sm);
  }
  /* 모바일: 태그 110개가 ~1.2화면을 차지해 빈도순 상위 20개만 남기고 접는다.
     (:nth-child(n+21)의 21은 마크업의 상위 20개와 짝 — 바꿀 땐 함께.) */
  .taglist-more {
    display: none;
  }
  @media (max-width: 640px) {
    .taglist[data-collapsed] .tag:nth-child(n + 21) {
      display: none;
    }
    /* pill 버튼 대신 텍스트+chevron 디스클로저 — 접힘 ⌄ / 펼침 ⌃ */
    .taglist-more {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      margin-top: var(--space-3);
      padding: 0.25em 0;
      border: 0;
      background: none;
      color: var(--c-muted);
      font: inherit;
      font-size: var(--fs-sm);
      font-weight: 600;
      cursor: pointer;
    }
    .taglist-more:hover {
      color: var(--c-text);
    }
    .taglist-more::after {
      content: "";
      width: 0.45em;
      height: 0.45em;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      transform: translateY(-0.15em) rotate(45deg);
      transition: transform 0.15s ease;
    }
    .taglist-more[aria-expanded="true"]::after {
      transform: translateY(0.1em) rotate(225deg);
    }
    @media (prefers-reduced-motion: reduce) {
      .taglist-more::after {
        transition: none;
      }
    }
  }
</style>
