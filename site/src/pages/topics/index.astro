---
// 분류 허브: 카테고리(큰 분류)와 태그(세부 소재)를 한 페이지에서 보여준다.
// 카테고리는 클릭 시 페이지 이동 대신 아래 발행 그래프를 필터링하고(같은 걸 다시
// 누르면 해제), 태그는 상세 페이지(/tags/[tag]/)로 들어가는 진입점이다.
import Base from "../../layouts/Base.astro";
import { getSectionCounts, sectionHref, hueOf } from "../../lib/sections.ts";
import { getTagCounts, tagHref } from "../../lib/tags.ts";
import PostGraph from "../../components/PostGraph.astro";

const sections = await getSectionCounts();
const tags = await getTagCounts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Topics — blog" description="카테고리와 태그로 글을 모아봅니다">
  <h1>Topics</h1>
  <p class="muted">
    큰 줄기는 카테고리로, 세부 소재는 태그로 글을 모아봅니다. 카테고리를 누르면 아래 발행
    그래프가 그 갈래만 밝혀 보여줍니다.
  </p>
  <hr />

  <h2 class="hub-title">카테고리</h2>
  {
    sections.length === 0 ? (
      <p class="muted">아직 카테고리가 없습니다.</p>
    ) : (
      <ul class="sec-toc">
        {sections.map((s) => (
          <li class="sec-row" style={`--hue: ${hueOf(s.id)}`}>
            {/* data-graph-filter: 클릭하면 이동 대신 아래 발행 그래프를 이 카테고리로
                거른다(PostGraph 스크립트가 가로챔). JS가 없으면 href로 폴백. */}
            <a
              class="sec-link"
              href={sectionHref(base, s.id)}
              data-graph-filter={s.id}
            >
              <span class="sec-name">{s.label}</span>
              <span class="sec-leader" aria-hidden="true" />
              <span class="sec-count">{s.count}편</span>
              <span class="sec-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <h2 class="hub-title" id="tags">태그</h2>
  {
    tags.length === 0 ? (
      <p class="muted">아직 태그가 없습니다.</p>
    ) : (
      <div class="taglist">
        {tags.map(({ tag, count }) => (
          <a class="tag tag-pill" href={tagHref(base, tag)}>
            {tag} <span class="count">{count}</span>
          </a>
        ))}
      </div>
    )
  }

  <h2 class="hub-title" id="graph">발행 그래프</h2>
  <p class="muted">
    발행한 모든 글을 시간축 위 git 그래프로. 세로 트렁크는 카테고리, 옆으로 뻗는 가지는
    그 안의 세부 갈래, 화살표 곡선은 글의 후속입니다.
  </p>
  <PostGraph />
</Base>

<style>
  .hub-title {
    font-size: var(--fs-lg);
    margin: var(--space-8) 0 var(--space-4);
  }
  /* 모바일: 섹션 사이 48px는 과해 32px로, 구분선 바로 아래는
     hr 리듬(16px, global.css)과 같은 박자로 죈다. */
  @media (max-width: 640px) {
    .hub-title {
      margin-top: var(--space-6);
    }
    hr + .hub-title {
      margin-top: var(--space-4);
    }
  }
  /* 카테고리 — 책 '차례'식 점선 리더 목록. 카드·컬러보더 없이,
     카테고리 색(--hue)은 hover에만 절제해서 드러낸다. */
  .sec-toc {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .sec-row {
    /* --hue는 인라인 style로 주입. 다크에선 채도를 낮춘 파생색으로 보정. */
    --hue-on: var(--hue, var(--c-accent));
    border-bottom: 1px solid var(--c-border);
  }
  .sec-row:first-child {
    border-top: 1px solid var(--c-border);
  }
  :global(:root[data-theme="dark"]) .sec-row {
    --hue-on: oklch(from var(--hue, var(--c-accent)) 0.78 calc(c * 0.52) h);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sec-row {
      --hue-on: oklch(from var(--hue, var(--c-accent)) 0.78 calc(c * 0.52) h);
    }
  }
  .sec-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    color: var(--c-text);
    text-decoration: none;
  }
  .sec-name {
    flex: none;
    /* 카테고리 이름: fs-xl(24px)은 5줄 목록에서 과대 → fs-lg(19px)로 차분하게. */
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  /* 점선 리더 — 이름과 편수 사이를 점선으로 채운다(차례 특유의 결). */
  .sec-leader {
    flex: 1;
    align-self: flex-end;
    height: 0;
    margin-bottom: 0.35em;
    border-bottom: 1px dotted var(--c-border);
  }
  .sec-count {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sec-arrow {
    flex: none;
    color: var(--c-muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .sec-link:hover .sec-name,
  .sec-link:hover .sec-count,
  .sec-link:hover .sec-arrow {
    color: var(--hue-on);
  }
  .sec-link:hover .sec-arrow {
    transform: translateX(4px);
  }
  /* 그래프 필터 상태(PostGraph 스크립트가 sel/off를 토글) —
     선택된 카테고리는 hue로 밝히고, 나머지는 가라앉힌다. */
  .sec-link.sel .sec-name,
  .sec-link.sel .sec-count,
  .sec-link.sel .sec-arrow {
    color: var(--hue-on);
  }
  .sec-link.off {
    opacity: 0.45;
  }
  @media (prefers-reduced-motion: reduce) {
    .sec-arrow {
      transition: color 0.15s ease;
    }
  }
  .taglist {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  /* 태그 허브에선 태그를 목록 본문만큼 키운다(기본 .tag는 xs). */
  .tag-pill {
    font-size: var(--fs-sm);
  }
</style>
