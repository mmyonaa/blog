---
// 소개 페이지 — 누가·왜 이 블로그를 만드는가(학습 저널의 정체성)와
// "이 블로그는 어떻게 만들어지나(콜로폰)"를 한 페이지에 담는다.
// 만든 사람 정보는 lib/author.ts, 카테고리 소개는 lib/sections.ts가 단일 출처.
import Base from "../../layouts/Base.astro";
import { AUTHOR, REPO_URL } from "../../lib/author.ts";
import { getSectionCounts, sectionHref, hueOf, blurbOf } from "../../lib/sections.ts";
import { getCollection } from "astro:content";
import { fmtDate } from "../../lib/date.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sections = await getSectionCounts();

const posts = (await getCollection("blog")).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const postCount = posts.length;
const firstDate = posts.length > 0 ? fmtDate(posts[0].data.pubDate) : null;
---

<Base
  title="About — blog"
  description="누가·왜 이 블로그를 만드는가, 그리고 MCP 서버가 어떻게 글을 자동 발행하는가"
>
  <header class="about-hero">
    <img
      class="ab-avatar"
      src={AUTHOR.avatar}
      alt=""
      width="72"
      height="72"
      loading="eager"
      decoding="async"
    />
    <div class="ab-id">
      <h1 class="ab-name">{AUTHOR.name}</h1>
      <a class="ab-portfolio" href={AUTHOR.portfolio} target="_blank" rel="noopener">
        {AUTHOR.portfolioLabel}
      </a>
    </div>
    <div class="ab-social">
      <a href={AUTHOR.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
      </a>
      <a href={AUTHOR.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.632 13.635h-2.37V9.922c0-.886-.018-2.025-1.234-2.025-1.235 0-1.424.964-1.424 1.96v3.778h-2.37V6H8.51v1.04h.032c.317-.6 1.09-1.233 2.244-1.233 2.4 0 2.845 1.58 2.845 3.637v4.19zM3.558 4.955a1.376 1.376 0 1 1 .002-2.752 1.376 1.376 0 0 1-.002 2.752zm1.188 8.68H2.368V6h2.378v7.635zM14.816 0H1.18C.528 0 0 .516 0 1.153v13.694C0 15.484.528 16 1.18 16h13.635c.652 0 1.185-.516 1.185-1.153V1.153C16 .516 15.467 0 14.815 0z"></path></svg>
      </a>
      <a
        class="about-mail"
        href="#"
        data-mail-user={AUTHOR.mailUser}
        data-mail-domain={AUTHOR.mailDomain}
        aria-label="이메일 보내기"
      >
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M2 3h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm0 1v.4l6 3.6 6-3.6V4H2Zm12 1.567-5.74 3.444a.5.5 0 0 1-.52 0L2 5.567V12h12V5.567Z"></path></svg>
      </a>
    </div>
  </header>

  <p class="lead">
    개발자로 일하며 배운 것을 매일 한 편씩 기록하는 학습 저널입니다.
    읽고 끝나는 지식 대신, 직접 만들어 보며 남긴 흔적을 모읍니다.
    {firstDate && <>{firstDate}에 첫 글을 올린 뒤 지금까지 <strong>{postCount}편</strong>을 쌓았어요.</>}
  </p>

  <hr />

  <h2>무엇을 쓰나</h2>
  <p class="muted">배우는 큰 줄기를 네 갈래로 나눠 씁니다.</p>
  <dl class="ab-gloss">
    {
      sections.map((s) => (
        <div class="gl-item" style={`--hue: ${hueOf(s.id)}`}>
          <dt class="gl-term">
            <a class="gl-name" href={sectionHref(base, s.id)}>{s.label}</a>
            <span class="gl-count">{s.count}편</span>
          </dt>
          {blurbOf(s.id) && <dd class="gl-def">{blurbOf(s.id)}</dd>}
        </div>
      ))
    }
  </dl>

  <hr />

  <!-- ── 콜로폰: 이 블로그가 어떻게 만들어지나 ── -->
  <h2 id="colophon">이 블로그는 어떻게 만들어지나</h2>
  <p>
    이 사이트의 글은 사람이 웹 에디터에서 쓰는 대신,
    <strong>직접 만든 MCP(Model Context Protocol) 서버</strong>를 통해 발행됩니다.
    "매일 배운 걸 자동으로 한 편씩 남긴다"는 목표로 서버부터 만들며 배우는 프로젝트예요.
  </p>

  <!-- ── MCP 구동 로직: 호스트 ⇄ 서버 ── -->
  <h3 class="mcp-sub">MCP는 어떻게 도나</h3>
  <p class="muted mcp-lead">
    MCP는 <b>호스트(모델이 있는 앱)</b>와 <b>서버(도구·데이터를 가진 쪽)</b>가
    표준 입출력(stdio) 위에서 JSON-RPC로 대화하는 규약이에요. 호스트가 서버를 실행하고
    "뭘 할 수 있냐"고 물으면, 서버가 아래 세 가지 능력을 알려줍니다.
  </p>

  <figure class="mcp-diagram">
    <div class="mcp-nodes">
      <div class="mcp-node">
        <span class="mcp-node-tag">호스트 · 클라이언트</span>
        <b>모델이 있는 앱</b>
        <span class="mcp-node-sub">Claude Code 등 — 도구를 <em>호출하는</em> 쪽</span>
      </div>
      <div class="mcp-link">
        <span class="mcp-link-label">⇄ stdio · JSON-RPC</span>
      </div>
      <div class="mcp-node mcp-node-server">
        <span class="mcp-node-tag">서버</span>
        <b>이 프로젝트 (stdio MCP)</b>
        <span class="mcp-node-sub">LLM 호출 없음 — 도구·데이터만 <em>제공</em></span>
      </div>
    </div>

    <ul class="mcp-caps">
      <li>
        <span class="mcp-cap-kind">Tools</span>
        <span>모델이 호출하는 동작 — <code>suggest_topic</code>, <code>publish_post</code></span>
      </li>
      <li>
        <span class="mcp-cap-kind">Resources</span>
        <span>읽을 수 있는 데이터 — <code>blog://posts</code></span>
      </li>
      <li>
        <span class="mcp-cap-kind">Prompts</span>
        <span>재사용 워크플로 — <code>write_daily_post</code></span>
      </li>
    </ul>

    <figcaption>
      호스트가 <code>publish_post</code>를 호출하면, 서버가 <code>.md</code> 파일을 저장하고
      그 결과를 다시 호스트로 돌려줍니다. 아래는 그 능력들이 실제 발행에서 도는 순서예요.
    </figcaption>
  </figure>

  <ol class="flow">
    <li>
      <span class="flow-step">1</span>
      <div>
        <b>주제 고르기</b> — MCP 도구 <code>suggest_topic</code>이 카테고리별 시드 주제를
        제안하고, 기존 글의 제목·태그(<code>blog://posts</code> 리소스)를 먼저 읽어 중복을 피합니다.
      </div>
    </li>
    <li>
      <span class="flow-step">2</span>
      <div>
        <b>집필</b> — <code>write_daily_post</code> 프롬프트에 분량·톤·구조 지침이 통째로
        패키징되어 있어, 그 워크플로를 따라 글을 씁니다.
      </div>
    </li>
    <li>
      <span class="flow-step">3</span>
      <div>
        <b>발행</b> — <code>publish_post</code> 도구가 프론트매터(제목·날짜·카테고리·태그)를
        생성하고 <code>.md</code> 파일을 저장합니다. 태그 3~5개, 영문 slug 같은 규칙은
        도구가 강제해요.
      </div>
    </li>
    <li>
      <span class="flow-step">4</span>
      <div>
        <b>빌드</b> — Astro가 마크다운을 정적 사이트로 빌드해 배포합니다.
        지금 보는 이 페이지도 같은 파이프라인의 결과예요.
      </div>
    </li>
  </ol>

  <div class="principles">
    <div class="pr">
      <b>무료 원칙</b>
      <span>MCP 서버 자체는 LLM을 호출하지 않습니다. 비용이 드는 생성은 글쓰기 단계에만.</span>
    </div>
    <div class="pr">
      <b>단일 출처</b>
      <span>글쓰기 지침은 <code>write_daily_post</code> 프롬프트, 입력 검증은 <code>publish_post</code> 도구 한 곳에.</span>
    </div>
    <div class="pr">
      <b>정적 SSG</b>
      <span>Astro로 빌드한 순수 정적 사이트 — 빠르고, 서버 없이 어디서나 배포됩니다.</span>
    </div>
  </div>

  <p class="src-note">
    서버(stdio MCP)와 사이트(Astro) 코드는 모두
    <a href={REPO_URL} target="_blank" rel="noopener">GitHub</a>에 공개돼 있습니다.
  </p>
</Base>

<style>
  /* ── 프로필 헤더 ── */
  .about-hero {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }
  .ab-avatar {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border);
    background: var(--c-surface-2);
    object-fit: cover;
  }
  .ab-id {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin-right: auto;
  }
  .ab-name {
    margin: 0;
    font-size: var(--fs-2xl);
    letter-spacing: -0.02em;
  }
  .ab-portfolio {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-muted);
    text-decoration: none;
  }
  .ab-portfolio:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }
  .ab-social {
    display: flex;
    gap: var(--space-2);
  }
  .ab-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    color: var(--c-muted);
  }
  .ab-social a:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  .lead {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--c-text);
    max-width: 68ch;
  }
  .lead strong {
    color: var(--c-accent);
  }

  h2 {
    font-size: var(--fs-xl);
    margin: var(--space-8) 0 var(--space-2);
  }

  /* ── 카테고리: 사전식 정의 리스트. 색은 카테고리명 글씨에만, 장식(점·바·카드) 없음 ── */
  .ab-gloss {
    margin: var(--space-5) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .gl-item {
    --hue-on: var(--hue, var(--c-accent));
  }
  :global(:root[data-theme="dark"]) .gl-item {
    --hue-on: color-mix(in srgb, var(--hue, var(--c-accent)) 62%, white);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .gl-item {
      --hue-on: color-mix(in srgb, var(--hue, var(--c-accent)) 62%, white);
    }
  }
  .gl-term {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  /* 카테고리명 — 그 색 글씨가 유일한 디자인 신호 */
  .gl-name {
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--hue-on);
    text-decoration: none;
  }
  .gl-name:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .gl-count {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }
  .gl-def {
    margin: 0.15em 0 0;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--c-muted);
  }

  /* ── 콜로폰 흐름 ── */
  .flow {
    list-style: none;
    margin: var(--space-5) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .flow li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    line-height: 1.65;
  }
  .flow-step {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: var(--radius-pill);
    background: var(--c-accent-soft);
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: var(--fs-sm);
  }

  /* ── 원칙 3칸 ── */
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-5) 0;
  }
  .pr {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    padding: var(--space-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
  }
  .pr b {
    font-size: var(--fs-sm);
    letter-spacing: -0.01em;
  }
  .pr span {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--c-muted);
  }

  .src-note {
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }

  /* ── MCP 구동 다이어그램(호스트 ⇄ 서버) ── */
  .mcp-sub {
    font-size: var(--fs-lg);
    margin: var(--space-6) 0 var(--space-2);
  }
  .mcp-lead {
    max-width: 68ch;
    line-height: 1.7;
  }
  .mcp-diagram {
    margin: var(--space-5) 0;
  }
  /* 두 노드 + 가운데 연결선. 좁은 화면에선 세로로 스택된다. */
  .mcp-nodes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: var(--space-2);
  }
  .mcp-node {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    padding: var(--space-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }
  /* 서버 노드는 액센트 엣지로 '이 프로젝트'임을 강조. */
  .mcp-node-server {
    border-left: 3px solid var(--c-accent);
  }
  .mcp-node-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .mcp-node b {
    font-size: var(--fs-base);
    letter-spacing: -0.01em;
  }
  .mcp-node-sub {
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--c-muted);
  }
  .mcp-node-sub em {
    font-style: normal;
    font-weight: 700;
    color: var(--c-text);
  }
  /* 연결선 — 점선 위에 프로토콜 라벨 알약. 라벨은 페이지 배경색으로 선을 가린다. */
  .mcp-link {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 7rem;
    padding: 0 var(--space-2);
  }
  .mcp-link::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 50%;
    border-top: 2px dashed var(--c-border);
  }
  .mcp-link-label {
    position: relative;
    z-index: 1;
    padding: 0.25em 0.7em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    background: var(--c-bg);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    white-space: nowrap;
  }
  /* 세 가지 능력(Tools·Resources·Prompts) */
  .mcp-caps {
    list-style: none;
    margin: var(--space-4) 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .mcp-caps li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  .mcp-cap-kind {
    flex: none;
    min-width: 5.5rem;
    text-align: center;
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    background: var(--c-accent-soft);
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  .mcp-diagram figcaption {
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--c-muted);
  }

  @media (max-width: 640px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .ab-id {
      margin-right: 0;
    }
    /* 좁은 화면: 노드를 세로로 쌓고 연결선을 세로로 돌린다. */
    .mcp-nodes {
      grid-template-columns: 1fr;
    }
    .mcp-link {
      min-height: 2.75rem;
      padding: var(--space-2) 0;
    }
    .mcp-link::before {
      inset-inline: auto;
      inset-block: 0;
      left: 50%;
      top: auto;
      border-top: 0;
      border-left: 2px dashed var(--c-border);
    }
    .mcp-cap-kind {
      min-width: 4.75rem;
    }
  }
</style>
