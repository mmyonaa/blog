---
// 소개 페이지 — 누가·왜 이 블로그를 만드는가(학습 저널의 정체성)와
// "이 블로그는 어떻게 만들어지나(콜로폰)"를 한 페이지에 담는다.
// 만든 사람 정보는 lib/author.ts, 카테고리 소개는 lib/sections.ts가 단일 출처.
import Base from "../../layouts/Base.astro";
import { AUTHOR, REPO_URL } from "../../lib/author.ts";
import { getSectionCounts, sectionHref, hueOf, blurbOf } from "../../lib/sections.ts";
import { getCollection } from "astro:content";
import { fmtDate } from "../../lib/date.ts";
import McpOrbit from "../../components/McpOrbit.astro";
import ActivityHeatmap from "../../components/home/ActivityHeatmap.astro";
import { buildActivity } from "../../lib/activity.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sections = await getSectionCounts();

const posts = (await getCollection("blog")).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const postCount = posts.length;
const firstDate = posts.length > 0 ? fmtDate(posts[0].data.pubDate) : null;

// 발행 스트릭 잔디 — 리드의 "N편을 쌓았어요"를 시각 증거로 뒷받침 (홈 히어로에서 이동).
// minWeeks 25는 본문 폭에 맞는 주 수.
const activity = buildActivity(posts.map((p) => p.data.pubDate), { minWeeks: 25 });
---

<Base
  title="About — blog"
  description="누가·왜 이 블로그를 만드는가, 그리고 MCP 서버가 어떻게 글을 자동 발행하는가"
>
  <header class="about-hero">
    <img
      class="ab-avatar"
      src={AUTHOR.avatar}
      alt=""
      width="72"
      height="72"
      loading="eager"
      decoding="async"
    />
    <div class="ab-id">
      <h1 class="ab-name">{AUTHOR.name}</h1>
      <a class="ab-portfolio" href={AUTHOR.portfolio} target="_blank" rel="noopener">
        {AUTHOR.portfolioLabel}
      </a>
    </div>
    <div class="ab-social">
      <a href={AUTHOR.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
      </a>
      <a href={AUTHOR.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.632 13.635h-2.37V9.922c0-.886-.018-2.025-1.234-2.025-1.235 0-1.424.964-1.424 1.96v3.778h-2.37V6H8.51v1.04h.032c.317-.6 1.09-1.233 2.244-1.233 2.4 0 2.845 1.58 2.845 3.637v4.19zM3.558 4.955a1.376 1.376 0 1 1 .002-2.752 1.376 1.376 0 0 1-.002 2.752zm1.188 8.68H2.368V6h2.378v7.635zM14.816 0H1.18C.528 0 0 .516 0 1.153v13.694C0 15.484.528 16 1.18 16h13.635c.652 0 1.185-.516 1.185-1.153V1.153C16 .516 15.467 0 14.815 0z"></path></svg>
      </a>
      <a
        class="about-mail"
        href="#"
        data-mail-user={AUTHOR.mailUser}
        data-mail-domain={AUTHOR.mailDomain}
        aria-label="이메일 보내기"
      >
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M2 3h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm0 1v.4l6 3.6 6-3.6V4H2Zm12 1.567-5.74 3.444a.5.5 0 0 1-.52 0L2 5.567V12h12V5.567Z"></path></svg>
      </a>
    </div>
  </header>

  <p class="lead">
    개발자로 일하며 배운 것을 매일 한 편씩 기록하는 학습 저널입니다.
    읽고 끝나는 지식 대신, 직접 만들어 보며 남긴 흔적을 모읍니다.
    {firstDate && <>{firstDate}에 첫 글을 올린 뒤 지금까지 <strong>{postCount}편</strong>을 쌓았어요.</>}
  </p>

  {/* 발행 스트릭 — 위 문장의 시각 증거. 홈 히어로에서 이동해 왔다. */}
  {postCount > 0 && (
    <div class="ab-heat">
      <div class="ab-heat-cap">
        <span class="ab-heat-cap-title">발행 스트릭</span>
        <span class="ab-heat-cap-meta">최근 {activity.weeks}주 · {activity.total}편</span>
      </div>
      <ActivityHeatmap activity={activity} />
    </div>
  )}

  <hr />

  <h2>무엇을 쓰나</h2>
  <p class="muted">배우는 큰 줄기를 네 갈래로 나눠 씁니다.</p>
  <dl class="ab-gloss">
    {
      sections.map((s) => (
        <div class="gl-item" style={`--hue: ${hueOf(s.id)}`}>
          <dt class="gl-term">
            <a class="gl-name" href={sectionHref(base, s.id)}>{s.label}</a>
            <span class="gl-count">{s.count}편</span>
          </dt>
          {blurbOf(s.id) && <dd class="gl-def">{blurbOf(s.id)}</dd>}
        </div>
      ))
    }
  </dl>

  <hr />

  <!-- ── 콜로폰: 이 블로그가 어떻게 만들어지나 ── -->
  <h2 id="colophon">이 블로그는 어떻게 만들어지나</h2>
  <p>
    이 사이트의 글은 사람이 웹 에디터에서 쓰는 대신, <strong>AI(Claude)가
    직접 만든 MCP(Model Context Protocol) 서버</strong>를 통해 작성하고 발행합니다.
    사람(저)은 글을 쓰지 않는 대신 파이프라인을 설계해요 — 주제 선정 규칙, 입력 검증,
    발행 전 자기 검토 같은 품질 장치를 만들고 결과를 관리합니다.
    "매일 배운 걸 자동으로 한 편씩 남긴다"는 목표로 서버부터 만들며 배우는 프로젝트예요.
  </p>

  <!-- ── MCP 구동 로직: 서버를 중심으로 도는 발행 워크플로(오비탈) ── -->
  <h3 class="mcp-sub">MCP는 어떻게 도나</h3>
  <p class="muted mcp-lead">
    MCP는 <b>호스트(모델이 있는 앱)</b>와 <b>서버(도구·데이터를 가진 쪽)</b>가
    표준 입출력(stdio) 위에서 JSON-RPC로 대화하는 규약이에요. 이 프로젝트의 서버는
    <b>Tools·Resources·Prompts</b> 세 능력을 제공하고, 아래 궤도는 그것들이 어떻게 맞물려
    <em>글 한 편을 만드는지</em> 보여줍니다 — 주제를 참조하고, 기존 글을 살펴 중복을 피하고,
    쓰고, 스스로 다시 읽어 고치고, 검수하고, 발행하기까지.
  </p>

  <McpOrbit />

  <p class="muted mcp-lead">
    서버 자체는 LLM을 부르지 않아요. 생성(집필)은 호스트 쪽 모델이 맡고, 서버는 <em>무엇을·어떻게</em>의
    규칙(시드 주제, 검증, 파일 저장)만 강제합니다.
  </p>

  <div class="principles">
    <div class="pr">
      <b>무료 원칙</b>
      <span>MCP 서버 자체는 LLM을 호출하지 않습니다. 비용이 드는 생성은 글쓰기 단계에만.</span>
    </div>
    <div class="pr">
      <b>단일 출처</b>
      <span>글쓰기 지침은 <code>write_daily_post</code> 프롬프트, 입력 검증은 <code>publish_post</code> 도구 한 곳에.</span>
    </div>
    <div class="pr">
      <b>정적 SSG</b>
      <span>Astro로 빌드한 순수 정적 사이트 — 빠르고, 서버 없이 어디서나 배포됩니다.</span>
    </div>
  </div>

  <p class="src-note">
    서버(stdio MCP)와 사이트(Astro) 코드는 모두
    <a href={REPO_URL} target="_blank" rel="noopener">GitHub</a>에 공개돼 있습니다.
  </p>
</Base>

<style>
  /* ── 프로필 헤더 ── */
  .about-hero {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }
  .ab-avatar {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border);
    background: var(--c-surface-2);
    object-fit: cover;
  }
  .ab-id {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin-right: auto;
  }
  .ab-name {
    margin: 0;
    font-size: var(--fs-2xl);
    letter-spacing: -0.02em;
  }
  .ab-portfolio {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-muted);
    text-decoration: none;
  }
  .ab-portfolio:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }
  .ab-social {
    display: flex;
    gap: var(--space-2);
  }
  .ab-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    color: var(--c-muted);
  }
  .ab-social a:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  .lead {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--c-text);
    max-width: 68ch;
  }
  .lead strong {
    color: var(--c-accent);
  }

  h2 {
    font-size: var(--fs-xl);
    margin: var(--space-8) 0 var(--space-2);
  }
  /* 모바일: 섹션 사이 48px→32px, 구분선 바로 아래는 hr 리듬(16px)과 같은 박자.
     (스코프 셀렉터가 global.css의 hr+h2 규칙보다 특이도가 높아 여기서 다시 죈다.) */
  @media (max-width: 640px) {
    h2 {
      margin-top: var(--space-6);
    }
    hr + h2 {
      margin-top: var(--space-4);
    }
  }

  /* ── 발행 스트릭 카드 (홈 히어로에서 이동 — lead 문장의 시각 증거) ── */
  .ab-heat {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-5);
    margin-top: var(--space-5);
  }
  .ab-heat-cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--c-border);
  }
  .ab-heat-cap-title {
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--c-text);
  }
  .ab-heat-cap-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .ab-heat {
      padding: var(--space-3) var(--space-4);
    }
  }

  /* ── 카테고리: 사전식 정의 리스트. 색은 카테고리명 글씨에만, 장식(점·바·카드) 없음 ── */
  .ab-gloss {
    margin: var(--space-5) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .gl-item {
    --hue-on: var(--hue, var(--c-accent));
  }
  :global(:root[data-theme="dark"]) .gl-item {
    --hue-on: oklch(from var(--hue, var(--c-accent)) 0.78 calc(c * 0.52) h);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .gl-item {
      --hue-on: oklch(from var(--hue, var(--c-accent)) 0.78 calc(c * 0.52) h);
    }
  }
  .gl-term {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  /* 카테고리명 — 그 색 글씨가 유일한 디자인 신호 */
  .gl-name {
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--hue-on);
    text-decoration: none;
  }
  .gl-name:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .gl-count {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }
  .gl-def {
    margin: 0.15em 0 0;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--c-muted);
  }

  /* ── 원칙 3칸 ── */
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-5) 0;
  }
  .pr {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    padding: var(--space-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
  }
  .pr b {
    font-size: var(--fs-sm);
    letter-spacing: -0.01em;
  }
  .pr span {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--c-muted);
  }

  .src-note {
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }

  /* ── MCP 오비탈 도입부(제목·리드) — 다이어그램 자체는 McpOrbit.astro ── */
  .mcp-sub {
    font-size: var(--fs-lg);
    margin: var(--space-6) 0 var(--space-2);
  }
  .mcp-lead {
    max-width: 68ch;
    line-height: 1.7;
  }
  .mcp-lead em {
    font-style: normal;
    font-weight: 700;
    color: var(--c-text);
  }

  @media (max-width: 640px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .ab-id {
      margin-right: 0;
    }
  }
</style>
