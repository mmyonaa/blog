---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="404 — 페이지를 찾을 수 없어요" description="요청하신 페이지가 없습니다">
  <section class="notfound">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없어요</h1>
    <p class="muted">
      주소가 바뀌었거나 삭제된 글일 수 있습니다. 아래에서 이어가 보세요.
    </p>
    <div class="actions">
      <a class="pill" href={`${base}/`}>홈으로</a>
      <a class="pill" href={`${base}/blog/`}>글 목록</a>
      <a class="pill" href={`${base}/topics/`}>분류</a>
    </div>
    <p class="hint muted">
      또는 <kbd>/</kbd> 키를 눌러 검색해 보세요.
    </p>
  </section>
</Base>

<style>
  .notfound {
    text-align: center;
    padding: var(--space-10) 0;
    max-width: 40ch;
    margin: 0 auto;
  }
  .code {
    font-size: clamp(3rem, 12vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--c-accent);
    margin: 0 0 var(--space-2);
    line-height: 1;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-6) 0 var(--space-4);
  }
  .actions .pill {
    font-size: var(--fs-sm);
    padding: 0.35em 0.9em;
  }
  .hint kbd {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    padding: 0.15em 0.45em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-surface);
  }
</style>
