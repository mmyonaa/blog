---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostViews from "../../components/PostViews.astro";
import Pagination from "../../components/Pagination.astro";
import BlogFilterLinks from "../../components/BlogFilterLinks.astro";
import { PAGE_SIZE } from "../../lib/pagination.ts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const pageItems = posts.slice(0, PAGE_SIZE);
// 페이지 1 = /blog/, 이후 = /blog/page/N/
const pageHref = (n: number) => (n <= 1 ? `${base}/blog/` : `${base}/blog/page/${n}/`);
---

<Base title="글 목록 — blog" description="블로그의 전체 글. 카테고리·태그로도 볼 수 있습니다.">
  <h1>글 목록</h1>
  <p class="muted">{posts.length}개의 글 · 최신순</p>

  <BlogFilterLinks />
  <hr />

  {
    posts.length === 0 ? (
      <p class="muted">아직 발행된 글이 없습니다.</p>
    ) : (
      <>
        <PostViews posts={pageItems} toggle={false} />
        <Pagination currentPage={1} lastPage={lastPage} hrefFor={pageHref} />
      </>
    )
  }
</Base>
