---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { tagHref, getTagCounts } from "../../lib/tags.ts";
import { getSectionCounts } from "../../lib/sections.ts";
import { fmtDateTime } from "../../lib/date.ts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = await getSectionCounts();
const tags = await getTagCounts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

/** 글의 카테고리 id(없으면 mcp). */
const catOf = (p: (typeof posts)[number]) =>
  typeof p.data.section === "string" && p.data.section.trim() !== "" ? p.data.section : "mcp";

// 커스텀 드롭다운 옵션(전체 + 각 항목). label=트리거 표시용(개수 제외), text=목록 표시용.
const categoryOptions = [
  { value: "", label: "전체", text: "전체" },
  ...categories.map((c) => ({ value: c.id, label: c.label, text: `${c.label} (${c.count})` })),
];
const tagOptions = [
  { value: "", label: "전체", text: "전체" },
  ...tags.map((t) => ({ value: t.tag, label: t.tag, text: `${t.tag} (${t.count})` })),
];
const dropdowns = [
  { name: "category", label: "카테고리", options: categoryOptions },
  { name: "tag", label: "태그", options: tagOptions },
];
---

<Base title="글 목록 — blog" description="블로그의 전체 글을 카테고리·태그로 걸러봅니다">
  <h1>글 목록</h1>
  <p class="muted"><span data-count>{posts.length}</span>개의 글 · 최신순</p>

  {
    posts.length > 0 && (
      <div class="filters">
        {dropdowns.map((dd) => (
          <div class="filter" data-dropdown data-name={dd.name} data-value="">
            <span class="filter-label" id={`dd-label-${dd.name}`}>
              {dd.label}
            </span>
            <button
              type="button"
              class="dd-trigger"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-labelledby={`dd-label-${dd.name} dd-val-${dd.name}`}
            >
              <span class="dd-value" id={`dd-val-${dd.name}`} data-dd-value>
                전체
              </span>
              <svg class="dd-arrow" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <ul class="dd-list" role="listbox" aria-labelledby={`dd-label-${dd.name}`} hidden>
              {dd.options.map((o) => (
                <li
                  role="option"
                  tabindex="-1"
                  data-value={o.value}
                  data-label={o.label}
                  aria-selected={o.value === "" ? "true" : "false"}
                >
                  {o.text}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <button type="button" class="filter-reset" data-filter-reset hidden>초기화</button>
      </div>
    )
  }
  <hr />

  {
    posts.length === 0 ? (
      <p class="muted">아직 발행된 글이 없습니다.</p>
    ) : (
      <>
        <ul class="post-list" data-post-list>
          {posts.map((post) => (
            <li
              class="post-item"
              data-category={catOf(post)}
              data-tags={post.data.tags.join(",")}
            >
              <div class="muted post-date">{fmtDateTime(post.data.pubDate)}</div>
              <h2 class="post-title">
                <a href={href(post.id)}>{post.data.title}</a>
              </h2>
              {post.data.description && <p class="post-desc">{post.data.description}</p>}
              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map((t) => (
                    <a class="pill" href={tagHref(base, t)}>
                      {t}
                    </a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
        <p class="muted empty" data-empty hidden>
          조건에 맞는 글이 없습니다.
        </p>
      </>
    )
  }
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-5) 0 var(--space-3);
  }

  /* 라벨 + 트리거를 한 알약에 묶는다 */
  .filter {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-left: 0.9em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full, 999px);
    background: var(--c-surface);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .filter:hover {
    border-color: var(--c-accent);
  }
  .filter:focus-within {
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px var(--c-accent-soft);
  }
  .filter-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--c-muted);
    white-space: nowrap;
  }

  .dd-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-text);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5em 0.9em 0.5em 0.1em;
    border-radius: var(--radius-full, 999px);
  }
  .dd-trigger:focus-visible {
    outline: none;
  }
  .dd-arrow {
    flex-shrink: 0;
    color: var(--c-muted);
    transition: transform 0.15s ease;
  }
  .dd-trigger[aria-expanded="true"] .dd-arrow {
    transform: rotate(180deg);
  }

  /* 커스텀 드롭다운 목록(네이티브 select 팝업 대체) */
  .dd-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 100%;
    width: max-content;
    max-width: 18rem;
    max-height: 16rem;
    overflow-y: auto;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    z-index: 20;
    animation: dd-in 0.12s ease;
  }
  .dd-list[hidden] {
    display: none;
  }
  @keyframes dd-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dd-list {
      animation: none;
    }
  }
  .dd-list [role="option"] {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5em 0.7em;
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    color: var(--c-text);
    cursor: pointer;
    white-space: nowrap;
    outline: none;
  }
  /* 선택 표시용 체크 자리(항상 확보 → 텍스트 정렬 유지) */
  .dd-list [role="option"]::before {
    content: "";
    width: 0.9em;
    flex-shrink: 0;
    color: var(--c-accent);
    font-weight: 700;
  }
  .dd-list [role="option"][aria-selected="true"]::before {
    content: "✓";
  }
  .dd-list [role="option"]:hover,
  .dd-list [role="option"]:focus {
    background: var(--c-accent-soft);
  }
  .dd-list [role="option"][aria-selected="true"] {
    color: var(--c-accent);
    font-weight: 700;
  }

  .filter-reset {
    font: inherit;
    font-size: var(--fs-sm);
    cursor: pointer;
    border: none;
    background: transparent;
    color: var(--c-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0.4em 0.2em;
  }
  .filter-reset:hover {
    color: var(--c-accent);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--c-border);
  }
  .post-item[hidden] {
    display: none;
  }
  .post-date {
    font-size: var(--fs-xs);
  }
  .post-title {
    font-size: var(--fs-xl);
    margin: var(--space-1) 0 var(--space-2);
  }
  .post-title a {
    color: var(--c-text);
  }
  .post-title a:hover {
    color: var(--c-accent);
    text-decoration: none;
  }
  .post-desc {
    color: var(--c-muted);
    margin: 0 0 var(--space-3);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .empty {
    padding: var(--space-6) 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .filter {
      flex: 1 1 100%;
    }
    .dd-trigger {
      flex: 1;
      justify-content: space-between;
    }
    .dd-list {
      max-width: none;
    }
  }
</style>

<script>
  // /blog/ 카테고리·태그 필터 + 커스텀 드롭다운(네이티브 select 팝업이 OS 스타일이라 대체).
  // SSG라 전 글을 렌더해두고 클라이언트에서 show/hide. View Transitions 대응: 문서 리스너는
  // 한 번만 매고 astro:page-load마다 재초기화한다.

  /** 커스텀 드롭다운 하나를 구동. onChange는 선택이 바뀔 때 호출. */
  function setupDropdown(dd: HTMLElement, onChange: () => void) {
    const trigger = dd.querySelector<HTMLButtonElement>(".dd-trigger")!;
    const listEl = dd.querySelector<HTMLElement>(".dd-list")!;
    const valEl = dd.querySelector<HTMLElement>("[data-dd-value]")!;
    const options = Array.from(listEl.querySelectorAll<HTMLElement>('[role="option"]'));
    let focusIdx = 0;

    const isOpen = () => !listEl.hidden;
    const open = () => {
      listEl.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      focusIdx = Math.max(
        0,
        options.findIndex((o) => o.getAttribute("aria-selected") === "true"),
      );
      options[focusIdx]?.focus();
    };
    const close = (focusTrigger = false) => {
      listEl.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      if (focusTrigger) trigger.focus();
    };
    const choose = (opt: HTMLElement) => {
      options.forEach((o) => o.setAttribute("aria-selected", "false"));
      opt.setAttribute("aria-selected", "true");
      dd.dataset.value = opt.dataset.value || "";
      valEl.textContent = opt.dataset.label || opt.textContent?.trim() || "";
      close(true);
      onChange();
    };

    trigger.addEventListener("click", () => (isOpen() ? close() : open()));
    options.forEach((opt, i) => {
      opt.addEventListener("click", () => choose(opt));
      opt.addEventListener("mouseenter", () => {
        focusIdx = i;
        opt.focus();
      });
    });

    dd.addEventListener("keydown", (e: KeyboardEvent) => {
      if (!isOpen()) {
        if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          open();
        }
        return;
      }
      if (e.key === "Escape") {
        e.preventDefault();
        close(true);
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        focusIdx = (focusIdx + 1) % options.length;
        options[focusIdx].focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        focusIdx = (focusIdx - 1 + options.length) % options.length;
        options[focusIdx].focus();
      } else if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        choose(options[focusIdx]);
      } else if (e.key === "Tab") {
        close();
      }
    });

    // 외부(URL 등)에서 값 지정
    (dd as any)._setValue = (value: string) => {
      const opt = options.find((o) => (o.dataset.value || "") === value) || options[0];
      options.forEach((o) => o.setAttribute("aria-selected", "false"));
      opt.setAttribute("aria-selected", "true");
      dd.dataset.value = opt.dataset.value || "";
      valEl.textContent = opt.dataset.label || opt.textContent?.trim() || "";
    };
  }

  function initBlogFilter() {
    const list = document.querySelector<HTMLElement>("[data-post-list]");
    const dropdowns = Array.from(document.querySelectorAll<HTMLElement>("[data-dropdown]"));
    if (!list || dropdowns.length === 0) return; // /blog/ 목록 페이지가 아니면 무시

    const items = Array.from(list.querySelectorAll<HTMLElement>(".post-item"));
    const countEl = document.querySelector<HTMLElement>("[data-count]");
    const emptyEl = document.querySelector<HTMLElement>("[data-empty]");
    const resetBtn = document.querySelector<HTMLElement>("[data-filter-reset]");

    const getVal = (name: string) =>
      dropdowns.find((d) => d.dataset.name === name)?.dataset.value || "";

    const apply = (pushUrl: boolean) => {
      const cat = getVal("category");
      const tag = getVal("tag");
      let visible = 0;
      for (const li of items) {
        const liCat = li.getAttribute("data-category") || "";
        const liTags = (li.getAttribute("data-tags") || "").split(",").filter(Boolean);
        const ok = (!cat || liCat === cat) && (!tag || liTags.includes(tag));
        li.hidden = !ok;
        if (ok) visible++;
      }
      if (countEl) countEl.textContent = String(visible);
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (resetBtn) resetBtn.hidden = !cat && !tag;
      if (pushUrl) {
        const params = new URLSearchParams();
        if (cat) params.set("category", cat);
        if (tag) params.set("tag", tag);
        const qs = params.toString();
        history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
      }
    };

    dropdowns.forEach((dd) => setupDropdown(dd, () => apply(true)));

    // URL 쿼리 → 초기 선택
    const params = new URLSearchParams(location.search);
    dropdowns.forEach((dd) => (dd as any)._setValue(params.get(dd.dataset.name || "") || ""));

    resetBtn?.addEventListener("click", () => {
      dropdowns.forEach((dd) => (dd as any)._setValue(""));
      apply(true);
    });

    apply(false);
  }

  if (!(window as any).__blogFilterBound) {
    (window as any).__blogFilterBound = true;
    document.addEventListener("astro:page-load", initBlogFilter);
    // 바깥 클릭 → 열린 드롭다운 닫기(문서에 한 번만)
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dd) => {
        if (dd.contains(t)) return;
        const listEl = dd.querySelector<HTMLElement>(".dd-list");
        const trigger = dd.querySelector<HTMLElement>(".dd-trigger");
        if (listEl && !listEl.hidden) {
          listEl.hidden = true;
          trigger?.setAttribute("aria-expanded", "false");
        }
      });
    });
  }
</script>
