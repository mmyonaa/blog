---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { tagHref } from "../../lib/tags.ts";
import { fmtDateTime } from "../../lib/date.ts";
import { sectionLabel, sectionHref, hueOf, sectionOf } from "../../lib/sections.ts";
import { relatedPosts, type Related } from "../../lib/related.ts";
import Comments from "../../components/Comments.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
      related: relatedPosts(post, posts, 3),
    },
  }));
}

type Entry = CollectionEntry<"blog">;
interface Props {
  post: Entry;
  newer: Entry | null;
  older: Entry | null;
  related: Related[];
}

const { post, newer, older, related } = Astro.props as Props;
const { Content, headings } = await render(post);

// 이 글의 카테고리(섹션) — 목록/카드와 같은 라벨·색을 헤더에도 노출.
const section = sectionOf(post);

// 좌측 사이드바용 글 목록(최신순) — 현재 보고 있는 글은 제외하고, 최근 N개만.
// (스크롤이 생기지 않도록 개수 제한. 전체는 상단 '글 목록 →' 링크로.)
const SIDEBAR_MAX = 5;
const allPosts = (await getCollection("blog"))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, SIDEBAR_MAX);

// 우측 목차: 본문의 h2/h3만 사용 (h1은 제목이라 제외)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

// 검색엔진용 구조화 데이터(BlogPosting)
const pageUrl = Astro.site
  ? new URL(`${base}/blog/${post.id}/`, Astro.site).href
  : `${base}/blog/${post.id}/`;
const ogImg = Astro.site ? new URL(`${base}/og.png`, Astro.site).href : `${base}/og.png`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description ?? "",
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  keywords: post.data.tags,
  url: pageUrl,
  image: ogImg,
  mainEntityOfPage: pageUrl,
  author: { "@type": "Person", name: "blog" },
  publisher: { "@type": "Organization", name: "blog", logo: { "@type": "ImageObject", url: ogImg } },
};
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <div class="article-shell">
    <div class="post-header-area">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="meta" style={`--hue: ${hueOf(section)}`}>
          <a class="category" href={sectionHref(base, section)}>{sectionLabel(section)}</a>
          <span>{fmtDateTime(post.data.pubDate)}</span>
          {post.data.tags.length > 0 && (
            <span class="tags">
              {post.data.tags.map((t) => <a class="tag" href={tagHref(base, t)}>{t}</a>)}
            </span>
          )}
          <button type="button" class="pill share-btn" data-share aria-live="polite">
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" class="share-icon">
              <path
                d="M8.7 11.3a3.5 3.5 0 0 0 5.05.13l2.12-2.12a3.5 3.5 0 0 0-4.95-4.95l-1.2 1.2M11.3 8.7a3.5 3.5 0 0 0-5.05-.13L4.13 10.7a3.5 3.5 0 0 0 4.95 4.95l1.2-1.2"
                fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            <span class="share-label">링크 복사</span>
          </button>
        </div>
      </header>
      <hr />
    </div>

    <a class="side-left-head side-title side-title-link" href={`${base}/blog/`}>글 목록 →</a>
    <aside class="side side-left" aria-label="글 목록">
      <ul class="postlist">
        {
          allPosts.map((p) => {
            const psec = sectionOf(p);
            return (
              <li>
                <a
                  href={href(p.id)}
                  class="postlist-link"
                  style={`--hue: ${hueOf(psec)}`}
                >
                  <span class="postlist-cat">{sectionLabel(psec)}</span>
                  <span class="postlist-title">{p.data.title}</span>
                  <span class="postlist-date">{fmtDateTime(p.data.pubDate)}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </aside>

    <div class="reading">
      <article class="prose">
        <Content />
      </article>

      {/* 참고 자료(#18) — 리서치 종합 글의 근거 출처. 투명성 장치라 본문 바로 아래. */}
      {
        post.data.sources.length > 0 && (
          <section class="sources" aria-label="참고 자료">
            <h2 class="sources-title">참고 자료</h2>
            <ol class="sources-list">
              {post.data.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener nofollow">
                    {s.title ?? s.url}
                  </a>
                  {s.title && <span class="sources-host">{new URL(s.url).hostname}</span>}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <!-- AI 작성 고지 — 이 블로그의 콘셉트이자 투명성 장치. 모든 글에 자동 적용. -->
      <aside class="ai-note" role="note">
        이 글은 AI(Claude)가 MCP 파이프라인으로
        {post.data.generated === "research-synthesis"
          ? "웹 리서치를 종합해 작성·발행했습니다 (출처는 위 참고 자료)."
          : "작성·발행했습니다."}
        <a href={`${base}/about/#colophon`}>어떻게 만들어지나</a> ·
        오류 지적은 댓글이나 Feedback으로 부탁드려요.
      </aside>

      <RelatedPosts items={related} />

      {
        (older || newer) && (
          <nav class="postnav">
            {older ? (
              <a class="postnav-item" href={href(older.id)}>
                <span class="postnav-label">← 이전</span>
                <span class="postnav-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer ? (
              <a class="postnav-item postnav-next" href={href(newer.id)}>
                <span class="postnav-label">다음 →</span>
                <span class="postnav-title">{newer.data.title}</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }

      <Comments />
    </div>

    {
      toc.length > 0 && (
        <aside class="side side-toc" aria-label="목차">
          <p class="side-title">목차</p>
          <nav class="toc">
            <ul>
              {toc.map((h) => (
                <li class:list={[`toc-h${h.depth}`]}>
                  <a href={`#${h.slug}`} data-slug={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }

    {/* 모바일 목차: 글 위 아코디언 대신 우측 슬라이드 드로어(≤980).
        읽는 중 어디서든 좌하단 FAB로 열어 섹션 점프할 수 있다. */}
    {
      toc.length > 0 && (
        <>
          <button
            class="toc-fab"
            type="button"
            aria-label="목차 열기"
            aria-expanded="false"
            data-toc-open
          >
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <circle cx="2.2" cy="3.4" r="1.15" fill="currentColor" />
              <circle cx="2.2" cy="8" r="1.15" fill="currentColor" />
              <circle cx="2.2" cy="12.6" r="1.15" fill="currentColor" />
              <rect x="5.4" y="2.5" width="9.6" height="1.8" rx="0.9" fill="currentColor" />
              <rect x="5.4" y="7.1" width="9.6" height="1.8" rx="0.9" fill="currentColor" />
              <rect x="5.4" y="11.7" width="9.6" height="1.8" rx="0.9" fill="currentColor" />
            </svg>
          </button>
          <div class="toc-overlay" data-toc-close aria-hidden="true" />
          <aside class="toc-drawer" aria-label="목차">
            <div class="toc-drawer-head">
              <p class="side-title">목차</p>
              <button
                class="toc-drawer-x"
                type="button"
                aria-label="목차 닫기"
                data-toc-close
              >
                ✕
              </button>
            </div>
            <nav class="toc">
              <ul>
                {toc.map((h) => (
                  <li class:list={[`toc-h${h.depth}`]}>
                    <a href={`#${h.slug}`} data-slug={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        </>
      )
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<script>
  // 스크롤 스파이: 현재 화면 상단에 있는 섹션을 목차에서 강조.
  // View Transitions로 다른 글로 이동해도 astro:page-load 마다 다시 초기화한다.
  function initScrollSpy() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc a[data-slug]"),
    );
    if (!links.length) return;
    // 같은 slug의 링크가 사이드 목차와 모바일 드로어 양쪽에 있으므로 배열로 모은다.
    const bySlug = new Map<string, HTMLAnchorElement[]>();
    for (const a of links) {
      const k = a.dataset.slug!;
      bySlug.set(k, [...(bySlug.get(k) ?? []), a]);
    }
    const headings = document.querySelectorAll<HTMLElement>(
      ".prose h2[id], .prose h3[id]",
    );
    let current: HTMLAnchorElement[] = [];
    const setActive = (els: HTMLAnchorElement[] | undefined) => {
      if (!els || els === current) return;
      for (const el of current) el.classList.remove("active");
      for (const el of els) el.classList.add("active");
      current = els;
    };
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive(bySlug.get(e.target.id));
        }
      },
      { rootMargin: "0px 0px -75% 0px", threshold: 0 },
    );
    headings.forEach((h) => obs.observe(h));
  }
  document.addEventListener("astro:page-load", initScrollSpy);

  // 모바일 목차 드로어 — 문서 위임으로 한 번만 바인딩(View Transitions에도 안전).
  // 열림 상태는 DOM 클래스가 단일 출처: html.toc-open은 배경 스크롤 잠금용.
  function setTocDrawer(open: boolean) {
    document.documentElement.classList.toggle("toc-open", open);
    const drawer = document.querySelector(".toc-drawer");
    const overlay = document.querySelector(".toc-overlay");
    const fab = document.querySelector(".toc-fab");
    if (!drawer || !overlay || !fab) return;
    drawer.classList.toggle("open", open);
    overlay.classList.toggle("open", open);
    fab.setAttribute("aria-expanded", String(open));
  }
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t.closest("[data-toc-open]")) {
      setTocDrawer(
        !document.querySelector(".toc-drawer")?.classList.contains("open"),
      );
    } else if (t.closest("[data-toc-close]") || t.closest(".toc-drawer a")) {
      // 항목 클릭 = 점프 후 닫기(앵커 이동 자체는 브라우저 기본 동작에 맡긴다)
      setTocDrawer(false);
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setTocDrawer(false);
  });
  // 글→다른 페이지로 View Transitions 이동 시 잔여 스크롤 잠금 해제
  document.addEventListener("astro:page-load", () => setTocDrawer(false));

  // 헤딩 앵커: h2/h3 옆에 섹션 링크(#) 주입. 호버 시 노출.
  function initHeadingAnchors() {
    document
      .querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id]")
      .forEach((h) => {
        if (h.querySelector(".heading-anchor")) return;
        const a = document.createElement("a");
        a.className = "heading-anchor";
        a.href = `#${h.id}`;
        a.setAttribute("aria-label", "이 섹션 링크");
        a.textContent = "#";
        h.appendChild(a);
      });
  }
  document.addEventListener("astro:page-load", initHeadingAnchors);

  // 링크 복사(공유). 문서 위임으로 한 번만 등록해 View Transitions에도 유지.
  if (!(window as any).__shareBound) {
    (window as any).__shareBound = true;
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-share]");
      if (!btn) return;
      const url = location.origin + location.pathname;
      const label = btn.querySelector<HTMLElement>(".share-label");
      const done = (msg: string) => {
        if (!label) return;
        const prev = label.textContent;
        label.textContent = msg;
        btn.classList.add("copied");
        window.setTimeout(() => {
          label.textContent = prev;
          btn.classList.remove("copied");
        }, 1600);
      };
      try {
        await navigator.clipboard.writeText(url);
        done("복사됨!");
      } catch {
        // 클립보드 API 불가 시 폴백(구형/비보안 컨텍스트)
        const ta = document.createElement("textarea");
        ta.value = url;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand("copy");
          done("복사됨!");
        } catch {
          done("복사 실패");
        }
        ta.remove();
      }
    });
  }
</script>

<style>
  /*
   * 3단 셸: [글 목록] [본문 720] [목차]
   * 본문은 항상 읽기 폭(720)으로 고정, 사이드바가 남는 폭을 채워 헤더와 정렬.
   * 넓은 화면=3단 → 태블릿=본문+목차 2단 → 좁은 화면=본문 단독(720 중앙).
   */
  .article-shell {
    display: grid;
    grid-template-columns:
      minmax(180px, 1fr)
      minmax(0, var(--content-width))
      minmax(180px, 1fr);
    /* 제목(헤더)은 가운데 열의 1행에만, 사이드바는 2행부터 → 좌·우 사이드바가
       본문 시작선에 맞춰 내려온다. 세로 간격은 헤더의 hr 여백이 담당하므로 row-gap 0. */
    grid-template-areas:
      "lefthead header ."
      "left     body   toc";
    column-gap: var(--space-6);
    row-gap: 0;
    align-items: start;
  }
  .post-header-area {
    grid-area: header;
  }
  /* 타이틀 섹션의 보더(hr)에 좌·우 사이드바 상단을 맞춘다: hr 하단 마진을 0으로 두어
     2행(사이드바+본문)이 보더 라인에서 시작하고, 본문만 padding-top으로 여백을 회복. */
  .post-header-area hr {
    margin-bottom: 0;
  }
  /* '글 목록 →' 링크는 좌측 상단(제목 줄 높이)에, 실제 목록은 본문 시작선에 정렬 */
  .side-left-head {
    grid-area: lefthead;
  }
  .side-left {
    grid-area: left;
  }
  .reading {
    grid-area: body;
  }
  .side-toc {
    grid-area: toc;
  }

  .reading {
    min-width: 0;
    max-width: var(--content-width);
    margin: 0 auto;
    width: 100%;
    /* 사이드바는 hr 보더 라인에서 시작하고, 본문 텍스트만 보더와 여백을 둔다. */
    padding-top: var(--space-6);
  }

  /* ── 참고 자료(#18) — 리서치 글의 출처 목록. 섹션 상단 룰로 본문과 구획. ── */
  .sources {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-border);
  }
  .sources-title {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 var(--space-3);
  }
  .sources-list {
    margin: 0;
    padding-left: 1.2em;
    font-size: var(--fs-sm);
    line-height: 1.8;
  }
  .sources-list a {
    word-break: break-all;
  }
  .sources-host {
    margin-left: 0.5em;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }

  /* ── AI 작성 고지 — 본문 끝의 조용한 한 줄 ──
     박스(배경·보더·패딩) 없이 낮은 톤 텍스트로만. 존재는 하되 티나지 않게. */
  .ai-note {
    display: block;
    margin-top: var(--space-6);
    color: var(--c-muted);
    font-size: var(--fs-xs);
    line-height: 1.7;
    word-break: keep-all;
  }
  .ai-note a {
    color: var(--c-muted);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .ai-note a:hover {
    color: var(--c-accent);
  }

  /* ── 사이드바 공통 ── */
  .side {
    position: sticky;
    /* sticky 헤더 아래에서 시작하도록 헤더 높이만큼 내려 붙인다. */
    top: calc(var(--header-h) + var(--space-4));
    align-self: start;
    max-height: calc(100vh - var(--header-h) - var(--space-6));
    overflow-y: auto;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .side-title {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 var(--space-3);
  }
  a.side-title-link:hover {
    color: var(--c-accent);
    text-decoration: none;
  }
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── 좌: 글 목록 ── */
  .postlist li {
    margin-bottom: var(--space-2);
  }
  /* 목록의 글 요소처럼 — 보더 있는 카드 + 카테고리(색 점+이름)/제목/날짜 */
  .postlist-link {
    display: block;
    padding: var(--space-3);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
    color: var(--c-muted);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    /* 카테고리 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --hue-on: var(--hue);
  }
  :global(:root[data-theme="dark"]) .postlist-link {
    --hue-on: oklch(from var(--hue) 0.78 calc(c * 0.52) h);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .postlist-link {
      --hue-on: oklch(from var(--hue) 0.78 calc(c * 0.52) h);
    }
  }
  .postlist-link:hover {
    border-color: color-mix(in srgb, var(--hue-on) 45%, var(--c-border));
    box-shadow: var(--shadow-md);
    color: var(--c-text);
    text-decoration: none;
  }
  /* 카테고리 아이브로우 — 색 점 + 이름 */
  .postlist-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--hue-on);
    font-weight: 700;
    font-size: var(--fs-xs);
    margin-bottom: 0.25em;
