---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { tagHref } from "../../lib/tags.ts";
import { fmtDateTime } from "../../lib/date.ts";
import { sectionLabel, sectionHref, hueOf, sectionOf } from "../../lib/sections.ts";
import { relatedPosts, type Related } from "../../lib/related.ts";
import Comments from "../../components/Comments.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
      related: relatedPosts(post, posts, 3),
    },
  }));
}

type Entry = CollectionEntry<"blog">;
interface Props {
  post: Entry;
  newer: Entry | null;
  older: Entry | null;
  related: Related[];
}

const { post, newer, older, related } = Astro.props as Props;
const { Content, headings } = await render(post);

// 이 글의 카테고리(섹션) — 목록/카드와 같은 라벨·색을 헤더에도 노출.
const section = sectionOf(post);

// 좌측 사이드바용 글 목록(최신순) — 현재 보고 있는 글은 제외하고, 최근 N개만.
// (스크롤이 생기지 않도록 개수 제한. 전체는 상단 '글 목록 →' 링크로.)
const SIDEBAR_MAX = 5;
const allPosts = (await getCollection("blog"))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, SIDEBAR_MAX);

// 우측 목차: 본문의 h2/h3만 사용 (h1은 제목이라 제외)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

// 검색엔진용 구조화 데이터(BlogPosting)
const pageUrl = Astro.site
  ? new URL(`${base}/blog/${post.id}/`, Astro.site).href
  : `${base}/blog/${post.id}/`;
const ogImg = Astro.site ? new URL(`${base}/og.png`, Astro.site).href : `${base}/og.png`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description ?? "",
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  keywords: post.data.tags,
  url: pageUrl,
  image: ogImg,
  mainEntityOfPage: pageUrl,
  author: { "@type": "Person", name: "blog" },
  publisher: { "@type": "Organization", name: "blog", logo: { "@type": "ImageObject", url: ogImg } },
};
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <div class="article-shell">
    <div class="post-header-area">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="meta" style={`--hue: ${hueOf(section)}`}>
          <a class="category" href={sectionHref(base, section)}>{sectionLabel(section)}</a>
          <span>{fmtDateTime(post.data.pubDate)}</span>
          {post.data.tags.length > 0 && (
            <span class="tags">
              {post.data.tags.map((t) => <a class="pill" href={tagHref(base, t)}>{t}</a>)}
            </span>
          )}
          <button type="button" class="pill share-btn" data-share aria-live="polite">
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" class="share-icon">
              <path
                d="M8.7 11.3a3.5 3.5 0 0 0 5.05.13l2.12-2.12a3.5 3.5 0 0 0-4.95-4.95l-1.2 1.2M11.3 8.7a3.5 3.5 0 0 0-5.05-.13L4.13 10.7a3.5 3.5 0 0 0 4.95 4.95l1.2-1.2"
                fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            <span class="share-label">링크 복사</span>
          </button>
        </div>
      </header>
      <hr />
    </div>

    <a class="side-left-head side-title side-title-link" href={`${base}/blog/`}>글 목록 →</a>
    <aside class="side side-left" aria-label="글 목록">
      <ul class="postlist">
        {
          allPosts.map((p) => (
            <li>
              <a
                href={href(p.id)}
                class:list={["postlist-link", { current: p.id === post.id }]}
                aria-current={p.id === post.id ? "page" : undefined}
              >
                <span class="postlist-date">{fmtDateTime(p.data.pubDate)}</span>
                <span class="postlist-title">{p.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="reading">
      <article class="prose">
        {
          toc.length > 0 && (
            <details class="mobile-toc">
              <summary>목차</summary>
              <nav class="toc">
                <ul>
                  {toc.map((h) => (
                    <li class:list={[`toc-h${h.depth}`]}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )
        }
        <Content />
      </article>

      <RelatedPosts items={related} />

      {
        (older || newer) && (
          <nav class="postnav">
            {older ? (
              <a class="postnav-item" href={href(older.id)}>
                <span class="postnav-label">← 이전</span>
                <span class="postnav-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer ? (
              <a class="postnav-item postnav-next" href={href(newer.id)}>
                <span class="postnav-label">다음 →</span>
                <span class="postnav-title">{newer.data.title}</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }

      <Comments />
    </div>

    {
      toc.length > 0 && (
        <aside class="side side-toc" aria-label="목차">
          <p class="side-title">목차</p>
          <nav class="toc">
            <ul>
              {toc.map((h) => (
                <li class:list={[`toc-h${h.depth}`]}>
                  <a href={`#${h.slug}`} data-slug={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<script>
  // 스크롤 스파이: 현재 화면 상단에 있는 섹션을 목차에서 강조.
  // View Transitions로 다른 글로 이동해도 astro:page-load 마다 다시 초기화한다.
  function initScrollSpy() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc a[data-slug]"),
    );
    if (!links.length) return;
    const bySlug = new Map(links.map((a) => [a.dataset.slug, a]));
    const headings = document.querySelectorAll<HTMLElement>(
      ".prose h2[id], .prose h3[id]",
    );
    let current: HTMLAnchorElement | null = null;
    const setActive = (el: HTMLAnchorElement | undefined) => {
      if (!el || el === current) return;
      current?.classList.remove("active");
      el.classList.add("active");
      current = el;
    };
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive(bySlug.get(e.target.id));
        }
      },
      { rootMargin: "0px 0px -75% 0px", threshold: 0 },
    );
    headings.forEach((h) => obs.observe(h));
  }
  document.addEventListener("astro:page-load", initScrollSpy);

  // 헤딩 앵커: h2/h3 옆에 섹션 링크(#) 주입. 호버 시 노출.
  function initHeadingAnchors() {
    document
      .querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id]")
      .forEach((h) => {
        if (h.querySelector(".heading-anchor")) return;
        const a = document.createElement("a");
        a.className = "heading-anchor";
        a.href = `#${h.id}`;
        a.setAttribute("aria-label", "이 섹션 링크");
        a.textContent = "#";
        h.appendChild(a);
      });
  }
  document.addEventListener("astro:page-load", initHeadingAnchors);

  // 링크 복사(공유). 문서 위임으로 한 번만 등록해 View Transitions에도 유지.
  if (!(window as any).__shareBound) {
    (window as any).__shareBound = true;
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-share]");
      if (!btn) return;
      const url = location.origin + location.pathname;
      const label = btn.querySelector<HTMLElement>(".share-label");
      const done = (msg: string) => {
        if (!label) return;
        const prev = label.textContent;
        label.textContent = msg;
        btn.classList.add("copied");
        window.setTimeout(() => {
          label.textContent = prev;
          btn.classList.remove("copied");
        }, 1600);
      };
      try {
        await navigator.clipboard.writeText(url);
        done("복사됨!");
      } catch {
        // 클립보드 API 불가 시 폴백(구형/비보안 컨텍스트)
        const ta = document.createElement("textarea");
        ta.value = url;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand("copy");
          done("복사됨!");
        } catch {
          done("복사 실패");
        }
        ta.remove();
      }
    });
  }
</script>

<style>
  /*
   * 3단 셸: [글 목록] [본문 720] [목차]
   * 본문은 항상 읽기 폭(720)으로 고정, 사이드바가 남는 폭을 채워 헤더와 정렬.
   * 넓은 화면=3단 → 태블릿=본문+목차 2단 → 좁은 화면=본문 단독(720 중앙).
   */
  .article-shell {
    display: grid;
    grid-template-columns:
      minmax(180px, 1fr)
      minmax(0, var(--content-width))
      minmax(180px, 1fr);
    /* 제목(헤더)은 가운데 열의 1행에만, 사이드바는 2행부터 → 좌·우 사이드바가
       본문 시작선에 맞춰 내려온다. 세로 간격은 헤더의 hr 여백이 담당하므로 row-gap 0. */
    grid-template-areas:
      "lefthead header ."
      "left     body   toc";
    column-gap: var(--space-6);
    row-gap: 0;
    align-items: start;
  }
  .post-header-area {
    grid-area: header;
  }
  /* 타이틀 섹션의 보더(hr)에 좌·우 사이드바 상단을 맞춘다: hr 하단 마진을 0으로 두어
     2행(사이드바+본문)이 보더 라인에서 시작하고, 본문만 padding-top으로 여백을 회복. */
  .post-header-area hr {
    margin-bottom: 0;
  }
  /* '글 목록 →' 링크는 좌측 상단(제목 줄 높이)에, 실제 목록은 본문 시작선에 정렬 */
  .side-left-head {
    grid-area: lefthead;
  }
  .side-left {
    grid-area: left;
  }
  .reading {
    grid-area: body;
  }
  .side-toc {
    grid-area: toc;
  }

  .reading {
    min-width: 0;
    max-width: var(--content-width);
    margin: 0 auto;
    width: 100%;
    /* 사이드바는 hr 보더 라인에서 시작하고, 본문 텍스트만 보더와 여백을 둔다. */
    padding-top: var(--space-6);
  }

  /* ── 사이드바 공통 ── */
  .side {
    position: sticky;
    /* sticky 헤더 아래에서 시작하도록 헤더 높이만큼 내려 붙인다. */
    top: calc(var(--header-h) + var(--space-4));
    align-self: start;
    max-height: calc(100vh - var(--header-h) - var(--space-6));
    overflow-y: auto;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .side-title {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 var(--space-3);
  }
  a.side-title-link:hover {
    color: var(--c-accent);
    text-decoration: none;
  }
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── 좌: 글 목록 ── */
  .postlist li {
    margin-bottom: var(--space-2);
  }
  .postlist-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--c-muted);
    border-left: 2px solid transparent;
  }
  .postlist-link:hover {
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
  }
  .postlist-link.current {
    background: var(--c-accent-soft);
    border-left-color: var(--c-accent);
    color: var(--c-text);
  }
  .postlist-date {
    display: block;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    margin-bottom: var(--space-1);
  }
  .postlist-title {
    display: block;
    font-weight: 600;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .postlist-link.current .postlist-title {
    color: var(--c-accent);
  }

  /* ── 우: 목차 ── */
  .toc a {
    display: block;
    padding: 0.25em var(--space-3);
    color: var(--c-muted);
    border-left: 2px solid var(--c-border);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--c-text);
  }
  .toc a.active {
    color: var(--c-accent);
    border-left-color: var(--c-accent);
    font-weight: 600;
  }
  .toc-h3 a {
    padding-left: var(--space-5);
    font-size: var(--fs-xs);
  }

  /* 모바일 접이식 목차: 좁은 화면(사이드 목차 숨김 구간)에서만 노출 */
  .mobile-toc {
    display: none;
    margin: 0 0 var(--space-6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
    padding: var(--space-2) var(--space-4);
  }
  .mobile-toc > summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
    font-weight: 700;
    font-size: var(--fs-sm);
    padding: var(--space-2) 0;
    list-style: none;
    user-select: none;
  }
  /* 기본 삼각형 마커 제거(Safari) */
  .mobile-toc > summary::-webkit-details-marker {
    display: none;
  }
  /* 커스텀 chevron: 접힘=오른쪽(▶), 펼침=아래(▼) */
  .mobile-toc > summary::before {
    content: "";
    flex-shrink: 0;
    width: 0.5em;
    height: 0.5em;
    margin-left: 0.1em;
    border-right: 2px solid var(--c-muted);
    border-bottom: 2px solid var(--c-muted);
    transform: rotate(-45deg);
    transition: transform 0.18s ease;
  }
  .mobile-toc[open] > summary::before {
    transform: rotate(45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-toc > summary::before {
      transition: none;
    }
  }
  /* 펼쳤을 때: 제목과 목록 사이 구분선 + 여백 */
  .mobile-toc[open] > summary {
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--c-border);
  }
  .mobile-toc .toc {
    padding-bottom: var(--space-2);
  }
  /* 모바일 목차 항목: 손가락 탭이 편하도록 세로 여백을 넉넉히 */
  .mobile-toc .toc a {
    padding-top: 0.4em;
    padding-bottom: 0.4em;
  }
  .mobile-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 980px) {
    .mobile-toc {
      display: block;
    }
  }

  /* ── 본문 프로즈 타이포그래피 ── */
  .post-header h1 {
    font-size: clamp(1.7rem, 4.5vw, var(--fs-3xl));
  }
  /* 앵커 점프 오프셋은 전역 html{scroll-padding-top}(헤더 높이 기준)이 담당한다.
     여기서 scroll-margin을 또 주면 이중으로 밀려 과하게 내려가므로 두지 않는다. */
  /* 헤딩 앵커(#): 호버 시 노출 */
  .prose :global(.heading-anchor) {
    margin-left: 0.4em;
    color: var(--c-muted);
    font-weight: 400;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.12s ease, color 0.12s ease;
  }
  .prose :global(h2:hover) :global(.heading-anchor),
  .prose :global(h3:hover) :global(.heading-anchor),
  .prose :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }
  .prose :global(.heading-anchor:hover) {
    color: var(--c-accent);
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--c-muted);
    font-size: var(--fs-sm);
    /* 실제로 칠하는 카테고리 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --hue-on: var(--hue, var(--c-accent));
  }
  :global(:root[data-theme="dark"]) .meta {
    --hue-on: color-mix(in srgb, var(--hue, var(--c-accent)) 58%, white);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .meta {
      --hue-on: color-mix(in srgb, var(--hue, var(--c-accent)) 58%, white);
    }
  }
  .tags {
    display: inline-flex;
    gap: var(--space-2);
    margin-left: var(--space-2);
  }
  /* 카테고리 pill — 카드뷰의 섹션 색과 같은 hue로 채운다(태그 pill과 구분). */
  .category {
    display: inline-block;
    padding: 0.2em 0.75em;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--hue-on) 14%, transparent);
    color: var(--hue-on);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.6;
    white-space: nowrap;
  }
  .category:hover {
    background: color-mix(in srgb, var(--hue-on) 22%, transparent);
    text-decoration: none;
  }

  /* 링크 복사 버튼 */
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-left: auto;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    color: var(--c-muted);
    font: inherit;
    font-size: var(--fs-xs);
    cursor: pointer;
  }
  .share-btn:hover {
    background: var(--c-accent-soft);
    color: var(--c-accent);
    border-color: var(--c-accent);
  }
  .share-btn.copied {
    background: var(--c-accent-soft);
    color: var(--c-accent);
    border-color: var(--c-accent);
  }
  .share-icon {
    flex-shrink: 0;
  }

  .prose :global(h2) {
    margin-top: var(--space-8);
    padding-top: var(--space-2);
  }
  .prose :global(h3) {
    margin-top: var(--space-6);
  }
  .prose :global(p),
  .prose :global(li) {
    line-height: var(--lh-normal);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
    margin: 0 0 var(--space-4);
  }
  .prose :global(li) {
    margin: var(--space-1) 0;
  }
  .prose :global(li)::marker {
    color: var(--c-accent);
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* 외부 링크 표시 */
  .prose :global(a[href^="http"])::after {
    content: "↗";
    display: inline-block;
    margin-left: 0.15em;
    font-size: 0.8em;
    vertical-align: baseline;
    color: var(--c-muted);
    text-decoration: none;
  }
