---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { tagHref } from "../../lib/tags.ts";
import { fmtDateTime } from "../../lib/date.ts";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

type Entry = CollectionEntry<"blog">;
interface Props {
  post: Entry;
  newer: Entry | null;
  older: Entry | null;
}

const { post, newer, older } = Astro.props as Props;
const { Content, headings } = await render(post);

// 좌측 사이드바용 전체 글 목록(최신순)
const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 우측 목차: 본문의 h2/h3만 사용 (h1은 제목이라 제외)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

// 좌측 사이드바용 본문 발췌(1~2줄). 설명이 있으면 우선, 없으면 본문에서 추출.
function excerpt(e: Entry): string {
  const desc = e.data.description?.trim();
  const raw =
    desc && desc.length > 0
      ? desc
      : (e.body ?? "").replace(/[`#>*_~\[\]()|-]/g, " ").replace(/\s+/g, " ").trim();
  return raw.slice(0, 100);
}

// 대략적인 읽기 시간: 한국어 ~500자/분 기준
const readingMin = Math.max(1, Math.round((post.body?.length ?? 0) / 500));
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <div class="article-shell">
    <aside class="side side-left" aria-label="글 목록">
      <a class="side-title side-title-link" href={`${base}/blog/`}>글 목록 →</a>
      <ul class="postlist">
        {
          allPosts.map((p) => (
            <li>
              <a
                href={href(p.id)}
                class:list={["postlist-link", { current: p.id === post.id }]}
                aria-current={p.id === post.id ? "page" : undefined}
              >
                <span class="postlist-date">{fmtDateTime(p.data.pubDate)}</span>
                <span class="postlist-title">{p.data.title}</span>
                <span class="postlist-excerpt">{excerpt(p)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="reading">
      <article class="prose">
        <header class="post-header">
          <h1>{post.data.title}</h1>
          <div class="meta">
            <span>{fmtDateTime(post.data.pubDate)}</span>
            <span aria-hidden="true">·</span>
            <span>{readingMin}분 읽기</span>
            {post.data.tags.length > 0 && (
              <span class="tags">
                {post.data.tags.map((t) => <a class="pill" href={tagHref(base, t)}>{t}</a>)}
              </span>
            )}
          </div>
        </header>
        <hr />
        <Content />
      </article>

      {
        (older || newer) && (
          <nav class="postnav">
            {older ? (
              <a class="postnav-item" href={href(older.id)}>
                <span class="postnav-label">← 이전 글</span>
                <span class="postnav-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer ? (
              <a class="postnav-item postnav-next" href={href(newer.id)}>
                <span class="postnav-label">다음 글 →</span>
                <span class="postnav-title">{newer.data.title}</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </div>

    {
      toc.length > 0 && (
        <aside class="side side-toc" aria-label="목차">
          <p class="side-title">목차</p>
          <nav class="toc">
            <ul>
              {toc.map((h) => (
                <li class:list={[`toc-h${h.depth}`]}>
                  <a href={`#${h.slug}`} data-slug={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // 스크롤 스파이: 현재 화면 상단에 있는 섹션을 목차에서 강조.
  // View Transitions로 다른 글로 이동해도 astro:page-load 마다 다시 초기화한다.
  function initScrollSpy() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc a[data-slug]"),
    );
    if (!links.length) return;
    const bySlug = new Map(links.map((a) => [a.dataset.slug, a]));
    const headings = document.querySelectorAll<HTMLElement>(
      ".prose h2[id], .prose h3[id]",
    );
    let current: HTMLAnchorElement | null = null;
    const setActive = (el: HTMLAnchorElement | undefined) => {
      if (!el || el === current) return;
      current?.classList.remove("active");
      el.classList.add("active");
      current = el;
    };
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive(bySlug.get(e.target.id));
        }
      },
      { rootMargin: "0px 0px -75% 0px", threshold: 0 },
    );
    headings.forEach((h) => obs.observe(h));
  }
  document.addEventListener("astro:page-load", initScrollSpy);
</script>

<style>
  /*
   * 3단 셸: [글 목록] [본문 720] [목차]
   * 본문은 항상 읽기 폭(720)으로 고정, 사이드바가 남는 폭을 채워 헤더와 정렬.
   * 넓은 화면=3단 → 태블릿=본문+목차 2단 → 좁은 화면=본문 단독(720 중앙).
   */
  .article-shell {
    display: grid;
    grid-template-columns:
      minmax(180px, 1fr)
      minmax(0, var(--content-width))
      minmax(180px, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .reading {
    min-width: 0;
    max-width: var(--content-width);
    margin: 0 auto;
    width: 100%;
  }

  /* ── 사이드바 공통 ── */
  .side {
    position: sticky;
    top: var(--space-5);
    align-self: start;
    max-height: calc(100vh - var(--space-8));
    overflow-y: auto;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .side-title {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 var(--space-3);
  }
  a.side-title-link:hover {
    color: var(--c-accent);
    text-decoration: none;
  }
  .side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── 좌: 글 목록 ── */
  .postlist li {
    margin-bottom: var(--space-2);
  }
  .postlist-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--c-muted);
    border-left: 2px solid transparent;
  }
  .postlist-link:hover {
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
  }
  .postlist-link.current {
    background: var(--c-accent-soft);
    border-left-color: var(--c-accent);
    color: var(--c-text);
  }
  .postlist-date {
    display: block;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    margin-bottom: var(--space-1);
  }
  .postlist-title {
    display: block;
    font-weight: 600;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .postlist-link.current .postlist-title {
    color: var(--c-accent);
  }
  .postlist-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: var(--space-2);
    font-size: var(--fs-xs);
    line-height: var(--lh-snug);
    color: var(--c-muted);
  }

  /* ── 우: 목차 ── */
  .toc a {
    display: block;
    padding: 0.25em var(--space-3);
    color: var(--c-muted);
    border-left: 2px solid var(--c-border);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--c-text);
  }
  .toc a.active {
    color: var(--c-accent);
    border-left-color: var(--c-accent);
    font-weight: 600;
  }
  .toc-h3 a {
    padding-left: var(--space-5);
    font-size: var(--fs-xs);
  }

  /* ── 본문 프로즈 타이포그래피 ── */
  .post-header h1 {
    font-size: clamp(1.9rem, 5vw, var(--fs-3xl));
  }
  /* 앵커 점프 시 sticky 헤더에 가리지 않도록 여유 */
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: var(--space-5);
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }
  .tags {
    display: inline-flex;
    gap: var(--space-2);
    margin-left: var(--space-2);
  }

  .prose :global(h2) {
    margin-top: var(--space-8);
    padding-top: var(--space-2);
  }
  .prose :global(h3) {
    margin-top: var(--space-6);
  }
  .prose :global(p),
  .prose :global(li) {
    line-height: var(--lh-normal);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
    margin: 0 0 var(--space-4);
  }
  .prose :global(li) {
    margin: var(--space-1) 0;
  }
  .prose :global(li)::marker {
    color: var(--c-accent);
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(blockquote) {
    margin: var(--space-5) 0;
    padding: var(--space-2) var(--space-5);
    border-left: 3px solid var(--c-accent);
    background: var(--c-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--c-muted);
  }
  .prose :global(img) {
    border-radius: var(--radius-md);
    margin: var(--space-5) 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-5) 0;
    font-size: var(--fs-sm);
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--c-border);
    padding: var(--space-2) var(--space-3);
    text-align: left;
  }
  .prose :global(th) {
    background: var(--c-surface);
  }

  /* 이전/다음 글 네비 */
  .postnav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-border);
  }
  .postnav-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    color: var(--c-text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .postnav-item:hover {
    border-color: var(--c-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .postnav-next {
    text-align: right;
  }
  .postnav-label {
    color: var(--c-accent);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  .postnav-title {
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  /* ── 반응형 축소 ── */
  /* 태블릿: 좌측 글 목록을 접고 [본문 | 목차] 2단 */
  @media (max-width: 1199px) {
    .article-shell {
      grid-template-columns: minmax(0, var(--content-width)) minmax(180px, 1fr);
    }
    .side-left {
      display: none;
    }
  }
  /* 좁은 화면: 사이드바 모두 접고 본문 단독(720 중앙). 프레임도 720으로 통일됨. */
  @media (max-width: 980px) {
    .article-shell {
      grid-template-columns: minmax(0, var(--content-width));
      justify-content: center;
    }
    .side {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .postnav {
      grid-template-columns: 1fr;
    }
    .postnav-next {
      text-align: left;
    }
  }
</style>
