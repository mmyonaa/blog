---
// 익명 의견 페이지 (#49). 폼 본체·제출 로직은 FeedbackForm에 있다.
// 평소엔 모달(FeedbackModal)로 띄우지만, 이 페이지는 직접 방문·JS 미동작·
// 네이티브 폴백 제출 후 복귀(?sent=1)의 착지점으로 유지한다.
import Base from "../layouts/Base.astro";
import FeedbackForm from "../components/FeedbackForm.astro";
import { FEEDBACK_ENABLED, DISCUSSIONS_URL } from "../lib/feedback.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base
  title="의견 남기기"
  description="블로그에 대한 의견을 로그인 없이 자유롭게 남겨주세요"
>
  <section class="feedback">
    <h1>의견 남기기</h1>
    <p class="muted">
      블로그에 대한 의견·제안·오류 제보를 자유롭게 남겨주세요. 이름과 연락처를
      비우면 <strong>완전 익명</strong>으로 전달됩니다. 특정 글에 대한 의견은 그
      글 하단의 댓글도 좋습니다.
    </p>

    {
      FEEDBACK_ENABLED ? (
        <FeedbackForm />
      ) : (
        <div class="fallback">
          <p class="muted">
            익명 폼은 준비 중입니다. 그동안 의견은
            <a href={DISCUSSIONS_URL} target="_blank" rel="noopener noreferrer">
              GitHub Discussions
            </a>
            로 남겨주세요 (GitHub 계정 필요).
          </p>
          <a class="pill" href={`${base}/`}>홈으로</a>
        </div>
      )
    }
  </section>
</Base>

<style>
  .feedback {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }
  .feedback h1 {
    font-size: var(--fs-2xl);
    margin-bottom: var(--space-3);
  }
  .feedback > .muted {
    margin-bottom: var(--space-6);
  }
  .fallback .pill {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    padding: 0.35em 0.9em;
  }
</style>
