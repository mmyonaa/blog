---
import { pageWindow } from "../lib/pagination.ts";

interface Props {
  currentPage: number;
  lastPage: number;
  /** 페이지 번호 → URL. 빌드 타임에 평가된다. */
  hrefFor: (n: number) => string;
}
const { currentPage, lastPage, hrefFor } = Astro.props as Props;
const items = pageWindow(currentPage, lastPage);
---

{
  lastPage > 1 && (
    <nav class="pagination" aria-label="페이지 매김">
      {currentPage > 1 ? (
        <>
          <a class="pg-arrow pg-edge" href={hrefFor(1)} aria-label="첫 페이지">
            ⇤
          </a>
          <a class="pg-arrow" href={hrefFor(currentPage - 1)} rel="prev" aria-label="이전 페이지">
            ←
          </a>
        </>
      ) : (
        <>
          <span class="pg-arrow pg-edge disabled" aria-hidden="true">
            ⇤
          </span>
          <span class="pg-arrow disabled" aria-hidden="true">
            ←
          </span>
        </>
      )}

      <ul class="pg-nums">
        {items.map((it) =>
          it === "…" ? (
            <li class="pg-gap" aria-hidden="true">
              …
            </li>
          ) : (
            <li>
              {it === currentPage ? (
                <span class="pg-num current" aria-current="page">
                  {it}
                </span>
              ) : (
                <a class="pg-num" href={hrefFor(it)}>
                  {it}
                </a>
              )}
            </li>
          ),
        )}
      </ul>

      {currentPage < lastPage ? (
        <>
          <a class="pg-arrow" href={hrefFor(currentPage + 1)} rel="next" aria-label="다음 페이지">
            →
          </a>
          <a class="pg-arrow pg-edge" href={hrefFor(lastPage)} aria-label="마지막 페이지">
            ⇥
          </a>
        </>
      ) : (
        <>
          <span class="pg-arrow disabled" aria-hidden="true">
            →
          </span>
          <span class="pg-arrow pg-edge disabled" aria-hidden="true">
            ⇥
          </span>
        </>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-8) 0 var(--space-4);
  }
  .pg-nums {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pg-num,
  .pg-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  a.pg-num:hover,
  a.pg-arrow:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    background: var(--c-accent-soft);
    text-decoration: none;
  }
  .pg-num.current {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: var(--c-accent-contrast);
  }
  .pg-arrow.disabled {
    opacity: 0.4;
    cursor: default;
  }
  /* ⇤/⇥는 ←/→보다 글리프가 작게 그려져, 한 단계 키워야 시각 무게가 맞는다. */
  .pg-edge {
    font-size: 1.15em;
  }
  .pg-gap {
    padding: 0 0.25em;
    color: var(--c-muted);
  }

  /*
   * 좁은 화면에선 처음/마지막 버튼을 숨긴다.
   * 번호 창(pageWindow)이 1과 마지막 페이지를 항상 포함하므로 기능이 사라지진 않고,
   * 최대 11칸이 되는 가로폭만 덜어낸다.
   */
  @media (max-width: 640px) {
    .pagination {
      gap: var(--space-1);
    }
    .pg-edge {
      display: none;
    }
  }

  /* 320px급 화면에선 그래도 넘쳐 페이지에 가로 스크롤이 생긴다. 칸을 좁혀 담는다. */
  @media (max-width: 380px) {
    .pg-num,
    .pg-arrow {
      min-width: 1.9rem;
      padding: 0 0.2em;
    }
  }
</style>
