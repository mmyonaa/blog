---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname.replace(/\/$/, "");
const isHome = pathname === base || pathname === "";
const isBlog = pathname.startsWith(`${base}/blog`);
// 분류 허브(/topics/)와 그 상세(/categories/[section]/, /tags/[tag]/) 모두 '분류' 활성.
const isTopics =
  pathname.startsWith(`${base}/topics`) ||
  pathname.startsWith(`${base}/categories`) ||
  pathname.startsWith(`${base}/tags`);
const isArchive = pathname.startsWith(`${base}/archive`);
const isAbout = pathname.startsWith(`${base}/about`);
const searchIndexUrl = `${base}/search-index.json`;
---

<header class="site-header">
  <div class="header-inner">
    <a href={`${base}/`} class="brand">daily.mcp<span class="brand-dot" aria-hidden="true"></span></a>
    <nav class="nav" aria-label="주요 메뉴">
      <a href={`${base}/`} class:list={["pill", { active: isHome }]} aria-current={isHome ? "page" : undefined}>Home</a>
      <a href={`${base}/topics/`} class:list={["pill", { active: isTopics }]} aria-current={isTopics ? "page" : undefined}>Topics</a>
      <a href={`${base}/blog/`} class:list={["pill", { active: isBlog }]} aria-current={isBlog ? "page" : undefined}>Posts</a>
      <a href={`${base}/archive/`} class:list={["pill", { active: isArchive }]} aria-current={isArchive ? "page" : undefined}>Archive</a>
      <a href={`${base}/about/`} class:list={["pill", { active: isAbout }]} aria-current={isAbout ? "page" : undefined}>About</a>
    </nav>
    <div class="header-actions">
      <button type="button" class="pill search-btn" data-search-open aria-haspopup="dialog">
        <svg class="search-icon" viewBox="0 0 20 20" aria-hidden="true" width="15" height="15">
          <path
            d="M9 3.5a5.5 5.5 0 1 0 3.4 9.82l3.64 3.63a1 1 0 0 0 1.42-1.42l-3.63-3.63A5.5 5.5 0 0 0 9 3.5Zm0 2a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Z"
            fill="currentColor"></path>
        </svg>
        <span class="search-label">Search</span>
        <kbd class="search-kbd">/</kbd>
      </button>
      <button type="button" class="pill theme-toggle" data-theme-toggle aria-label="테마 전환">
        <svg class="icon-moon" viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
          <path d="M16 11.5A6 6 0 1 1 8.5 4a5 5 0 0 0 7.5 7.5Z" fill="currentColor"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
          <circle cx="10" cy="10" r="3.4" fill="currentColor"></circle>
          <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M16 4l-1.4 1.4M5.4 14.6 4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- 검색 모달 -->
<div class="search-modal" data-search-index={searchIndexUrl} hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="글 검색">
    <div class="search-field">
      <svg viewBox="0 0 20 20" aria-hidden="true" width="18" height="18" class="search-field-icon">
        <path
          d="M9 3.5a5.5 5.5 0 1 0 3.4 9.82l3.64 3.63a1 1 0 0 0 1.42-1.42l-3.63-3.63A5.5 5.5 0 0 0 9 3.5Zm0 2a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Z"
          fill="currentColor"></path>
      </svg>
      <input
        type="search"
        class="search-input"
        placeholder="글 제목·내용·태그 검색…"
        autocomplete="off"
        spellcheck="false"
        aria-label="검색어"
      />
      <button type="button" class="search-esc" data-search-close aria-label="닫기">Esc</button>
    </div>
    <ul class="search-results" role="listbox" aria-label="검색 결과"></ul>
    <p class="search-status" data-search-status></p>
  </div>
</div>

<style>
  .site-header {
    /* 상시 접근을 위해 상단 고정. 스크롤해도 검색·분류·테마가 늘 손에 닿는다.
       sticky 자체가 스택 컨텍스트를 만들어, 랜딩 히어로의 풀블리드 배경이
       헤더 위로 그려지거나 클릭을 가로채는 것도 함께 막는다(z-index로 재보장). */
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg);
  }
  .header-inner {
    max-width: var(--page-max, var(--content-width));
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .brand {
    font-family: var(--font-mono);
    font-size: var(--fs-base);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--c-text);
  }
  /* 코랄 액센트 점 — 워드마크 로고 마크 */
  .brand-dot {
    display: inline-block;
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.14em;
    border-radius: 50%;
    background: var(--c-accent);
    vertical-align: 0.04em;
  }
  .brand:hover {
    color: var(--c-accent);
    text-decoration: none;
  }
  /* 넓은 화면: 링크 묶음을 오른쪽으로 밀어 액션(검색·테마)과 나란히. */
  .nav {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-left: auto;
  }
  .header-actions {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .nav .pill,
  .header-actions .pill {
    /* 텍스트/아이콘·테두리 유무와 무관하게 모든 헤더 버튼 높이를 통일.
       box-sizing:border-box(전역)라 고정 높이 안에 테두리·패딩이 포함된다. */
    display: inline-flex;
    align-items: center;
    height: 2rem;
    font-size: var(--fs-sm);
  }
  /* 활성 메뉴는 solid 액센트로 — soft 배경만으론 hover와 구분이 약하다 */
  .nav .active,
  .nav a.active:hover {
    background: var(--c-accent);
    color: var(--c-accent-contrast);
    font-weight: 600;
  }

  /* 테마 토글 버튼 */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    color: var(--c-muted);
    cursor: pointer;
    padding: 0.35em 0.6em;
  }
  .theme-toggle:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }
  /* 아이콘 스왑: 기본(라이트)=달, 다크=해 */
  .theme-toggle .icon-sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-toggle .icon-sun {
    display: inline;
  }
  :global(:root[data-theme="dark"]) .theme-toggle .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle .icon-sun {
      display: inline;
    }
    :global(:root:not([data-theme="light"])) .theme-toggle .icon-moon {
      display: none;
    }
  }

  /* 검색 버튼 */
  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    color: var(--c-muted);
    cursor: pointer;
    font: inherit;
    font-size: var(--fs-sm);
  }
  /* 넓은 화면에서만 검색창처럼 넓히고 단축키를 오른쪽 끝으로 민다.
     좁은 화면은 기본(콘텐츠 폭)이라 아이콘만 남아도 넓어지지 않는다. */
  @media (min-width: 641px) {
    .search-btn {
      min-width: 8.5rem;
    }
    .search-btn .search-kbd {
      margin-left: auto;
    }
  }
  .search-btn:hover {
    background: var(--c-accent-soft);
    color: var(--c-accent);
    border-color: var(--c-accent);
  }
  .search-icon {
    flex-shrink: 0;
  }
  .search-kbd {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1;
    padding: 0.15em 0.4em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    color: var(--c-muted);
  }

  /* ── 모바일: 우측 정렬 줄바꿈으로 뭉개지던 걸 2행으로 재배치 ──
     1행 = 브랜드(좌) + 액션(검색·테마, 우), 2행 = 메뉴 링크(전폭 가로 스크롤 스트립).
     링크는 대개 한 줄에 다 들어가고, 좁으면 살짝 밀어 스크롤한다(햄버거 없이 깔끔). */
  @media (max-width: 640px) {
    .header-inner {
      flex-wrap: wrap;
      gap: var(--space-3);
    }
    .brand {
      margin-right: auto; /* 액션을 1행 오른쪽 끝으로 */
    }
    .header-actions {
      order: 2;
    }
    .nav {
      order: 3;
      flex-basis: 100%;
      margin-left: 0;
      /* 아주 좁은 폭(≈340px 이하)에선 5개가 한 줄에 안 들어간다.
         가로 스크롤로 마지막 링크를 잘라내는 대신, 중앙 정렬로 감싸 둘째 줄에
         깔끔히 내린다(잘림·가로 스크롤 없음). */
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-2);
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding: var(--space-3) var(--space-4);
    }
    .nav .pill,
    .header-actions .pill {
      padding: 0.25em 0.6em;
    }
    /* 좁은 화면에선 검색을 아이콘만 */
    .search-label,
    .search-kbd {
      display: none;
    }
  }

  /* ── 검색 모달 ── */
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: var(--space-8) var(--space-4);
  }
  .search-modal[hidden] {
    display: none;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }
  .search-panel {
    position: relative;
    width: 100%;
    max-width: 560px;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    animation: search-in 0.14s ease;
  }
  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .search-panel {
      animation: none;
    }
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4);
    border-bottom: 1px solid var(--c-border);
  }
  .search-field-icon {
    flex-shrink: 0;
    color: var(--c-muted);
  }
  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    color: var(--c-text);
    font: inherit;
    font-size: var(--fs-lg);
    outline: none;
  }
  .search-input::placeholder {
    color: var(--c-muted);
  }
  /* 네이티브 검색 지우기 버튼 숨김(자체 Esc 제공) */
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }
  .search-esc {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    padding: 0.2em 0.5em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-surface);
    cursor: pointer;
  }
  .search-esc:hover {
    color: var(--c-text);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    max-height: min(60vh, 440px);
    overflow-y: auto;
  }
  .search-results:empty {
    display: none;
  }
  .search-results :global(a) {
    display: block;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    color: var(--c-text);
    text-decoration: none;
  }
  .search-results :global(li.selected a),
  .search-results :global(a:hover) {
    background: var(--c-accent-soft);
  }
  .search-results :global(.r-title) {
    font-weight: 700;
    font-size: var(--fs-base);
    display: block;
    margin-bottom: 0.15em;
  }
  .search-results :global(.r-meta) {
    color: var(--c-muted);
    font-size: var(--fs-xs);
    display: block;
  }
  .search-results :global(.r-desc) {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    display: block;
    margin-top: 0.2em;
  }
  .search-results :global(mark) {
    background: transparent;
    color: var(--c-accent);
    font-weight: 700;
  }

  .search-status {
    margin: 0;
    padding: var(--space-4);
    color: var(--c-muted);
    font-size: var(--fs-sm);
    text-align: center;
  }
  .search-status:empty {
    display: none;
  }
</style>

<script>
  // 헤더 검색 모달. View Transitions로 페이지가 바뀌어도 문서 단위 위임으로 유지되도록
  // 전역 핸들러는 한 번만 등록하고, 요소는 매번 새로 조회한다.
  interface SearchItem {
    title: string;
    description: string;
    tags: string[];
    date: string;
    url: string;
    text: string;
  }

  if (!(window as any).__searchBound) {
    (window as any).__searchBound = true;

    let indexPromise: Promise<SearchItem[]> | null = null;
    let selected = 0;

    const modal = () =>
      document.querySelector<HTMLElement>(".search-modal");
    const input = () =>
      document.querySelector<HTMLInputElement>(".search-input");
    const resultsEl = () =>
      document.querySelector<HTMLElement>(".search-results");
    const statusEl = () =>
      document.querySelector<HTMLElement>("[data-search-status]");

    const loadIndex = (url: string) => {
      if (!indexPromise) indexPromise = fetch(url).then((r) => r.json());
      return indexPromise;
    };

    const isOpen = () => {
      const m = modal();
      return !!m && !m.hasAttribute("hidden");
    };

    const open = () => {
      const m = modal();
      if (!m) return;
      m.removeAttribute("hidden");
      document.body.style.overflow = "hidden";
      loadIndex(m.dataset.searchIndex || "");
      const i = input();
      if (i) {
        i.value = "";
        i.focus();
      }
      render("");
    };

    const close = () => {
      const m = modal();
      if (!m) return;
      m.setAttribute("hidden", "");
      document.body.style.overflow = "";
    };

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"]/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string,
      );

    const highlight = (text: string, q: string) => {
      const esc = escapeHtml(text);
      if (!q) return esc;
      const i = text.toLowerCase().indexOf(q);
      if (i < 0) return esc;
      const before = escapeHtml(text.slice(0, i));
      const hit = escapeHtml(text.slice(i, i + q.length));
      const after = escapeHtml(text.slice(i + q.length));
      return `${before}<mark>${hit}</mark>${after}`;
    };

    const snippet = (text: string, q: string) => {
      const i = text.toLowerCase().indexOf(q);
      if (i < 0) return "";
      const start = Math.max(0, i - 30);
      return (start > 0 ? "…" : "") + text.slice(start, i + q.length + 50);
    };

    async function render(raw: string) {
      const m = modal();
      if (!m) return;
      const data = await loadIndex(m.dataset.searchIndex || "");
      const q = raw.trim().toLowerCase();
      const rEl = resultsEl();
      const sEl = statusEl();
      if (!rEl || !sEl) return;

      if (!q) {
        rEl.innerHTML = "";
        sEl.textContent = "제목·내용·태그로 글을 검색하세요.";
        return;
      }

      const scored = data
        .map((p) => {
          const t = p.title.toLowerCase();
          const d = p.description.toLowerCase();
          const tags = p.tags.join(" ").toLowerCase();
          const txt = p.text.toLowerCase();
          let score = 0;
          if (t.includes(q)) score += 10;
          if (tags.includes(q)) score += 5;
          if (d.includes(q)) score += 3;
          if (txt.includes(q)) score += 1;
          return { p, score };
        })
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);

      selected = 0;
      if (scored.length === 0) {
        rEl.innerHTML = "";
        sEl.textContent = "검색 결과가 없습니다.";
        return;
      }
      sEl.textContent = "";
      rEl.innerHTML = scored
        .map(({ p }, idx) => {
          const desc = p.description
            ? highlight(p.description, q)
            : escapeHtml(snippet(p.text, q));
          const tags = p.tags.map((t) => `#${escapeHtml(t)}`).join(" ");
          return `<li role="option" class="${idx === 0 ? "selected" : ""}">
            <a href="${p.url}">
              <span class="r-title">${highlight(p.title, q)}</span>
              <span class="r-meta">${p.date}${tags ? " · " + tags : ""}</span>
              ${desc ? `<span class="r-desc">${desc}</span>` : ""}
            </a>
          </li>`;
        })
        .join("");
    }

    const move = (dir: number) => {
      const items = resultsEl()?.querySelectorAll("li");
      if (!items || !items.length) return;
      items[selected]?.classList.remove("selected");
      selected = (selected + dir + items.length) % items.length;
      const cur = items[selected];
      cur?.classList.add("selected");
      cur?.scrollIntoView({ block: "nearest" });
    };

    const activate = () => {
      const link = resultsEl()?.querySelectorAll("li")[selected]?.querySelector("a");
      if (link) (link as HTMLAnchorElement).click();
    };

    // ── 전역 위임 핸들러(한 번만 등록) ──
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("[data-search-open]")) {
        e.preventDefault();
        open();
      } else if (target.closest("[data-search-close]")) {
        close();
      } else if (isOpen() && target.closest(".search-results a")) {
        // 결과 링크 클릭 → 이동하며 닫기
        close();
      }
    });

    document.addEventListener("input", (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains("search-input")) {
        render((target as HTMLInputElement).value);
      }
    });

    document.addEventListener("keydown", (e) => {
      // "/" 또는 ⌘K/Ctrl+K 로 열기
      const tag = (e.target as HTMLElement)?.tagName;
      const typing = tag === "INPUT" || tag === "TEXTAREA";
      if (!isOpen()) {
        if ((e.key === "/" && !typing) || (e.key.toLowerCase() === "k" && (e.metaKey || e.ctrlKey))) {
          e.preventDefault();
          open();
        }
        return;
      }
      // 열린 상태
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        activate();
      } else if (e.key === "Tab") {
        // 포커스 트랩: 패널 안에서만 순환
        const panel = document.querySelector<HTMLElement>(".search-panel");
        if (!panel) return;
        const focusables = panel.querySelectorAll<HTMLElement>(
          'a[href], button, input, [tabindex]:not([tabindex="-1"])',
        );
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement as HTMLElement;
        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
