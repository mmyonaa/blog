---
import { getCollection } from "astro:content";
import { FEEDBACK_ENABLED, FEEDBACK_URL, DISCUSSIONS_URL } from "../lib/feedback.ts";
import { sectionOf } from "../lib/sections.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/mmyonaa/mcp";
const year = new Date().getFullYear();

// 사이트 규모 — 빌드 타임에 실제 글에서 센다(하드코딩 금지).
const posts = await getCollection("blog");
const postCount = posts.length;
const sectionCount = new Set(posts.map(sectionOf)).size;

// 둘러보기 컬럼 — 헤더 내비게이션과 같은 진입점.
// 카테고리는 낱개로 나열하지 않고 '분류' 허브(/topics/) 하나로 접는다.
// 섹션이 늘어도 푸터는 그대로고, 상세는 허브가 담당한다.
const browse = [
  { label: "홈", href: `${base}/` },
  { label: "분류", href: `${base}/topics/` },
  { label: "글 전체", href: `${base}/blog/` },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- 브랜드 블록 -->
      <div class="footer-brand">
        <a href={`${base}/`} class="footer-word">blog</a>
        <p class="footer-tag">
          MCP 서버를 직접 만들며 매일 한 편씩 자동 발행하는 학습 블로그.
          만드는 과정과 배운 것을 그대로 기록합니다.
        </p>
        <div class="footer-stats">
          <span class="footer-badge">매일 자동 발행</span>
          <span class="footer-stat"><b>{postCount}</b> 편</span>
          <span class="footer-stat"><b>{sectionCount}</b> 카테고리</span>
        </div>
        <div class="footer-social">
          <a href={repo} target="_blank" rel="noopener" aria-label="GitHub 저장소">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
          </a>
          <a href={`${base}/rss.xml`} aria-label="RSS 피드">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M3.429 12.571a1.714 1.714 0 1 1-3.429 0 1.714 1.714 0 0 1 3.429 0ZM0 6.286v2.457c1.95 0 3.82.775 5.2 2.155A7.35 7.35 0 0 1 7.357 16h2.457C9.814 10.58 5.42 6.186 0 6.286Zm0-4.06v2.46C6.79 4.686 12.314 10.21 12.314 17h2.46C14.774 8.85 8.15 2.226 0 2.226Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- 둘러보기 -->
      <nav class="footer-col" aria-label="둘러보기">
        <h2 class="footer-head">둘러보기</h2>
        <ul>
          {
            browse.map((b) => (
              <li>
                <a href={b.href}>{b.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- 프로젝트 -->
      <nav class="footer-col" aria-label="프로젝트">
        <h2 class="footer-head">프로젝트</h2>
        <ul>
          <li><a href={repo} target="_blank" rel="noopener">소스 코드</a></li>
          <li>
            <a href={DISCUSSIONS_URL} target="_blank" rel="noopener">토론</a>
          </li>
          <li>
            {
              FEEDBACK_ENABLED ? (
                <button type="button" class="linklike" data-feedback-open>
                  의견 남기기
                </button>
              ) : (
                <a href={FEEDBACK_URL} target="_blank" rel="noopener">
                  의견 남기기
                </a>
              )
            }
          </li>
        </ul>
      </nav>
    </div>

    <!-- 하단 바 -->
    <div class="footer-bottom">
      <p class="muted">© {year} blog · MCP로 쓰고 발행합니다</p>
      <p class="muted footer-built">
        Astro로 빌드 · <a href={repo} target="_blank" rel="noopener">GitHub</a>에 공개
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-border);
    margin-top: var(--space-10);
    background: var(--c-surface);
  }
  .footer-inner {
    max-width: var(--page-max, var(--content-width));
    margin: 0 auto;
    padding: var(--space-8) var(--space-5) var(--space-5);
  }

  /* 브랜드 넓게 + 메뉴 2열. 좁아지면 접힌다. */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr repeat(2, 1fr);
    gap: var(--space-6) var(--space-5);
  }

  .footer-word {
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--c-text);
  }
  .footer-word:hover {
    color: var(--c-accent);
    text-decoration: none;
  }
  .footer-tag {
    margin: var(--space-3) 0 var(--space-4);
    max-width: 34ch;
    color: var(--c-muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  /* 운영 방식·규모 배지 — 이 블로그의 특이점(자동 발행)과 규모를 한눈에. */
  .footer-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .footer-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25em 0.6em;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    background: var(--c-accent-soft);
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .footer-stat {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    white-space: nowrap;
  }
  .footer-stat b {
    color: var(--c-text);
    font-weight: 700;
  }

  .footer-social {
    display: flex;
    gap: var(--space-2);
  }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    color: var(--c-muted);
  }
  .footer-social a:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  .footer-head {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-col a,
  .linklike {
    color: var(--c-text);
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .footer-col a:hover,
  .linklike:hover {
    color: var(--c-accent);
    text-decoration: underline;
  }

  /* '의견 남기기'는 모달을 여는 버튼이지만 다른 링크와 똑같이 보이게 한다. */
  .linklike {
    font: inherit;
    font-size: var(--fs-sm);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .footer-bottom {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--c-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .footer-bottom p {
    margin: 0;
    font-size: var(--fs-xs);
  }
  .footer-built a {
    color: var(--c-muted);
    text-decoration: underline;
  }
  .footer-built a:hover {
    color: var(--c-accent);
  }

  /* 태블릿: 브랜드 한 줄, 메뉴 2열 */
  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  /* 모바일: 여백만 줄인다(2열 유지) */
  @media (max-width: 480px) {
    .footer-inner {
      padding: var(--space-6) var(--space-4) var(--space-5);
    }
  }
</style>
