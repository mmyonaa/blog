---
import { FEEDBACK_ENABLED, DISCUSSIONS_URL } from "../lib/feedback.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/mmyonaa/mcp";
const profile = "https://github.com/mmyonaa";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="muted" style="margin:0;">
      MCP로 쓰고 발행하는 블로그 · © {year}
    </p>
    <p class="muted" style="margin:0;">
      <a href={`${base}/`}>홈</a>
      <span aria-hidden="true"> · </span>
      <a href={`${base}/rss.xml`}>RSS</a>
      <span aria-hidden="true"> · </span>
      <a href={repo} target="_blank" rel="noopener">GitHub</a>
      <span aria-hidden="true"> · </span>
      <a href={profile} target="_blank" rel="noopener">@mmyonaa</a>
      <span aria-hidden="true"> · </span>
      {
        FEEDBACK_ENABLED ? (
          <button type="button" class="linklike" data-feedback-open>
            의견 남기기
          </button>
        ) : (
          <a href={DISCUSSIONS_URL} target="_blank" rel="noopener">
            의견 남기기
          </a>
        )
      }
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-border);
    margin-top: var(--space-10);
  }
  .footer-inner {
    max-width: var(--page-max, var(--content-width));
    margin: 0 auto;
    padding: var(--space-6) var(--space-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  /* '의견 남기기'는 모달을 여는 버튼이지만 다른 푸터 링크와 똑같이 보이게 한다. */
  .linklike {
    font: inherit;
    color: var(--c-link, var(--c-accent));
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .linklike:hover {
    text-decoration: underline;
  }
</style>
