---
import { FEEDBACK_URL } from "../lib/feedback.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/mmyonaa/mcp";
const profile = "https://github.com/mmyonaa";
const year = new Date().getFullYear();

// 의견 링크는 폼 활성화 시 내부(/feedback/), 아니면 외부(Discussions)로 간다.
// 내부 링크는 같은 탭(View Transitions 유지), 외부만 새 탭으로.
const feedbackExternal = FEEDBACK_URL.startsWith("http");
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="muted" style="margin:0;">
      MCP로 쓰고 발행하는 블로그 · © {year}
    </p>
    <p class="muted" style="margin:0;">
      <a href={`${base}/`}>홈</a>
      <span aria-hidden="true"> · </span>
      <a href={`${base}/rss.xml`}>RSS</a>
      <span aria-hidden="true"> · </span>
      <a href={repo} target="_blank" rel="noopener">GitHub</a>
      <span aria-hidden="true"> · </span>
      <a href={profile} target="_blank" rel="noopener">@mmyonaa</a>
      <span aria-hidden="true"> · </span>
      <a
        href={FEEDBACK_URL}
        target={feedbackExternal ? "_blank" : undefined}
        rel={feedbackExternal ? "noopener" : undefined}
      >의견 남기기</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-border);
    margin-top: var(--space-10);
  }
  .footer-inner {
    max-width: var(--page-max, var(--content-width));
    margin: 0 auto;
    padding: var(--space-6) var(--space-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
