---
// 발행 그래프 — git 네트워크 그래프 스타일. (원래 /archive/ 페이지, 이제 Topics에 임베드)
// 세로축 = 시간(위=최신). 카테고리마다 세로 "트렁크"(색 세로선)가 있고,
// 그 안의 세부영역(area)이 여럿(2편 이상)이면 옆 서브컬럼으로 "가지"가 뻗었다가 트렁크로 복귀한다.
// 후속(follows)은 자식→부모를 잇는 화살표 곡선으로 시간을 거슬러 그린다.
// 좌표는 빌드 타임 확정: 행 높이를 고정해 각 노드의 (x=컬럼, y=시간)을 px로 계산 → 측정 없이 정확한 곡선.
import { getCollection } from "astro:content";
import {
  sectionOf,
  sectionHref,
  hueOf,
  getSectionCounts,
  areaLabel,
} from "../lib/sections.ts";
import { fmtDate } from "../lib/date.ts";
import { charCount, fmtCount } from "../lib/reading.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const lanes = (await getSectionCounts()).map((s) => ({
  id: s.id,
  label: s.label,
  count: s.count,
  hue: hueOf(s.id),
}));
const secOf = new Map(posts.map((p) => [p.id, sectionOf(p)]));

// ── 그래프 좌표계(px) ─────────────────────────────────────────────────────────
const SUBCOL_W = 20; // 컬럼(트렁크·가지) 간격
const RAIL_PAD = 12; // 레일 좌우 여백
const ROW_H = 46; // 글 행 높이(고정 → 노드 y)
const MONTH_H = 30; // 월 마커 행 높이
const NODE_R = 4.5;
const colX = (i: number) => RAIL_PAD + i * SUBCOL_W + SUBCOL_W / 2;

// 부드러운 세로 방향 곡선(깃 네트워크 그래프 풍) — 컬럼을 바꿀 때의 가지/후속 연결선.
const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const my = (y1 + y2) / 2;
  return `M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}`;
};

// ── 레이아웃 계산 — 글 부분집합을 받아 그래프 한 벌(컬럼·행·선)을 만든다.
//    카테고리 필터를 '흐림'이 아니라 '재구성'으로 처리하기 위해, 전체 + 카테고리별
//    변형을 빌드 타임에 모두 계산해 두고(SSG 원칙 유지) 클라이언트는 교체만 한다. ──
type PostRow = {
  type: "post";
  id: string;
  title: string;
  sec: string;
  hue: string;
  area: string;
  date: string;
  chars: number;
  h: number;
  cx: number;
  cy: number;
};
type MonthRow = { type: "month"; label: string; h: number };
type Row = PostRow | MonthRow;

function layout(subset: typeof posts, opts: { branches?: boolean } = {}) {
  const useBranches = opts.branches !== false;
  // ── 컬럼 배치: 카테고리 트렁크 + area 가지(같은 area 2편 이상일 때만 서브컬럼) ──
  //    branches:false면 가지를 접고 트렁크만 쓴다 — 모바일용 슬림 레일
  //    (전체 324px → 124px)로, 좁은 폭에서도 연결고리를 그릴 수 있게 한다.
  type Branch = { area: string; col: number };
  type Cat = { id: string; hue: string; trunk: number; branches: Branch[] };
  const postCol = new Map<string, number>(); // post.id → 컬럼 인덱스
  const cats: Cat[] = [];
  let cursor = 0;
  for (const lane of lanes) {
    const cps = subset.filter((p) => secOf.get(p.id) === lane.id); // 최신순
    if (cps.length === 0) continue; // 부분집합에 없는 카테고리는 컬럼을 만들지 않는다
    const areaN = new Map<string, number>();
    for (const p of cps)
      if (p.data.area) areaN.set(p.data.area, (areaN.get(p.data.area) ?? 0) + 1);
    // 가지가 될 area: 2편 이상. 처음 등장(최신) 순서로 컬럼 부여.
    const order: string[] = [];
    if (useBranches)
      for (const p of cps) {
        const a = p.data.area;
        if (a && (areaN.get(a) ?? 0) >= 2 && !order.includes(a)) order.push(a);
      }
    const trunk = cursor;
    const branchCol = new Map(order.map((a, i) => [a, cursor + 1 + i]));
    for (const p of cps) {
      const a = p.data.area;
      postCol.set(p.id, a && branchCol.has(a) ? branchCol.get(a)! : trunk);
    }
    cats.push({
      id: lane.id,
      hue: lane.hue,
      trunk,
      branches: order.map((a) => ({ area: a, col: branchCol.get(a)! })),
    });
    cursor += 1 + order.length;
  }
  const railW = RAIL_PAD * 2 + cursor * SUBCOL_W; // 레일(=텍스트 들여쓰기) 폭

  // ── 표시 행 + y 좌표. 월이 바뀌면 마커 행을 끼운다 ──
  const rows: Row[] = [];
  const cyById = new Map<string, number>();
  let y = 0;
  let prevYM = "";
  let prevYear = "";
  for (const p of subset) {
    const [yr, m, d] = fmtDate(p.data.pubDate).split("-");
    const ym = `${yr}-${m}`;
    if (ym !== prevYM) {
      const label = yr !== prevYear ? `${yr}년 ${Number(m)}월` : `${Number(m)}월`;
      rows.push({ type: "month", label, h: MONTH_H });
      y += MONTH_H;
      prevYM = ym;
      prevYear = yr;
    }
    const sec = secOf.get(p.id)!;
    const cx = colX(postCol.get(p.id)!);
    const cy = y + ROW_H / 2;
    cyById.set(p.id, cy);
    rows.push({
      type: "post",
      id: p.id,
      title: p.data.title,
      sec,
      hue: hueOf(sec),
      area: areaLabel(p.data.area),
      date: `${Number(m)}/${Number(d)}`,
      chars: charCount(p.body),
      h: ROW_H,
      cx,
      cy,
    });
    y += ROW_H;
  }
  const totalH = y;

  // ── 세로선(각 컬럼: 그 컬럼 글들의 최신~오래된 구간) ──
  const colYs = new Map<number, number[]>();
  for (const p of subset) {
    const c = postCol.get(p.id)!;
    (colYs.get(c) ?? colYs.set(c, []).get(c)!).push(cyById.get(p.id)!);
  }
  const vlines = cats.flatMap((cat) =>
    [cat.trunk, ...cat.branches.map((b) => b.col)]
      .map((c) => {
        const ys = colYs.get(c);
        return ys && ys.length
          ? { x: colX(c), y1: Math.min(...ys), y2: Math.max(...ys), hue: cat.hue, sec: cat.id }
          : null;
      })
      .filter((v): v is NonNullable<typeof v> => v !== null),
  );

  // ── 가지 bud/merge: 각 area 가지가 트렁크에서 갈라져 나오고(위) 되돌아온다(아래) ──
  type GLink = { d: string; hue: string; kind: "branch" | "follows"; cross?: boolean; sec: string };
  const links: GLink[] = [];
  for (const cat of cats) {
    const trunkX = colX(cat.trunk);
    for (const b of cat.branches) {
      const ys = colYs.get(b.col)!;
      const top = Math.min(...ys); // 가지의 최신 노드
      const bot = Math.max(...ys); // 가지의 오래된 노드
      const bx = colX(b.col);
      // 갈라짐: 트렁크의 조금 위 지점 → 가지 최신 노드
      links.push({ d: curve(trunkX, Math.max(0, top - ROW_H), bx, top), hue: cat.hue, kind: "branch", sec: cat.id });
      // 복귀: 가지 오래된 노드 → 트렁크의 조금 아래 지점
      links.push({ d: curve(bx, bot, trunkX, Math.min(totalH, bot + ROW_H)), hue: cat.hue, kind: "branch", sec: cat.id });
    }
  }

  // ── 후속(follows): 자식→부모. 부분집합 안에 양끝이 다 있을 때만 그린다 ──
  const followsLinks: { d: string; hue: string; cross: boolean; a: string; b: string; secA: string; secB: string }[] = [];
  for (const p of subset) {
    const par = p.data.follows;
    if (!par || !cyById.has(par)) continue;
    const ca = postCol.get(p.id)!;
    const cb = postCol.get(par)!;
    const secA = secOf.get(p.id)!;
    const secB = secOf.get(par)!;
    const hue = hueOf(secA);
    const cross = secA !== secB;
    const d = curve(colX(ca), cyById.get(p.id)!, colX(cb), cyById.get(par)!);
    followsLinks.push({ d, hue, cross, a: p.id, b: par, secA, secB });
  }

  return { railW, totalH, rows, vlines, links, followsLinks, count: subset.length };
}

// 전체 + 카테고리별 변형. key는 범례의 data-sec과 짝.
// d = 데스크톱, m = 모바일 레일. 행 순서·y는 같고 x·레일 폭만 다르다.
// 모바일에서 '전체'는 가지 포함 레일이 324px라 불가능해 트렁크만 접어 보여주고(124px),
// 카테고리 변형은 레일이 좁아(44~144px) PC처럼 가지까지 그대로 편다.
const variants = [
  { key: "all", d: layout(posts), m: layout(posts, { branches: false }) },
  ...lanes.map((l) => {
    const d = layout(posts.filter((p) => secOf.get(p.id) === l.id));
    return { key: l.id, d, m: d };
  }),
];
---

<!-- 범례 -->
<div class="legend">
  <div class="lg-group">
    {
      lanes.map((l) => (
        <a
          class="lg"
          href={sectionHref(base, l.id)}
          data-sec={l.id}
          style={`--hue: ${l.hue}`}
        >
          <span class="lg-dot" />
          <span class="lg-name">{l.label}</span>
          <span class="lg-count">{l.count}</span>
        </a>
      ))
    }
    <button type="button" class="lg-reset" hidden>필터 해제 <span aria-hidden="true">✕</span></button>
  </div>
  <div class="lg-edges" aria-hidden="true">
    <span class="lg-edge"><svg width="24" height="12"><path d="M2 2 v4 q0 4 4 4 h12" class="k-branch" /></svg>세부 갈래</span>
    <span class="lg-edge"><svg width="26" height="12"><path d="M2 6 H20" class="k-follows" marker-end="url(#lgarw)" /><defs><marker id="lgarw" markerWidth="6" markerHeight="6" refX="4.5" refY="3" orient="auto"><path d="M0 0 L5 3 L0 6 Z" fill="context-stroke" /></marker></defs></svg>후속</span>
  </div>
</div>

{
  posts.length === 0 ? (
    <p class="muted">아직 발행된 글이 없습니다.</p>
  ) : (
    variants.map((v) => (
      <div
        class="graph"
        data-variant={v.key}
        data-capped={v.d.rows.length > 15 ? "" : undefined}
        hidden={v.key !== "all"}
        style={`--rail-w: ${v.d.railW}px; --rail-w-m: ${v.m.railW}px`}
      >
        {/* gbody: 레일+행 묶음. 모바일 cap 시 SVG가 접힌 행 아래로
            튀어나오지 않게 여기서 클리핑한다(버튼은 바깥). */}
        <div class="gbody">
          {/* 데스크톱 레일: 트렁크 + area 가지 */}
          <svg
            class="wire"
            width={v.d.railW}
            height={v.d.totalH}
            viewBox={`0 0 ${v.d.railW} ${v.d.totalH}`}
            aria-hidden="true"
          >
            <defs>
              <marker
                id={`arw-${v.key}`}
                markerWidth="6.5"
                markerHeight="6.5"
                refX="5"
                refY="3"
                orient="auto"
              >
                <path d="M0 0 L5.5 3 L0 6 Z" fill="context-stroke" />
              </marker>
            </defs>

            {/* 세로 트렁크·가지 선 */}
            {v.d.vlines.map((l) => (
              <line
                class="vline"
                x1={l.x}
                y1={l.y1}
                x2={l.x}
                y2={l.y2}
                data-sec={l.sec}
                style={`--hue: ${l.hue}`}
              />
            ))}

            {/* 가지 갈라짐/복귀 곡선 */}
            {v.d.links.map((l) => (
              <path class="branch" d={l.d} data-sec={l.sec} style={`--hue: ${l.hue}`} />
            ))}

            {/* 후속 곡선(화살표) */}
            {v.d.followsLinks.map((l) => (
              <path
                class:list={["follows", { cross: l.cross }]}
                d={l.d}
                data-a={l.a}
                data-b={l.b}
                data-sec-a={l.secA}
                data-sec-b={l.secB}
                style={`--hue: ${l.hue}`}
                marker-end={`url(#arw-${v.key})`}
              />
            ))}

            {/* 노드 */}
            {v.d.rows.map(
              (r) =>
                r.type === "post" && (
                  <circle
                    class="node"
                    cx={r.cx}
                    cy={r.cy}
                    r={NODE_R}
                    data-id={r.id}
                    data-sec={r.sec}
                    style={`--hue: ${r.hue}`}
                  />
                ),
            )}
          </svg>

          {/* 모바일 레일: 가지를 접은 트렁크만(슬림) — 좁은 폭에서도 연결고리 유지 */}
          <svg
            class="wire wire-m"
            width={v.m.railW}
            height={v.m.totalH}
            viewBox={`0 0 ${v.m.railW} ${v.m.totalH}`}
            aria-hidden="true"
          >
            <defs>
              <marker
                id={`arw-m-${v.key}`}
                markerWidth="6.5"
                markerHeight="6.5"
                refX="5"
                refY="3"
                orient="auto"
              >
                <path d="M0 0 L5.5 3 L0 6 Z" fill="context-stroke" />
              </marker>
            </defs>
            {v.m.vlines.map((l) => (
              <line
                class="vline"
                x1={l.x}
                y1={l.y1}
                x2={l.x}
                y2={l.y2}
                data-sec={l.sec}
                style={`--hue: ${l.hue}`}
              />
            ))}
            {v.m.links.map((l) => (
              <path class="branch" d={l.d} data-sec={l.sec} style={`--hue: ${l.hue}`} />
            ))}
            {v.m.followsLinks.map((l) => (
              <path
                class:list={["follows", { cross: l.cross }]}
                d={l.d}
                data-a={l.a}
                data-b={l.b}
                data-sec-a={l.secA}
                data-sec-b={l.secB}
                style={`--hue: ${l.hue}`}
                marker-end={`url(#arw-m-${v.key})`}
              />
            ))}
            {v.m.rows.map(
              (r) =>
                r.type === "post" && (
                  <circle
                    class="node"
                    cx={r.cx}
                    cy={r.cy}
                    r={NODE_R}
                    data-id={r.id}
                    data-sec={r.sec}
                    style={`--hue: ${r.hue}`}
                  />
                ),
            )}
          </svg>

          {/* 텍스트 행(레일 오른쪽, 높이 고정 → 노드와 y 일치) */}
          <div class="rows">
            {v.d.rows.map((r) =>
              r.type === "month" ? (
                <div class="grow month" style={`height: ${r.h}px`}>
                  <span class="mlabel">{r.label}</span>
                </div>
              ) : (
                <a
                  class="grow post"
                  href={`${base}/blog/${r.id}/`}
                  data-id={r.id}
                  data-sec={r.sec}
                  style={`height: ${r.h}px; --hue: ${r.hue}`}
                >
                  <span class="ptitle">{r.title}</span>
                  <span class="pmeta">
                    {r.area && <span class="parea">{r.area}</span>}
                    <span class="pdate">{r.date}</span>
                    <span class="pchars">{fmtCount(r.chars)}자</span>
                  </span>
                </a>
              ),
            )}
          </div>
        </div>

        {/* 모바일 리스트 모드 전용(CSS로 노출): capped 상태 해제/복원 토글. */}
        {v.d.rows.length > 15 && (
          <button
            class="graph-more"
            type="button"
            aria-expanded="false"
            data-graph-expand
            data-more={`전체 ${v.d.count}편 보기`}
            data-less="접기"
          >
            전체 {v.d.count}편 보기
          </button>
        )}
      </div>
    ))
  )
}

<script>
  // 그래프 변형(전체 + 카테고리별)이 모두 렌더돼 있고, 범례 클릭은 '흐림' 대신
  // 해당 카테고리로 재구성된 그래프로 교체한다. 호버 포커스·모바일 cap은
  // 각 변형에 개별 바인딩. View Transitions 후에도 새 DOM에 다시 붙도록
  // astro:page-load마다 초기화한다(요소가 새것이라 중복 바인딩 없음).
  function initPostGraph() {
    const graphs = [
      ...document.querySelectorAll<HTMLElement>(".graph[data-variant]"),
    ];
    if (!graphs.length) return;

    for (const graph of graphs) {
      // 호버 포커스: 한 글에 올리면 그 글의 후속 사슬(부모·자식)만 남기고 흐린다.
      const flinks = [...graph.querySelectorAll<SVGPathElement>("path.follows")];
      const adj = new Map<string, Set<string>>();
      const link = (x: string, yy: string) => {
        if (!adj.has(x)) adj.set(x, new Set());
        adj.get(x)!.add(yy);
      };
      for (const p of flinks) {
        link(p.dataset.a!, p.dataset.b!);
        link(p.dataset.b!, p.dataset.a!);
      }
      const focus = (id: string) => {
        const near = new Set<string>([id, ...(adj.get(id) ?? [])]);
        graph.classList.add("focused");
        for (const el of graph.querySelectorAll<HTMLElement>("[data-id]"))
          el.classList.toggle("active", near.has(el.dataset.id!));
        for (const p of flinks)
          p.classList.toggle("active", p.dataset.a === id || p.dataset.b === id);
      };
      const clear = () => {
        graph.classList.remove("focused");
        for (const el of graph.querySelectorAll(".active"))
          el.classList.remove("active");
      };
      for (const el of graph.querySelectorAll<HTMLElement>("[data-id]")) {
        const id = el.dataset.id!;
        el.addEventListener("pointerenter", () => focus(id));
        el.addEventListener("pointerleave", clear);
        el.addEventListener("focusin", () => focus(id));
        el.addEventListener("focusout", clear);
      }

      // 모바일 cap: 최근 15행만 기본 노출, 그래프별 버튼으로 전체/접기 토글.
      const moreBtn = graph.querySelector<HTMLButtonElement>("[data-graph-expand]");
      moreBtn?.addEventListener("click", () => {
        const capped = !graph.hasAttribute("data-capped");
        graph.toggleAttribute("data-capped", capped);
        moreBtn.textContent = capped
          ? moreBtn.dataset.more!
          : moreBtn.dataset.less!;
        moreBtn.setAttribute("aria-expanded", String(!capped)); // chevron 방향
      });
    }

    // ── 범례 → 변형 교체. 같은 카테고리를 다시 클릭하면 전체로 복귀. ──
    const legend = document.querySelector<HTMLElement>(".legend");
    if (!legend) return;
    const legendEls = [...legend.querySelectorAll<HTMLElement>(".lg[data-sec]")];
    const resetBtn = legend.querySelector<HTMLButtonElement>(".lg-reset");
    let active = "all";
    const show = (key: string) => {
      active = key;
      for (const g of graphs) g.hidden = g.dataset.variant !== key;
      legend.classList.toggle("filtering", key !== "all");
      if (resetBtn) resetBtn.hidden = key === "all";
      for (const l of legendEls) {
        l.classList.toggle("sel", l.dataset.sec === key);
        l.classList.toggle("off", key !== "all" && l.dataset.sec !== key);
      }
    };
    for (const l of legendEls) {
      l.addEventListener("click", (e) => {
        e.preventDefault(); // 카테고리 페이지로 이동 대신 그래프를 교체
        show(active === l.dataset.sec ? "all" : l.dataset.sec!);
      });
    }
    resetBtn?.addEventListener("click", () => show("all"));
  }
  document.addEventListener("astro:page-load", initPostGraph);

  // Esc = 필터 해제. 문서 레벨이라 모듈에서 한 번만 바인딩(중복 방지),
  // 상태는 DOM(리셋 버튼 노출 여부)에서 읽는다.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const reset = document.querySelector<HTMLButtonElement>(".lg-reset");
    if (reset && !reset.hidden) reset.click();
  });
</script>

