---
// 발행 그래프 — git 네트워크 그래프 스타일. (원래 /archive/ 페이지, 이제 Topics에 임베드)
// 세로축 = 시간(위=최신). 카테고리마다 세로 "트렁크"(색 세로선)가 있고,
// 그 안의 세부영역(area)이 여럿(2편 이상)이면 옆 서브컬럼으로 "가지"가 뻗었다가 트렁크로 복귀한다.
// 후속(follows)은 자식→부모를 잇는 화살표 곡선으로 시간을 거슬러 그린다.
// 좌표는 빌드 타임 확정: 행 높이를 고정해 각 노드의 (x=컬럼, y=시간)을 px로 계산 → 측정 없이 정확한 곡선.
import { getCollection } from "astro:content";
import {
  sectionOf,
  sectionHref,
  hueOf,
  getSectionCounts,
  areaLabel,
} from "../lib/sections.ts";
import { fmtDate } from "../lib/date.ts";
import { charCount, fmtCount } from "../lib/reading.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const lanes = (await getSectionCounts()).map((s) => ({
  id: s.id,
  label: s.label,
  count: s.count,
  hue: hueOf(s.id),
}));
const secOf = new Map(posts.map((p) => [p.id, sectionOf(p)]));

// ── 그래프 좌표계(px) ─────────────────────────────────────────────────────────
const SUBCOL_W = 20; // 컬럼(트렁크·가지) 간격
const RAIL_PAD = 12; // 레일 좌우 여백
const ROW_H = 46; // 글 행 높이(고정 → 노드 y)
const MONTH_H = 30; // 월 마커 행 높이
const NODE_R = 4.5;
const colX = (i: number) => RAIL_PAD + i * SUBCOL_W + SUBCOL_W / 2;

// ── 컬럼 배치: 카테고리 트렁크 + area 가지(같은 area 2편 이상일 때만 서브컬럼) ──
type Branch = { area: string; col: number };
type Cat = { id: string; hue: string; trunk: number; branches: Branch[] };
const postCol = new Map<string, number>(); // post.id → 컬럼 인덱스
const cats: Cat[] = [];
let cursor = 0;
for (const lane of lanes) {
  const cps = posts.filter((p) => secOf.get(p.id) === lane.id); // 최신순
  const areaN = new Map<string, number>();
  for (const p of cps)
    if (p.data.area) areaN.set(p.data.area, (areaN.get(p.data.area) ?? 0) + 1);
  // 가지가 될 area: 2편 이상. 처음 등장(최신) 순서로 컬럼 부여.
  const order: string[] = [];
  for (const p of cps) {
    const a = p.data.area;
    if (a && (areaN.get(a) ?? 0) >= 2 && !order.includes(a)) order.push(a);
  }
  const trunk = cursor;
  const branchCol = new Map(order.map((a, i) => [a, cursor + 1 + i]));
  for (const p of cps) {
    const a = p.data.area;
    postCol.set(p.id, a && branchCol.has(a) ? branchCol.get(a)! : trunk);
  }
  cats.push({
    id: lane.id,
    hue: lane.hue,
    trunk,
    branches: order.map((a) => ({ area: a, col: branchCol.get(a)! })),
  });
  cursor += 1 + order.length;
}
const totalCols = cursor;
const railW = RAIL_PAD * 2 + totalCols * SUBCOL_W; // 레일(=텍스트 들여쓰기) 폭

// ── 표시 행 + y 좌표. 월이 바뀌면 마커 행을 끼운다 ──
type PostRow = {
  type: "post";
  id: string;
  title: string;
  sec: string;
  hue: string;
  area: string;
  date: string;
  chars: number;
  h: number;
  cx: number;
  cy: number;
};
type MonthRow = { type: "month"; label: string; h: number };
type Row = PostRow | MonthRow;

const rows: Row[] = [];
const cyById = new Map<string, number>();
let y = 0;
let prevYM = "";
let prevYear = "";
for (const p of posts) {
  const [yr, m, d] = fmtDate(p.data.pubDate).split("-");
  const ym = `${yr}-${m}`;
  if (ym !== prevYM) {
    const label = yr !== prevYear ? `${yr}년 ${Number(m)}월` : `${Number(m)}월`;
    rows.push({ type: "month", label, h: MONTH_H });
    y += MONTH_H;
    prevYM = ym;
    prevYear = yr;
  }
  const sec = secOf.get(p.id)!;
  const cx = colX(postCol.get(p.id)!);
  const cy = y + ROW_H / 2;
  cyById.set(p.id, cy);
  rows.push({
    type: "post",
    id: p.id,
    title: p.data.title,
    sec,
    hue: hueOf(sec),
    area: areaLabel(p.data.area),
    date: `${Number(m)}/${Number(d)}`,
    chars: charCount(p.body),
    h: ROW_H,
    cx,
    cy,
  });
  y += ROW_H;
}
const totalH = y;

// ── 세로선(각 컬럼: 그 컬럼 글들의 최신~오래된 구간) ──
const colYs = new Map<number, number[]>();
for (const p of posts) {
  const c = postCol.get(p.id)!;
  (colYs.get(c) ?? colYs.set(c, []).get(c)!).push(cyById.get(p.id)!);
}
const vlines = cats.flatMap((cat) =>
  [cat.trunk, ...cat.branches.map((b) => b.col)]
    .map((c) => {
      const ys = colYs.get(c);
      return ys && ys.length
        ? { x: colX(c), y1: Math.min(...ys), y2: Math.max(...ys), hue: cat.hue, sec: cat.id }
        : null;
    })
    .filter((v): v is NonNullable<typeof v> => v !== null),
);

// 부드러운 세로 방향 곡선(깃 네트워크 그래프 풍) — 컬럼을 바꿀 때의 가지/후속 연결선.
const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const my = (y1 + y2) / 2;
  return `M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}`;
};

// ── 가지 bud/merge: 각 area 가지가 트렁크에서 갈라져 나오고(위) 되돌아온다(아래) ──
type GLink = { d: string; hue: string; kind: "branch" | "follows"; cross?: boolean; sec: string };
const links: GLink[] = [];
for (const cat of cats) {
  const trunkX = colX(cat.trunk);
  for (const b of cat.branches) {
    const ys = colYs.get(b.col)!;
    const top = Math.min(...ys); // 가지의 최신 노드
    const bot = Math.max(...ys); // 가지의 오래된 노드
    const bx = colX(b.col);
    // 갈라짐: 트렁크의 조금 위 지점 → 가지 최신 노드
    links.push({ d: curve(trunkX, Math.max(0, top - ROW_H), bx, top), hue: cat.hue, kind: "branch", sec: cat.id });
    // 복귀: 가지 오래된 노드 → 트렁크의 조금 아래 지점
    links.push({ d: curve(bx, bot, trunkX, Math.min(totalH, bot + ROW_H)), hue: cat.hue, kind: "branch", sec: cat.id });
  }
}

// ── 후속(follows): 자식→부모. 컬럼이 다르면 곡선으로(같은 컬럼이면 세로선이 이미 잇는다) ──
const followsLinks: { d: string; hue: string; cross: boolean; a: string; b: string; secA: string; secB: string }[] = [];
for (const p of posts) {
  const par = p.data.follows;
  if (!par || !cyById.has(par)) continue;
  const ca = postCol.get(p.id)!;
  const cb = postCol.get(par)!;
  const secA = secOf.get(p.id)!;
  const secB = secOf.get(par)!;
  const hue = hueOf(secA);
  const cross = secA !== secB;
  const d = curve(colX(ca), cyById.get(p.id)!, colX(cb), cyById.get(par)!);
  followsLinks.push({ d, hue, cross, a: p.id, b: par, secA, secB });
}
---

<!-- 범례 -->
<div class="legend">
  <div class="lg-group">
    {
      lanes.map((l) => (
        <a
          class="lg"
          href={sectionHref(base, l.id)}
          data-sec={l.id}
          style={`--hue: ${l.hue}`}
        >
          <span class="lg-dot" />
          <span class="lg-name">{l.label}</span>
          <span class="lg-count">{l.count}</span>
        </a>
      ))
    }
    <button type="button" class="lg-reset" hidden>필터 해제 <span aria-hidden="true">✕</span></button>
  </div>
  <div class="lg-edges" aria-hidden="true">
    <span class="lg-edge"><svg width="24" height="12"><path d="M2 2 v4 q0 4 4 4 h12" class="k-branch" /></svg>세부 갈래</span>
    <span class="lg-edge"><svg width="26" height="12"><path d="M2 6 H20" class="k-follows" marker-end="url(#lgarw)" /><defs><marker id="lgarw" markerWidth="6" markerHeight="6" refX="4.5" refY="3" orient="auto"><path d="M0 0 L5 3 L0 6 Z" fill="context-stroke" /></marker></defs></svg>후속</span>
  </div>
</div>

{
  posts.length === 0 ? (
    <p class="muted">아직 발행된 글이 없습니다.</p>
  ) : (
    <div class="graph" style={`--rail-w: ${railW}px`}>
      <svg
        class="wire"
        width={railW}
        height={totalH}
        viewBox={`0 0 ${railW} ${totalH}`}
        aria-hidden="true"
      >
        <defs>
          <marker
            id="arw"
            markerWidth="6.5"
            markerHeight="6.5"
            refX="5"
            refY="3"
            orient="auto"
          >
            <path d="M0 0 L5.5 3 L0 6 Z" fill="context-stroke" />
          </marker>
        </defs>

        {/* 세로 트렁크·가지 선 */}
        {vlines.map((l) => (
          <line
            class="vline"
            x1={l.x}
            y1={l.y1}
            x2={l.x}
            y2={l.y2}
            data-sec={l.sec}
            style={`--hue: ${l.hue}`}
          />
        ))}

        {/* 가지 갈라짐/복귀 곡선 */}
        {links.map((l) => (
          <path class="branch" d={l.d} data-sec={l.sec} style={`--hue: ${l.hue}`} />
        ))}

        {/* 후속 곡선(화살표) */}
        {followsLinks.map((l) => (
          <path
            class:list={["follows", { cross: l.cross }]}
            d={l.d}
            data-a={l.a}
            data-b={l.b}
            data-sec-a={l.secA}
            data-sec-b={l.secB}
            style={`--hue: ${l.hue}`}
            marker-end="url(#arw)"
          />
        ))}

        {/* 노드 */}
        {rows.map(
          (r) =>
            r.type === "post" && (
              <circle
                class="node"
                cx={r.cx}
                cy={r.cy}
                r={NODE_R}
                data-id={r.id}
                data-sec={r.sec}
                style={`--hue: ${r.hue}`}
              />
            ),
        )}
      </svg>

      {/* 텍스트 행(레일 오른쪽, 높이 고정 → 노드와 y 일치) */}
      <div class="rows">
        {rows.map((r) =>
          r.type === "month" ? (
            <div class="grow month" style={`height: ${r.h}px`}>
              <span class="mlabel">{r.label}</span>
            </div>
          ) : (
            <a
              class="grow post"
              href={`${base}/blog/${r.id}/`}
              data-id={r.id}
              data-sec={r.sec}
              style={`height: ${r.h}px; --hue: ${r.hue}`}
            >
              <span class="ptitle">{r.title}</span>
              <span class="pmeta">
                {r.area && <span class="parea">{r.area}</span>}
                <span class="pdate">{r.date}</span>
                <span class="pchars">{fmtCount(r.chars)}자</span>
              </span>
            </a>
          ),
        )}
      </div>
    </div>
  )
}

<script>
  // 호버 포커스: 한 글에 올리면 그 글의 후속 사슬(부모·자식)만 남기고 흐린다.
  const graph = document.querySelector<HTMLElement>(".graph");
  if (graph) {
    const flinks = [...graph.querySelectorAll<SVGPathElement>("path.follows")];
    const adj = new Map<string, Set<string>>();
    const link = (x: string, yy: string) => {
      if (!adj.has(x)) adj.set(x, new Set());
      adj.get(x)!.add(yy);
    };
    for (const p of flinks) {
      link(p.dataset.a!, p.dataset.b!);
      link(p.dataset.b!, p.dataset.a!);
    }
    const focus = (id: string) => {
      const near = new Set<string>([id, ...(adj.get(id) ?? [])]);
      graph.classList.add("focused");
      for (const el of graph.querySelectorAll<HTMLElement>("[data-id]"))
        el.classList.toggle("active", near.has(el.dataset.id!));
      for (const p of flinks)
        p.classList.toggle("active", p.dataset.a === id || p.dataset.b === id);
    };
    const clear = () => {
      graph.classList.remove("focused");
      for (const el of graph.querySelectorAll(".active"))
        el.classList.remove("active");
    };
    for (const el of graph.querySelectorAll<HTMLElement>("[data-id]")) {
      const id = el.dataset.id!;
      el.addEventListener("pointerenter", () => focus(id));
      el.addEventListener("pointerleave", clear);
      el.addEventListener("focusin", () => focus(id));
      el.addEventListener("focusout", clear);
    }

    // ── 카테고리 필터: 범례 클릭 → 그 카테고리만 남기고 나머지를 흐린다.
    //    같은 카테고리를 다시 클릭하면 해제. (좌표 고정 그래프라 '숨김' 대신 '흐림') ──
    const legend = document.querySelector<HTMLElement>(".legend");
    const legendEls = legend
      ? [...legend.querySelectorAll<HTMLElement>(".lg[data-sec]")]
      : [];
    // 세로선·가지·노드·글행처럼 단일 카테고리를 가진 요소들.
    const secEls = [...graph.querySelectorAll<HTMLElement>("[data-sec]")];
    // 후속 곡선은 양끝 카테고리로 판정(한 카테고리 안에서만 완전히 표시).
    const followEls = [...graph.querySelectorAll<SVGPathElement>("path.follows")];
    const resetBtn = legend?.querySelector<HTMLButtonElement>(".lg-reset");
    let activeFilter: string | null = null;

    const applyFilter = (sec: string | null) => {
      activeFilter = sec;
      graph.classList.toggle("filtered", !!sec);
      legend?.classList.toggle("filtering", !!sec);
      if (resetBtn) resetBtn.hidden = !sec;
      for (const el of secEls)
        el.classList.toggle("dim", !!sec && el.dataset.sec !== sec);
      for (const p of followEls) {
        const within = p.dataset.secA === sec && p.dataset.secB === sec;
        p.classList.toggle("dim", !!sec && !within);
      }
      for (const l of legendEls) {
        l.classList.toggle("sel", l.dataset.sec === sec);
        l.classList.toggle("off", !!sec && l.dataset.sec !== sec);
      }
    };

    for (const l of legendEls) {
      l.addEventListener("click", (e) => {
        e.preventDefault(); // 카테고리 페이지로 이동 대신 그래프를 필터링
        applyFilter(activeFilter === l.dataset.sec ? null : l.dataset.sec!);
      });
    }
    // 명시적 해제: 버튼 클릭 또는 Esc.
    resetBtn?.addEventListener("click", () => applyFilter(null));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && activeFilter) applyFilter(null);
    });
  }
</script>

<style>
  /* ── 범례 ── */
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    margin: var(--space-5) 0 var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--c-border);
  }
  .lg-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .lg {
    --hue-on: var(--hue, var(--c-accent));
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--c-text);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  :global(:root[data-theme="dark"]) .lg,
  :global(:root[data-theme="dark"]) .vline,
  :global(:root[data-theme="dark"]) .branch,
  :global(:root[data-theme="dark"]) .follows,
  :global(:root[data-theme="dark"]) .node,
  :global(:root[data-theme="dark"]) .post {
    --hue-on: oklch(from var(--hue, var(--c-accent)) 0.78 calc(c * 0.52) h);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .lg,
    :global(:root:not([data-theme="light"])) .vline,
    :global(:root:not([data-theme="light"])) .branch,
    :global(:root:not([data-theme="light"])) .follows,
    :global(:root:not([data-theme="light"])) .node,
    :global(:root:not([data-theme="light"])) .post {
      --hue-on: oklch(from var(--hue, var(--c-accent)) 0.78 calc(c * 0.52) h);
    }
  }
  .lg-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--hue-on);
  }
  .lg-name {
    font-weight: 600;
  }
  .lg:hover .lg-name {
    color: var(--hue-on);
  }
  .lg-count {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .lg-edges {
    display: flex;
    gap: var(--space-3);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .lg-edge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .lg-edge svg {
    overflow: visible;
  }
  .k-branch {
    stroke: var(--c-muted);
    stroke-width: 1.75;
    fill: none;
  }
  .k-follows {
    stroke: var(--c-accent);
    stroke-width: 1.75;
    fill: none;
  }

  /* ── 그래프 ── */
  .graph {
    position: relative;
    margin-top: var(--space-2);
  }
  .wire {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    overflow: visible;
  }

  /* 세로 트렁크·가지 선 */
  .vline {
    stroke: var(--hue-on, var(--hue));
    stroke-width: 2;
    opacity: 0.55;
    transition: opacity 0.15s;
  }
  /* 가지 갈라짐/복귀 곡선 */
  .branch {
    fill: none;
    stroke: var(--hue-on, var(--hue));
    stroke-width: 1.75;
    opacity: 0.5;
    transition: opacity 0.15s;
  }
  /* 후속 곡선 */
  .follows {
    fill: none;
    stroke: var(--hue-on, var(--hue));
    stroke-width: 1.9;
    opacity: 0.85;
    transition:
      opacity 0.15s,
      stroke-width 0.15s;
  }
  .follows.cross {
    stroke-dasharray: 5 3;
  }

  /* 노드 */
  .node {
    fill: var(--hue-on, var(--hue));
    stroke: var(--c-bg);
    stroke-width: 3;
    transition:
      opacity 0.15s,
      r 0.1s;
  }

  /* ── 호버 포커스 ── */
  .graph.focused .vline,
  .graph.focused .branch {
    opacity: 0.12;
  }
  .graph.focused .node:not(.active) {
    opacity: 0.22;
  }
  .graph.focused .follows:not(.active) {
    opacity: 0.08;
  }
  .graph.focused .follows.active {
    opacity: 1;
    stroke-width: 2.6;
  }
  .node.active {
    r: 5.6;
  }
  .graph.focused .post:not(.active) {
    opacity: 0.4;
  }

  /* ── 카테고리 필터(범례 클릭 → 선택 카테고리만 남기고 흐림) ── */
  .graph.filtered .vline.dim,
  .graph.filtered .branch.dim {
    opacity: 0.07;
  }
  .graph.filtered .node.dim {
    opacity: 0.13;
  }
  .graph.filtered .follows.dim {
    opacity: 0.05;
  }
  .graph.filtered .post.dim {
    opacity: 0.3;
  }
  /* 범례 선택/비선택 상태 */
  .lg {
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .lg.off {
    opacity: 0.4;
