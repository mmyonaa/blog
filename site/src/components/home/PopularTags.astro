---
// 히어로 하단 인기 태그 — 색·테두리 없는 '#태그' 텍스트 링크(낮은 톤).
// 전체 목록은 분류 허브(/topics/#tags)로. 카테고리는 아래 '카테고리별 새 글'
// 섹션이 담당하므로 히어로에선 태그만 남긴다.
//
// CSS가 항상 2줄(--lines)로 클립해 히어로가 길어지지 않게 한다 — 좁은 화면에서 2줄을
// 넘기면 줄 중간이 아니라 꽉 찬 줄 경계에서 깔끔히 떨어진다. overflow:hidden은 시각적으로만
// 가릴 뿐 탭 순서·스크린리더엔 남으므로, 아래 스크립트가 클립된 태그를 초점·AT에서 뺀다.
import { tagHref } from "../../lib/tags.ts";

interface Props {
  tags: { tag: string; count: number }[];
  base: string;
}
const { tags, base } = Astro.props;
---

<nav class="tags-strip reveal" aria-label="인기 태그">
  <div class="tag-links">
    {tags.map((t) => (
      <a class="tag-link" href={tagHref(base, t.tag)}>#{t.tag}</a>
    ))}
  </div>
  <a class="tag-more" href={`${base}/topics/#tags`}>태그 전체 →</a>
</nav>

<script>
  // 2줄 클립으로 안 보이게 된 태그를 탭 순서·스크린리더에서도 제외한다.
  // (overflow:hidden은 시각만 가릴 뿐 초점·AT 노출은 그대로라 접근성 이슈였다.)
  // 폭이 바뀌면 보이는 줄 수가 달라지므로 최초·리사이즈 때마다 다시 계산한다.
  function clipHiddenTags() {
    document
      .querySelectorAll<HTMLElement>(".tags-strip .tag-links")
      .forEach((box) => {
        const boundary = box.getBoundingClientRect().top + box.clientHeight;
        box.querySelectorAll<HTMLElement>(".tag-link").forEach((el) => {
          // 클립 경계(2줄 아래)에 top이 걸리면 3번째 줄 이후 → 숨김 처리.
          const hidden = el.getBoundingClientRect().top >= boundary - 1;
          el.toggleAttribute("inert", hidden);
          el.setAttribute("aria-hidden", hidden ? "true" : "false");
          el.tabIndex = hidden ? -1 : 0; // inert 미지원 브라우저 보강
        });
      });
  }
  document.addEventListener("astro:page-load", clipHiddenTags);
  window.addEventListener("resize", clipHiddenTags, { passive: true });
</script>

<style>
  .tags-strip {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    /* 히어로 본문과 구분하는 헤어라인. (이전엔 위 카테고리 strip이 제공하던 몫) */
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--c-border);
  }

  /* 각 태그의 줄 상자 높이(--tag-lh)와 줄 간격(--space-2)을 안다면, N줄의
     최대 높이를 정확히 계산할 수 있다 → 3번째 줄부터 통째로 클립돼 잘림이 깔끔하다.
     --lines는 아래 미디어쿼리에서 화면 폭에 맞춰 조정한다. */
  .tag-links {
    --tag-lh: 1.7rem;
    --lines: 2;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--space-2) var(--space-4);
    overflow: hidden;
    max-height: calc(
      var(--lines) * var(--tag-lh) + (var(--lines) - 1) * var(--space-2)
    );
  }
  .tag-link {
    font-size: var(--fs-sm);
    line-height: var(--tag-lh);
    color: var(--c-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .tag-link:hover {
    color: var(--c-accent);
    text-decoration: none;
  }

  .tag-more {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .tag-more:hover {
    text-decoration: underline;
  }
</style>
