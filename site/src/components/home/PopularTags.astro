---
// 카테고리 pill 아래 인기 태그. 카테고리(SectionPills)보다 낮은 톤으로 둔다 —
// 색·테두리 없는 '#태그' 텍스트 링크. 전체 목록은 분류 허브(/topics/#tags)로.
//
// 넘겨받는 목록은 이미 상위 소수(index.astro에서 slice)라 대부분 폭에서 전량 보인다.
// CSS는 항상 2줄(--lines)로 클립해 히어로가 길어지지 않게만 보정한다 — 좁은 화면에서
// 2줄을 넘기면 줄 중간이 아니라 꽉 찬 줄 경계에서 깔끔히 떨어진다.
import { tagHref } from "../../lib/tags.ts";

interface Props {
  tags: { tag: string; count: number }[];
  base: string;
}
const { tags, base } = Astro.props;
---

<nav class="tags-strip reveal" aria-label="인기 태그">
  <div class="tag-links">
    {tags.map((t) => (
      <a class="tag-link" href={tagHref(base, t.tag)}>#{t.tag}</a>
    ))}
  </div>
  <a class="tag-more" href={`${base}/topics/#tags`}>태그 전체 →</a>
</nav>

<style>
  .tags-strip {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  /* 각 태그의 줄 상자 높이(--tag-lh)와 줄 간격(--space-2)을 안다면, N줄의
     최대 높이를 정확히 계산할 수 있다 → 3번째 줄부터 통째로 클립돼 잘림이 깔끔하다.
     --lines는 아래 미디어쿼리에서 화면 폭에 맞춰 조정한다. */
  .tag-links {
    --tag-lh: 1.7rem;
    --lines: 2;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: var(--space-2) var(--space-4);
    overflow: hidden;
    max-height: calc(
      var(--lines) * var(--tag-lh) + (var(--lines) - 1) * var(--space-2)
    );
  }
  .tag-link {
    font-size: var(--fs-sm);
    line-height: var(--tag-lh);
    color: var(--c-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .tag-link:hover {
    color: var(--c-accent);
    text-decoration: none;
  }

  .tag-more {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .tag-more:hover {
    text-decoration: underline;
  }
</style>
