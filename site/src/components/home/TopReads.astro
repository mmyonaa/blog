---
import type { CollectionEntry } from "astro:content";
import { sectionHref, sectionLabel, sectionOf, hueOf, initialOf } from "../../lib/sections.ts";
import { fmtRelative } from "../../lib/date.ts";
import { readMin } from "../../lib/reading.ts";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<ol class="top-reads reveal">
  {
    posts.map((post) => {
      const sec = sectionOf(post);
      return (
        <li class="tr-item" style={`--hue: ${hueOf(sec)}`}>
          <a class="tr-badge" href={sectionHref(base, sec)} aria-label={sectionLabel(sec)}>
            {initialOf(sec)}
          </a>
          <div class="tr-body">
            <h3 class="tr-title">
              <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <span class="tr-meta">
              {fmtRelative(post.data.pubDate)} · {readMin(post.body)}분
            </span>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  /* 컴팩트 리스트(썸네일 대신 카테고리 색 배지) — 참고의 Top Reads 열. */
  .top-reads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .tr-item {
    /* 카테고리 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --hue-on: var(--hue);
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--c-border);
  }
  .tr-item:first-child {
    border-top: none;
    padding-top: 0;
  }
  :global(:root[data-theme="dark"]) .tr-item {
    --hue-on: color-mix(in srgb, var(--hue) 58%, white);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .tr-item {
      --hue-on: color-mix(in srgb, var(--hue) 58%, white);
    }
  }
  /* 배지 글자색 var(--c-bg): --hue-on과 명도가 항상 반대라 대비 확보 */
  .tr-badge {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: var(--hue-on);
    color: var(--c-bg);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
  }
  .tr-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }
  .tr-title {
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
    /* 2줄에서 자른다 */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .tr-title a {
    color: var(--c-text);
    text-decoration: none;
  }
  .tr-title a:hover {
    color: var(--hue-on);
  }
  .tr-meta {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
</style>
