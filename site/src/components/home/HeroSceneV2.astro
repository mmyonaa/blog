---
// 히어로 V2 — glu 레퍼런스(docs/ref/…3.27.58.png)의 '클러스터' 문법:
//   ① 한 덩어리: 오브젝트들이 30~60% 겹치며 하나의 유기적 blob 실루엣으로 읽힌다.
//   ② 압도적 위계: 주인공(달력 카드)이 클러스터를 지배하고, 서포트는 절반,
//      나머지는 가장자리에 흩뿌린 아주 작은 크리스털 점.
//   ③ 레이어링: 주인공 뒤에 큰 배경(간유리 버블·말풍선), 앞에 하나(연필)가 올라온다.
//   ④ 왼쪽 절반은 텍스트 여백, 텍스트 근처엔 외톨이 액센트 하나만.
// 소재는 블로그 서사와 1:1 — 달력(매일)·연필(쓰다)·말풍선(이야기)·
// 종이비행기(발행)·b 로고(브랜드). 톤은 코랄/피치/크림으로 통일(청록·블루는 제외).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const a = (f: string) => `${base}/hero3d/${f}`;
---

<div class="scene" aria-hidden="true">
  <div class="cluster">
    <!-- ── 뒤 레이어: 큰 배경 오브젝트 (주인공을 감싼다) ── -->
    <img class="ob bg-glass" src={a("glass-bead.webp")} alt="" loading="eager" decoding="async" />
    <img class="ob bg-bubble" src={a("ver2/speech-bubble.webp")} alt="" loading="eager" decoding="async" />
    <img class="ob brand" src={a("logo/b_logo.webp")} alt="" loading="lazy" decoding="async" />
    <!-- ── 주인공: 달력(매일) ── -->
    <img class="ob card" src={a("ver2/calendar.webp")} alt="" loading="eager" decoding="async" />
    <!-- ── 앞 레이어: 서포트 + 겹쳐 오르는 소품 ── -->
    <img class="ob plane" src={a("ver2/paper-plane.webp")} alt="" loading="eager" decoding="async" />
    <img class="ob pencil" src={a("ver2/pencil.webp")} alt="" loading="eager" decoding="async" />
    <img class="ob bead" src={a("sphere-coral.webp")} alt="" loading="lazy" decoding="async" />
    <!-- ── 가장자리 크리스털 점(레퍼런스의 작은 다이아몬드) ── -->
    <img class="ob dot dot-glass-a" src={a("ver2/glass-bead.webp")} alt="" loading="lazy" decoding="async" />
    <img class="ob dot dot-glass-b" src={a("ver2/glass-bead.webp")} alt="" loading="lazy" decoding="async" />
    <img class="ob dot dot-glass-c" src={a("ver2/glass-bead.webp")} alt="" loading="lazy" decoding="async" />
    <img class="ob dot dot-coral" src={a("sphere-coral.webp")} alt="" loading="lazy" decoding="async" />
  </div>
  <!-- ── 왼쪽 외톨이 액센트 — 클러스터와 떨어져 텍스트 곁에서 균형만 잡는다 ── -->
  <img class="ob lone" src={a("sphere-coral.webp")} alt="" loading="lazy" decoding="async" />
</div>

<style>
  .scene {
    /* 히어로 전체를 덮는 배경 레이어 — 부모(.hero-bg)가 absolute로 깔아준다.
       overflow는 자르지 않는다 — hidden이면 하단 경계에서 드롭섀도가 직선으로
       끊긴다. 오브젝트 좌표가 전부 경계 안이라 데스크톱에선 클리핑이 불필요. */
    position: absolute;
    inset: 0;
    /* 다크 폴리시 훅 — 다크에서만 아래 변수들이 채워진다(라이트는 기본값 = 무효과). */
    filter: var(--scene-dim, none);
  }
  /* 클러스터 = 고정 종횡비 '무대 박스'.
     핵심: 오브젝트의 left/top/width를 전부 이 박스 기준 %로 매핑한다.
     박스는 clamp 폭 + aspect-ratio로 항상 같은 비율을 유지하므로,
     뷰포트가 좁아지면 가로·세로가 함께 스케일되어 구도(겹침 관계)가 통째로 보존된다.
     (예전엔 width는 뷰포트 폭 %, top은 고정 히어로 높이 % → 좁아지면 세로만 벌어져
      클러스터가 풀어헤쳐졌다.) 우측 가장자리에 앵커하고 세로 중앙에 앉힌다. */
  .cluster {
    position: absolute;
    top: 50%;
    right: 8%;
    width: clamp(20rem, 43vw, 44rem);
    aspect-ratio: 31 / 23;
    transform: translateY(-50%);
    animation: cl-breathe 14s ease-in-out infinite alternate;
  }
  .ob {
    position: absolute;
    height: auto;
    will-change: transform;
  }
  /* 접지용 앰비언트 글로우 — 다크에서 드롭섀도가 배경에 묻혀 오브젝트가 떠 보이는
     문제를, 클러스터 뒤 은은한 코랄 광원으로 대신 접지한다. 라이트에선 투명. */
  .cluster::before {
    content: "";
    position: absolute;
    inset: -14%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--scene-glow, transparent), transparent 72%);
  }

  /* ══ 클러스터 — 좌표·크기 전부 .cluster 박스 기준 %(1440 구도를 그대로 매핑). ══ */

  /* ── 뒤: 간유리 버블(주인공 좌상단 아래로 파고든다) ── */
  .bg-glass {
    left: 9.4%; top: 14.3%; width: 28.9%;
    /* 간유리는 다크에서 탁한 회색 얼룩이 되므로 다크에서만 투명도를 더 낮춘다. */
    opacity: var(--glass-opacity, 0.92);
    /* 구는 회전이 안 보인다 — 비눗방울처럼 떠오르는 이동+팽창 전용 모션. */
    animation: ob-bob 9s ease-in-out infinite alternate;
    filter: drop-shadow(0 20px 30px rgb(36 37 46 / 0.10));
  }
  /* ── 뒤: 말풍선 큰 쿠션(주인공 우하단을 받친다) ── */
  .bg-bubble {
    left: 63.4%; top: 58.7%; width: 28.9%;
    animation: ob-float-b 13s ease-in-out infinite alternate;
    filter: drop-shadow(0 26px 34px rgb(36 37 46 / 0.13));
  }
  /* ── 뒤: b 로고(주인공 위쪽 테두리 뒤로 빼꼼 = glu의 폼폼 자리) ── */
  .brand {
    left: 38.4%; top: 8.2%; width: 14.4%;
    animation: ob-tumble 12s ease-in-out infinite alternate-reverse;
    filter: drop-shadow(0 16px 22px rgb(36 37 46 / 0.14));
  }

  /* ── 주인공: 달력. 클러스터를 지배(박스 폭의 ~62%) ── */
  .card {
    left: 21.1%; top: 15.1%; width: 61.5%;
    transform: rotate(-8deg);
    animation: ob-hero 9s ease-in-out infinite alternate;
    filter: drop-shadow(0 32px 42px rgb(36 37 46 / 0.22));
  }

  /* ── 앞: 종이비행기(우상단으로 활공하듯 빠져나온다) ── */
  .plane {
    left: 67.3%; top: 11.7%; width: 23.1%;
    animation: ob-glide 10s ease-in-out infinite alternate;
    filter: drop-shadow(0 18px 24px rgb(36 37 46 / 0.16));
  }
  /* ── 앞: 연필(주인공 좌하단 위로 가로질러 겹친다 = glu의 앞 별표 역할) ── */
  .pencil {
    left: 7.5%; top: 48.3%; width: 34.7%;
    animation: ob-hero 8s ease-in-out infinite alternate-reverse;
    filter: drop-shadow(0 24px 30px rgb(36 37 46 / 0.20));
  }
  /* ── 앞: 코랄 구슬(클러스터 아래 틈새에 박힌다) ── */
  .bead {
    left: 38.4%; top: 72.7%; width: 10.7%;
    animation: ob-drift-a 9s ease-in-out infinite alternate;
    filter: drop-shadow(0 12px 16px rgb(36 37 46 / 0.16));
  }

  /* ── 가장자리 크리스털 점 — 아주 작게, 클러스터 경계에 딱 붙여 흩뿌린다 ── */
  .dot { filter: drop-shadow(0 8px 12px rgb(36 37 46 / 0.10)); }
  /* 크리스털 구슬은 회전(twinkle)이 안 보인다 — 서로 위상이 어긋난 부유로. */
  .dot-glass-a {
    left: 84.6%; top: 23.9%; width: 8.7%;
    animation: ob-drift-a 7s ease-in-out infinite alternate;
  }
  .dot-glass-b {
    left: 30.6%; top: 9.9%; width: 6.1%;
    animation: ob-drift-b 8s ease-in-out infinite alternate-reverse;
  }
  .dot-glass-c {
    left: 3.6%; top: 76.1%; width: 9.7%;
    animation: ob-drift-a 9s ease-in-out infinite alternate-reverse;
  }
  .dot-coral {
    left: 86.5%; top: 57%; width: 5.8%;
    animation: ob-drift-b 10s ease-in-out infinite alternate;
    filter: drop-shadow(0 8px 12px rgb(36 37 46 / 0.14));
  }

  /* ══ 외톨이 액센트 — 텍스트와 클러스터 사이 빈 복도에 코랄 점 하나 ══ */
  .lone {
    left: 32%; top: 21%; width: 3.4%;
    animation: ob-drift-b 12s ease-in-out infinite alternate;
    filter: drop-shadow(0 10px 14px rgb(36 37 46 / 0.12));
  }

  /* ── 모션: 전부 '돌아오는 왕복'이라 alternate로 이음새 없이 돈다. ──
     주의: translateY(%)는 요소 자신의 크기 기준 → 큰 오브젝트는 작은 수치로도
     충분하고(hero/float), 작은 점은 큰 수치를 줘야 티가 난다(drift/twinkle). */
  /* 세로 중앙 앵커(translateY -50%)를 키프레임에 함께 실어, 공통 부유가
     앵커를 덮어쓰지 않게 한다(정적/reduced-motion 상태의 .cluster transform과 동일). */
  @keyframes cl-breathe {
    from { transform: translateY(-50%) translate3d(0, 0, 0); }
    to { transform: translateY(-50%) translate3d(-0.9%, -1.5%, 0); }
  }
  /* 모바일용 숨쉬기 — 하단 앵커(transform 없음) 구간에서 쓰는 무앵커 변형. */
  @keyframes cl-breathe-flat {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-0.9%, -1.5%, 0); }
  }
  @keyframes ob-hero {
    from { transform: translateY(-1.4%) rotate(-8deg); }
    to { transform: translateY(2.2%) rotate(-5.6deg); }
  }
  @keyframes ob-float-a {
    from { transform: translateY(0) rotate(0deg); }
    to { transform: translateY(-4.5%) rotate(-4.5deg); }
  }
  /* 유리 구슬용 — 대각선 부유 + 미세 팽창(비눗방울의 숨).
     구는 회전이 안 보이므로 이동·팽창을 다른 오브젝트보다 크게 준다. */
  @keyframes ob-bob {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(-5%, -16%) scale(1.06); }
  }
  @keyframes ob-float-b {
    from { transform: translateY(0) rotate(0deg); }
    to { transform: translateY(4.5%) rotate(3.5deg); }
  }
  @keyframes ob-tumble {
    from { transform: translateY(0) rotate(-8deg); }
    to { transform: translateY(-11%) rotate(8deg); }
  }
  @keyframes ob-glide {
    from { transform: translate(-8%, 5%) rotate(-7deg); }
    to { transform: translate(9%, -11%) rotate(6deg); }
  }
  @keyframes ob-drift-a {
    from { transform: translateY(0) rotate(0deg); }
    to { transform: translateY(-28%) rotate(-16deg); }
  }
  @keyframes ob-drift-b {
    from { transform: translateY(0) rotate(0deg); }
    to { transform: translateY(32%) rotate(18deg); }
  }
  @keyframes ob-twinkle {
    from { transform: rotate(-14deg) scale(0.86); opacity: 0.8; }
    to { transform: rotate(16deg) scale(1.12); opacity: 1; }
  }

  /* ── 태블릿(641~980): 데스크톱과 '같은 구도'를, 화면에 맞게 크게 우측 중앙에.
        (예전엔 우상단에 작게 축소했지만, 이제 PC와 동일한 큰 클러스터가 텍스트·통계
        위로 겹쳐 앉는다 — 제목·부제 가독은 유지하되 오버랩은 의도된 것.)
        전체 오브젝트 유지. 앵커가 데스크톱과 같아(translateY -50%) cl-breathe도 그대로 돈다.
        무대(scene) overflow는 자르지 않아 그림자 직선 절단이 없고, 클러스터 우변을
        화면 안에 두어 가로 스크롤을 막는다. ── */
  @media (max-width: 980px) {
    .cluster {
      width: clamp(24rem, 58vw, 34rem);
      right: 0%;
      top: 50%;
      transform: translateY(-50%);
    }
    /* 클러스터가 화면 우변에 붙는 구간 — 글로우(-14%)가 화면 밖으로 나가면
       투명해도 박스가 스크롤 폭에 잡혀 가로 스크롤이 생긴다. 우변만 화면 안으로. */
    .cluster::before {
      right: 0;
    }
    /* 외톨이 액센트가 앉을 '텍스트↔클러스터 복도'가 사라지므로 숨긴다. */
    .lone { display: none; }
  }

  /* ── 모바일(≤640): 데스크톱과 같은 전체 클러스터를 크게 깔고, 통계(.stats)가
        그 위에 겹쳐 얹히는 레이어드 구성. 무게중심을 하단에 두어 제목·부제(상단)
        가독은 지키고 통계와는 의도적으로 겹친다. 오브젝트 몸통은 히어로 안에 온전히
        (상단 절단 없이). overflow를 자르지 않아(직선 절단 방지) 그림자는 자연스럽게
        흐르고, 클러스터를 무대 폭 안에 담아 가로 스크롤을 막는다. ── */
  @media (max-width: 640px) {
    .cluster {
      width: clamp(18rem, 92vw, 23rem);
      left: auto;
      /* 우측으로 살짝 밀착 — 박스 우변 ~8%는 빈 영역이라 이미지는 안 잘린다.
         -1rem이면 박스 우변이 정확히 뷰포트 우변(거터 1rem 밖)에 닿는 한계값. */
      right: -1rem;
      top: auto;
      /* 히어로 바닥까지 내려 앉힌다 — 제목 라인과의 겹침을 풀고 무게중심을
         통계~하단으로. 그림자는 페이드라 경계에서 잘리지 않는다. */
      bottom: 0;
      transform: none;
      transform-origin: center;
      /* 하단 앵커(무 transform) 구간이라 -50% 앵커가 없는 flat 변형으로 숨쉰다. */
      animation: cl-breathe-flat 14s ease-in-out infinite alternate;
    }
    /* 박스가 거터 밖으로 나간 만큼 글로우 우변을 되물려 가로 스크롤 방지. */
    .cluster::before {
      right: 1rem;
    }
    /* 박스 자체는 우측 한계(-1rem)라, 오브젝트만 우측으로 더 민다.
       translate 속성은 transform 애니메이션과 독립 합성이라 모션이 안 깨진다.
       이동량은 최우측 오브젝트가 뷰포트 안에 남는 한도로 제한. */
    .cluster .ob {
      translate: 1rem 0.75rem;
    }
    /* 외톨이 액센트만 예외 — 좁은 화면엔 텍스트↔클러스터 복도가 없어 숨긴다. */
    .lone { display: none; }
  }

  /* ── 다크 폴리시: 구도는 그대로, 값만 셋 바꾼다 ──
     ① 전체를 한 톤 눌러 파스텔의 형광 글레어를 가라앉히고
     ② 죽은 드롭섀도 대신 코랄 글로우로 접지하고
     ③ 회색 얼룩이 되는 간유리만 더 투명하게.
     셀렉터 이중화는 global.css 컨벤션(OS 다크 + data-theme 강제)을 따른다. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .scene {
      --scene-dim: brightness(0.87) saturate(0.92);
      --scene-glow: color-mix(in srgb, var(--c-accent) 14%, transparent);
      --glass-opacity: 0.6;
    }
  }
  :root[data-theme="dark"] .scene {
    --scene-dim: brightness(0.87) saturate(0.92);
    --scene-glow: color-mix(in srgb, var(--c-accent) 14%, transparent);
    --glass-opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .cluster,
    .ob {
      animation: none !important;
    }
  }
</style>
