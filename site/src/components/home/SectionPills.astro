---
import { sectionHref, hueOf } from "../../lib/sections.ts";

interface Props {
  sections: { id: string; label: string; count: number }[];
  base: string;
}
const { sections, base } = Astro.props;
---

<nav class="sections-strip reveal" aria-label="카테고리">
  {sections.map((s) => (
    <a
      class="sec-pill"
      href={sectionHref(base, s.id)}
      style={`--pill-accent: ${hueOf(s.id)}`}
    >
      {s.label} <span class="sec-pill-count">{s.count}</span>
    </a>
  ))}
</nav>

<style>
  /* 에디토리얼 카테고리 내비 — 알약·틴트·그림자 없이, 카테고리 색은 앞의
     작은 점으로만 남긴다. 항목 사이는 헤어라인으로 구획한다. */
  .sections-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) 0;
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--c-border);
  }
  .sec-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 0.25em var(--space-4) 0.25em 0;
    margin-right: var(--space-4);
    /* 실제로 칠하는 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --pill-on: var(--pill-accent);
    border-right: 1px solid var(--c-border);
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .sec-pill:last-child {
    border-right: none;
    margin-right: 0;
  }
  /* 카테고리 색 점 — 카드/필터와 같은 hue로 목록 전반의 색을 맞춘다. */
  .sec-pill::before {
    content: "";
    align-self: center;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--pill-on);
    flex: none;
  }
  :root[data-theme="dark"] .sec-pill {
    --pill-on: color-mix(in srgb, var(--pill-accent) 58%, white);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .sec-pill {
      --pill-on: color-mix(in srgb, var(--pill-accent) 58%, white);
    }
  }
  .sec-pill:hover {
    color: var(--pill-on);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .sec-pill-count {
    color: var(--c-muted);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
