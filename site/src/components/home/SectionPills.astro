---
import { sectionHref, hueOf } from "../../lib/sections.ts";

interface Props {
  sections: { id: string; label: string; count: number }[];
  base: string;
}
const { sections, base } = Astro.props;
---

<nav class="sections-strip reveal" aria-label="카테고리">
  {sections.map((s) => (
    <a
      class="sec-pill"
      href={sectionHref(base, s.id)}
      style={`--pill-accent: ${hueOf(s.id)}`}
    >
      {s.label} <span class="sec-pill-count">{s.count}</span>
    </a>
  ))}
</nav>

<style>
  .sections-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .sec-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.9em;
    /* 실제로 칠하는 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --pill-on: var(--pill-accent);
    border: 1px solid
      color-mix(in srgb, var(--pill-on) 35%, var(--c-border));
    border-radius: var(--radius-pill, 999px);
    background: color-mix(in srgb, var(--pill-on) 8%, var(--c-surface));
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease,
      background 0.15s ease, transform 0.15s ease;
  }
  :root[data-theme="dark"] .sec-pill {
    --pill-on: color-mix(in srgb, var(--pill-accent) 58%, white);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .sec-pill {
      --pill-on: color-mix(in srgb, var(--pill-accent) 58%, white);
    }
  }
  .sec-pill:hover {
    border-color: var(--pill-on);
    color: var(--pill-on);
    background: color-mix(in srgb, var(--pill-on) 16%, transparent);
    transform: translateY(-1px);
  }
  .sec-pill-count {
    color: var(--pill-on);
    font-weight: 700;
  }
</style>
