---
import HeroScene from "./HeroSceneV2.astro";

interface Props {
  /** hasPosts가 false면 통계를 숨긴다. */
  hasPosts: boolean;
  stats: { value: number; label: string; href?: string }[];
}
const { hasPosts, stats } = Astro.props;
---

<section class="hero">
  {/* 3D 정물 배경 — 히어로 전폭에 깔리고 텍스트가 위(z)에 얹힌다 */}
  <div class="hero-bg" aria-hidden="true">
    <HeroScene />
  </div>
  <div class="hero-inner">
    <div class="hero-main">
      <h1 class="hero-title reveal"><span class="hero-title-ink">daily.mcp<span class="hero-dot" aria-hidden="true"></span></span></h1>
      <p class="hero-sub reveal">
        직접 만든 MCP 서버가 쓰고, 제가 배운 걸로 채웁니다.
      </p>
      {/* 부제 아래 컴팩트 통계 라인 — 카드 없이(배경이 이미 3D) 모노 숫자만.
          발행 스트릭 잔디는 About(콜로폰)으로 이동했다. */}
      {hasPosts && (
        <dl class="stats reveal">
          {stats.map((s) => (
            <div class:list={["stat", { "stat-link": s.href }]}>
              <dt class="stat-value" data-countup={s.value}>{s.value}</dt>
              <dd class="stat-label">
                {s.href ? (
                  <a href={s.href} class="stat-a">{s.label}</a>
                ) : (
                  s.label
                )}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</section>

<script>
  // 히어로 상호작용(통계 카운트업)만 이 컴포넌트가 담당.
  // 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__heroBound) {
    (window as any).__heroBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 통계 카운트업: [data-countup]을 0→값으로. reduced-motion이면 즉시 최종값.
    const runCountUp = () => {
      document.querySelectorAll<HTMLElement>("[data-countup]").forEach((el) => {
        const target = parseInt(el.getAttribute("data-countup") || "0", 10);
        if (!Number.isFinite(target) || reduce || target <= 0) {
          el.textContent = String(Number.isFinite(target) ? target : 0);
          return;
        }
        const dur = 850;
        let startT = 0;
        el.textContent = "0";
        const tick = (now: number) => {
          if (!startT) startT = now;
          const t = Math.min(1, (now - startT) / dur);
          const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      });
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runCountUp);
  }
</script>

<style>
  /* ══════════════════════════════════════════════════════════
     히어로 — 에디토리얼 마스트헤드.
     마스트헤드 제목 · 떠 있는 통계 바 · 액자에 담긴 잔디.
     ══════════════════════════════════════════════════════════ */
  .hero {
    /* 세로로 넉넉한 무대(3D 배경이 숨 쉴 높이). 헤더와 아래 섹션 양쪽에
       숨 돌릴 여백을 둔다. */
    padding: var(--space-10) 0 var(--space-6);
  }

  /* 마스트헤드 제목 — 굵은 잉크 색. h1은 레이아웃·진입 reveal을 담당. */
  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 var(--space-3);
  }
  .hero-title-ink {
    color: var(--c-text);
  }
  /* 코랄 액센트 점 — 헤더 워드마크와 동일한 로고 마크(대형) */
  .hero-dot {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.1em;
    border-radius: 50%;
    background: var(--c-accent);
    vertical-align: 0.06em;
  }
  .hero-sub {
    color: var(--c-muted);
    font-size: var(--fs-lg);
    max-width: 42ch;
    margin: 0;
  }

  /* ── 3D 배경 레이어: 히어로 전폭. 텍스트·카드(.hero-inner)가 z 위에 얹힌다 ── */
  .hero {
    position: relative;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    /* 히어로를 세로로 키우고 텍스트 블록을 그 안에서 수직 중앙에 앉힌다. */
    min-height: 23rem;
    display: grid;
    align-items: center;
  }
  .hero-main {
    padding: var(--space-4) 0;
  }

  /* ── 통계 라인 ── 카드 없이 부제 아래 붙는 컴팩트 리드아웃.
     배경이 이미 3D 정물이라 박스를 벗겨 가볍게, 터미널 캡션(모노 프롬프트)만 남긴다. */
  .stats {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) 0;
    margin: var(--space-6) 0 0;
    /* 상단 프롬프트 캡션(::before) 자리 */
    padding: 1.25rem 0 0;
    width: max-content;
    max-width: 100%;
  }
  /* '프롬프트' 캡션 — 터미널 상태줄처럼 코랄 점 + 모노 라벨. */
  .stats::before {
    content: "stats --live";
    position: absolute;
    top: 0;
    left: 0;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--c-muted);
    opacity: 0.85;
    /* 앞의 코랄 점 = 살아있는 표시. */
    padding-left: 0.95em;
  }
  .stats::after {
    content: "";
    position: absolute;
    top: 0.34rem;
    left: 0;
    width: 0.42em;
    height: 0.42em;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 0.14em var(--c-accent-soft);
  }
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    /* 숫자를 라벨 위 중앙에 정렬 — 좌측 정렬이면 단자리 숫자(8·4)가 셀마다
       왼쪽에 쏠려 좌우 여백이 비대칭이 되고 행이 들쭉날쭉해 보인다. */
    align-items: center;
    text-align: center;
    line-height: 1.1;
    padding: 0 var(--space-5);
  }
  .stat:first-child {
    padding-left: 0;
  }
  /* 짧은 중앙 구분선 — 셀 전체를 가르는 풀높이 선 대신 리듬만 주는 하프라인.
     위아래로 페이드아웃해 딱딱한 1px 선보다 부드럽게. */
  .stat:not(:first-child)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 2.4em;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--c-border) 22%,
      var(--c-border) 78%,
      transparent
    );
  }
  /* 클릭 가능한 통계: 라벨 링크가 stat 전체를 덮어 숫자까지 클릭되게 */
  .stat-link {
    position: relative;
  }
  .stat-a {
    color: inherit;
    text-decoration: none;
  }
  .stat-a::after {
    content: "";
    position: absolute;
    inset: -0.2em -0.3em;
    border-radius: var(--radius-sm);
  }
  .stat-link:hover .stat-label {
    color: var(--c-accent);
  }
  .stat-value {
    /* 마스트헤드·워드마크와 같은 모노 폰트 — 통계를 daily.mcp 정체성에 묶는다.
       카드 시절(2xl)보다 두 단계 낮춰 부제 아래 리드아웃답게. */
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }
  /* 첫 통계 = 시선 고정점. 코랄로 물들이고 아래 짧은 밑줄 틱으로 앵커링. */
  .stat:first-child .stat-value {
    color: var(--c-accent);
  }
  .stat-label {
    position: relative;
    margin: 0.5em 0 0;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    /* 에디토리얼 캡션 톤 — 넉넉한 트래킹으로 숫자와 리듬을 분리. */
    letter-spacing: 0.08em;
  }


  /* 태블릿(641~900): 데스크톱 clamp(…,8vw,4.4rem)이면 768에서 ~61px로 과대.
     중간 스케일로 낮춰 모바일(≤640, ~38px)과 데스크톱 사이를 매끄럽게 잇는다. */
  @media (max-width: 900px) {
    .hero-title {
      font-size: clamp(2.4rem, 6vw, 3rem);
    }
  }

  /* 태블릿·모바일(≤980): PC와 동일한 큰 클러스터가 텍스트 뒤로 겹칠 수 있으므로,
     제목·부제에 배경색 헤일로를 둘러 오브젝트 위에서도 가독을 지킨다. 헤일로는
     배경색(--c-bg)이라 겹치지 않는 구간에선 보이지 않고, 라이트·다크 모두에서
     동작한다. 데스크톱(>980)은 텍스트와 클러스터가 분리돼 적용하지 않는다. */
  @media (max-width: 980px) {
    /* 태블릿: 상단 블록 전체를 압축 — 데스크톱 패딩(72px)·무대 높이(23rem)는 과해
       첫 폴드를 잡아먹는다. 섹션 패딩과 무대를 함께 깎는다. */
    .hero {
      padding: var(--space-4) 0 var(--space-4);
    }
    .hero-inner {
      min-height: 17rem;
    }
    .hero-title,
    .hero-sub,
    .stats::before,
    .stat-value,
    .stat-label {
      text-shadow: 0 0 8px var(--c-bg), 0 0 5px var(--c-bg),
        0 0 2px var(--c-bg);
    }
  }

  /* ── 모바일 (#27) ──
     랜딩 first-fold를 히어로가 통째로 삼키지 않도록 제목 스케일을 낮추고
     무대 높이도 줄인다. 통계 라인은 2×2로 감싼다. 톤은 유지. */
  @media (max-width: 640px) {
    .hero {
      /* 모바일 첫 폴드 압축: 상하 모두 타이트하게(아래 카테고리 목록이 첫눈에 걸리게). */
      padding: var(--space-2) 0 var(--space-2);
    }
    /* 모바일은 3D 클러스터가 통계 뒤로 크게 겹쳐 깔린다. 텍스트를 위로 붙이고
       (align-content:start) 무대를 세로로 키워, 넓어진 하단을 클러스터에 내주고
       통계 라인이 그 위에 얹히게 한다. */
    .hero-inner {
      min-height: 16rem;
      align-content: start;
    }
    /* 제목 위 여백 압축 — 데스크톱용 내부 패딩(1rem)을 모바일에선 걷어낸다. */
    .hero-main {
      padding-top: 0;
    }
    /* 큰 마스트헤드가 첫 화면을 잡아먹지 않게 모바일 한정으로 축소(데스크톱 유지). */
    .hero-title {
      font-size: clamp(1.9rem, 8.5vw, 2.4rem);
      margin-bottom: var(--space-2);
    }
    /* 서브카피도 한 톤 낮춰 제목과의 대비를 차분하게. */
    .hero-sub {
      font-size: var(--fs-base);
    }
    /* 좁은 폭: 통계 라인이 2×2로 감싸며 앉는다 — 카드 없는 결 그대로. */
    .stats {
      grid-template-columns: repeat(2, minmax(0, max-content));
      display: grid;
      column-gap: var(--space-6);
      row-gap: var(--space-3);
      margin-top: var(--space-5);
    }
    /* 클러스터가 통계 뒤로 크게 깔려도 숫자·라벨·캡션이 또렷하게 뜨도록, 글자마다
       배경색(--c-bg) 헤일로를 촘촘히 두른다. 넓은 배경 스크림은 다크에서 어두운
       얼룩처럼 보여 피하고, 글자 주변만 국소적으로 강하게 감싼다. --c-bg가 테마 따라
       뒤집혀(라이트=밝은, 다크=어두운) 어떤 오브젝트 위에서도 대비를 확보한다. */
    .stats::before,
    .stat-value,
    .stat-label {
      text-shadow: 0 0 8px var(--c-bg), 0 0 5px var(--c-bg),
        0 0 3px var(--c-bg), 0 0 2px var(--c-bg);
    }
    .stat {
      padding: 0;
    }
    /* 2열 랩핑에선 세로 구분선이 왼쪽 열에 어색하게 남지 않게 숨긴다. */
    .stat:not(:first-child)::before {
      display: none;
    }
  }
</style>
