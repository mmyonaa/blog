---
import type { CollectionEntry } from "astro:content";
import "../../styles/home-cards.css";
import { tagHref } from "../../lib/tags.ts";
import { sectionHref, sectionLabel, sectionOf, hueOf, initialOf } from "../../lib/sections.ts";
import { fmtRelative } from "../../lib/date.ts";

interface Props {
  post: CollectionEntry<"blog">;
  /** 매거진 위계: 그리드 첫 카드를 2칸 폭 리드로. 제목·요약을 키운다. */
  wide?: boolean;
}
const { post, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sec = sectionOf(post);
---

<article class:list={["card spot-card reveal", { "card--wide": wide }]} style={`--sec-hue: ${hueOf(sec)}`}>
  <div class="card-head">
    <a class="card-badge" href={sectionHref(base, sec)} aria-label={sectionLabel(sec)}>
      {initialOf(sec)}
    </a>
    <div class="card-headtext">
      <h3 class="card-title">
        <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
      </h3>
      <span class="card-when">
        {fmtRelative(post.data.pubDate)}
      </span>
    </div>
  </div>
  {post.data.description && <p class="card-desc">{post.data.description}</p>}
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.map((t) => (
        <a class="tag" href={tagHref(base, t)}>
          {t}
        </a>
      ))}
    </div>
  )}
</article>

<style>
  /* 공통 클린 카드(.spot-card·배지·헤더)는 styles/home-cards.css.
     여기엔 '최근 글' 카드 전용 스타일만 둔다. */
  .card {
    /* 그리드가 같은 행 카드를 같은 높이로 늘리므로(align stretch), 내부를 세로 플렉스로
       두고 태그를 바닥에 붙이면 제목·요약 길이가 달라도 태그 정렬선이 맞는다. */
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .tags {
    margin-top: auto;
    padding-top: var(--space-1);
  }
  .card-title {
    font-size: var(--fs-base);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .card-desc {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
    margin: 0;
    /* 설명 길이 차로 카드 높이가 들쭉날쭉하지 않게 2줄에서 자른다 */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* ── 와이드(리드) 카드 — 그리드 첫 칸을 2열 폭으로, 제목·요약을 키워 매거진 위계를 준다. ── */
  .card--wide {
    grid-column: span 2;
  }
  /* 모바일은 그리드가 1열(index.astro의 ≤640 규칙)이라 span 2가 그대로 남으면
     암묵적 2번째 열이 생겨 그리드 전체가 짓눌린다. 1열 폭 보통 카드로 리셋한다. */
  @media (max-width: 640px) {
    .card--wide {
      grid-column: auto;
    }
  }
  .card--wide .card-title {
    font-size: var(--fs-lg);
  }
  .card--wide .card-desc {
    font-size: var(--fs-base);
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
  /* 리드 배지도 조금 키운다 */
  .card--wide :global(.card-badge) {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.3rem;
  }
</style>
