---
import type { CollectionEntry } from "astro:content";
import "../../styles/home-cards.css";
import { tagHref } from "../../lib/tags.ts";
import { sectionHref, sectionLabel, sectionOf, hueOf, initialOf } from "../../lib/sections.ts";
import { fmtRelative } from "../../lib/date.ts";
import { readMin } from "../../lib/reading.ts";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sec = sectionOf(post);
---

<article class="card spot-card reveal" style={`--sec-hue: ${hueOf(sec)}`}>
  <div class="card-head">
    <a class="card-badge" href={sectionHref(base, sec)} aria-label={sectionLabel(sec)}>
      {initialOf(sec)}
    </a>
    <div class="card-headtext">
      <h3 class="card-title">
        <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
      </h3>
      <span class="card-when">
        {fmtRelative(post.data.pubDate)} · {readMin(post.body)}분
      </span>
    </div>
  </div>
  {post.data.description && <p class="card-desc">{post.data.description}</p>}
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.map((t) => (
        <a class="tag" href={tagHref(base, t)}>
          {t}
        </a>
      ))}
    </div>
  )}
</article>

<style>
  /* 공통 클린 카드(.spot-card·배지·헤더)는 styles/home-cards.css.
     여기엔 '최근 글' 카드 전용 스타일만 둔다. */
  .card {
    /* 그리드가 같은 행 카드를 같은 높이로 늘리므로(align stretch), 내부를 세로 플렉스로
       두고 태그를 바닥에 붙이면 제목·요약 길이가 달라도 태그 정렬선이 맞는다. */
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .tags {
    margin-top: auto;
    padding-top: var(--space-1);
  }
  .card-title {
    font-size: var(--fs-base);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .card-desc {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
    margin: 0;
    /* 설명 길이 차로 카드 높이가 들쭉날쭉하지 않게 2줄에서 자른다 */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
</style>
