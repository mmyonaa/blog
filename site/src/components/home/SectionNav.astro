---
// 홈 카테고리 소개 블록 — 카드·바·맨링크가 아닌 '에디토리얼 대형 타이포'.
// 큰 아웃라인 서수(01–04)를 그래픽 요소로 깔고, 카테고리명을 디스플레이 스케일로 세운다.
// 스케일·여백·헤어라인이 디자인이 된다(사이트의 스위스 에디토리얼 결). 색은 서수 아웃라인과
// 편수에만 액센트로. 섹션 메타는 모두 lib/sections.ts에서.
import { sectionHref, hueOf, blurbOf } from "../../lib/sections.ts";

interface Props {
  sections: { id: string; label: string; count: number }[];
  base: string;
}
const { sections, base } = Astro.props;
const pad2 = (n: number) => String(n).padStart(2, "0");
---

<nav class="sec-type reveal" aria-label="카테고리">
  {
    sections.map((s, i) => (
      <a class="st-row" href={sectionHref(base, s.id)} style={`--hue: ${hueOf(s.id)}`}>
        <span class="st-num" aria-hidden="true">{pad2(i + 1)}</span>
        <span class="st-body">
          <span class="st-name">{s.label}</span>
          {blurbOf(s.id) && <span class="st-blurb">{blurbOf(s.id)}</span>}
        </span>
        <span class="st-count">
          {s.count}
          <span class="st-unit">편</span>
        </span>
        <span class="st-go" aria-hidden="true">→</span>
      </a>
    ))
  }
</nav>

<style>
  .sec-type {
    border-top: 2px solid var(--c-text);
  }
  .st-row {
    --hue-on: var(--hue, var(--c-accent));
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: clamp(0.8rem, 2.5vw, 1.5rem);
    padding: clamp(0.8rem, 2.4vw, 1.25rem) 0;
    border-bottom: 1px solid var(--c-border);
    color: var(--c-text);
    text-decoration: none;
  }
  :global(:root[data-theme="dark"]) .st-row {
    --hue-on: color-mix(in srgb, var(--hue, var(--c-accent)) 62%, white);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .st-row {
      --hue-on: color-mix(in srgb, var(--hue, var(--c-accent)) 62%, white);
    }
  }

  /* 고스트 서수 — 아웃라인만. 카테고리 색을 옅게 머금다가 호버 때 꽉 찬다. */
  .st-num {
    font-family: var(--font-mono);
    font-size: clamp(1.7rem, 4vw, 2.25rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--hue-on) 45%, var(--c-border));
    transition: -webkit-text-stroke-color 0.18s ease, color 0.18s ease;
  }
  .st-row:hover .st-num {
    color: var(--hue-on);
    -webkit-text-stroke-color: var(--hue-on);
  }

  .st-body {
    min-width: 0;
  }
  .st-name {
    display: block;
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color 0.15s ease;
  }
  .st-row:hover .st-name {
    color: var(--hue-on);
  }
  .st-blurb {
    display: block;
    margin-top: 0.4em;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--c-muted);
  }

  /* 편수 — 큰 색 숫자 */
  .st-count {
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--hue-on);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .st-unit {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-muted);
    margin-left: 0.1em;
  }

  .st-go {
    font-size: var(--fs-lg);
    color: var(--c-border);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .st-row:hover .st-go {
    color: var(--hue-on);
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .st-row:hover .st-go {
      transform: none;
    }
  }

  /* 모바일: 화살표 숨기고 편수는 아래로 안 내리고 유지(그리드 좁힘) */
  @media (max-width: 520px) {
    .st-row {
      grid-template-columns: auto 1fr auto;
    }
    .st-go {
      display: none;
    }
  }
</style>
