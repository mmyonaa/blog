---
import type { Activity } from "../../lib/activity.ts";
import ActivityHeatmap from "./ActivityHeatmap.astro";
import PopularTags from "./PopularTags.astro";

interface Props {
  /** hasPosts가 false면 통계·잔디를 통째로 숨긴다. */
  hasPosts: boolean;
  stats: { value: number; label: string; href?: string }[];
  activity: Activity;
  /** 히어로 하단에 보여줄 인기 태그(글 수 상위). 전체는 /topics/#tags. */
  topTags: { tag: string; count: number }[];
  base: string;
}
const { hasPosts, stats, activity, topTags, base } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-cols">
      <div class="hero-main">
        <h1 class="hero-title reveal"><span class="hero-title-ink">daily.mcp<span class="hero-dot" aria-hidden="true"></span></span></h1>
        <p class="hero-sub reveal">
          직접 만든 MCP 서버가 쓰고, 제가 배운 걸로 채웁니다.
        </p>
        {
          hasPosts && (
            <dl class="stats reveal">
              {stats.map((s) => (
                <div class:list={["stat", { "stat-link": s.href }]}>
                  <dt class="stat-value" data-countup={s.value}>{s.value}</dt>
                  <dd class="stat-label">
                    {s.href ? (
                      <a href={s.href} class="stat-a">{s.label}</a>
                    ) : (
                      s.label
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      {hasPosts && (
        <div class="hero-heat reveal">
          <div class="hero-heat-cap">
            <span class="hero-heat-cap-title">발행 스트릭</span>
            <span class="hero-heat-cap-meta">최근 {activity.weeks}주 · {activity.total}편</span>
          </div>
          <ActivityHeatmap activity={activity} />
        </div>
      )}
    </div>
    {topTags.length > 0 && <PopularTags tags={topTags} base={base} />}
  </div>
</section>

<script>
  // 히어로 상호작용(통계 카운트업)만 이 컴포넌트가 담당.
  // 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__heroBound) {
    (window as any).__heroBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 통계 카운트업: [data-countup]을 0→값으로. reduced-motion이면 즉시 최종값.
    const runCountUp = () => {
      document.querySelectorAll<HTMLElement>("[data-countup]").forEach((el) => {
        const target = parseInt(el.getAttribute("data-countup") || "0", 10);
        if (!Number.isFinite(target) || reduce || target <= 0) {
          el.textContent = String(Number.isFinite(target) ? target : 0);
          return;
        }
        const dur = 850;
        let startT = 0;
        el.textContent = "0";
        const tick = (now: number) => {
          if (!startT) startT = now;
          const t = Math.min(1, (now - startT) / dur);
          const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      });
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runCountUp);
  }
</script>

<style>
  /* ══════════════════════════════════════════════════════════
     히어로 — 에디토리얼 마스트헤드.
     마스트헤드 제목 · 떠 있는 통계 바 · 액자에 담긴 잔디.
     ══════════════════════════════════════════════════════════ */
  .hero {
    padding: var(--space-8) 0 var(--space-8);
  }

  /* 마스트헤드 제목 — 굵은 잉크 색. h1은 레이아웃·진입 reveal을 담당. */
  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 var(--space-3);
  }
  .hero-title-ink {
    color: var(--c-text);
  }
  /* 코랄 액센트 점 — 헤더 워드마크와 동일한 로고 마크(대형) */
  .hero-dot {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.1em;
    border-radius: 50%;
    background: var(--c-accent);
    vertical-align: 0.06em;
  }
  .hero-sub {
    color: var(--c-muted);
    font-size: var(--fs-lg);
    max-width: 42ch;
    margin: 0;
  }

  /* ── 히어로 2단: 왼쪽 제목·부제·통계 / 오른쪽 잔디 ──
     오른쪽 열 폭은 잔디 25주(25×19px − 3px = 472px)에 맞춘 값.
     주 수를 바꾸면 index.astro의 buildActivity minWeeks와 함께 조정한다. */
  .hero-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    gap: var(--space-6) var(--space-8);
    align-items: end;
  }

  /* ── 통계 바 ── 낱개 숫자에서 '떠 있는 카드'로. 구분선으로 리듬을 준다. */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) 0;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-2);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    width: max-content;
    max-width: 100%;
  }
  .stat {
    display: flex;
    flex-direction: column;
    /* 숫자를 라벨 위 중앙에 정렬 — 좌측 정렬이면 단자리 숫자(8·4)가 셀마다
       왼쪽에 쏠려 좌우 여백이 비대칭이 되고 행이 들쭉날쭉해 보인다. */
    align-items: center;
    text-align: center;
    line-height: 1.1;
    padding: 0 var(--space-5);
    border-left: 1px solid var(--c-border);
  }
  .stat:first-child {
    border-left: none;
  }
  /* 클릭 가능한 통계: 라벨 링크가 stat 전체를 덮어 숫자까지 클릭되게 */
  .stat-link {
    position: relative;
  }
  .stat-a {
    color: inherit;
    text-decoration: none;
  }
  .stat-a::after {
    content: "";
    position: absolute;
    inset: -0.2em -0.3em;
    border-radius: var(--radius-sm);
  }
  .stat-link:hover .stat-label {
    color: var(--c-accent);
  }
  .stat-value {
    font-size: var(--fs-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    margin: 0.15em 0 0;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    letter-spacing: 0.02em;
  }

  /* ── 잔디 액자 ── 오른쪽 열에 깊이를 주어 제목 열과 무게가 맞물리게. */
  .hero-heat {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-5);
  }
  /* 카드에 목적을 부여하는 캡션 헤더 — 빈 상자처럼 보이지 않게. */
  .hero-heat-cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--c-border);
  }
  .hero-heat-cap-title {
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--c-text);
  }
  .hero-heat-cap-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* 태블릿: 히어로 2단을 1단 스택으로 */
  @media (max-width: 900px) {
    .hero-cols {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  /* ── 모바일 (#27) ── */
  @media (max-width: 640px) {
    .hero {
      padding: var(--space-6) 0 var(--space-6);
    }
    /* 좁은 폭: 통계 바가 화면을 꽉 채우고 4칸이 2×2로 접히도록 균등 그리드로 전환. */
    .stats {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding: var(--space-2);
    }
    .stat {
      padding: var(--space-3) var(--space-4);
    }
    /* 2×2 격자에서 왼쪽 열만 구분선 제거(1·3번째 칸). */
    .stat:nth-child(odd) {
      border-left: none;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--c-border);
    }
    .hero-heat {
      padding: var(--space-4);
    }
  }
</style>
