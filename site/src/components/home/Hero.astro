---
import type { Activity } from "../../lib/activity.ts";
import ActivityHeatmap from "./ActivityHeatmap.astro";
import SectionPills from "./SectionPills.astro";

interface Props {
  hasPosts: boolean;
  /** 최신 글 링크. hasPosts가 false면 CTA·통계·잔디를 통째로 숨긴다. */
  featuredHref: string;
  /** RSS 안내 팝오버에 보여줄 절대 피드 주소(리더 앱에 그대로 등록하는 값) */
  feedUrl: string;
  stats: { value: number; label: string; href?: string }[];
  activity: Activity;
  sections: { id: string; label: string; count: number }[];
  base: string;
}
const { hasPosts, featuredHref, feedUrl, stats, activity, sections, base } =
  Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="blob blob-1"></span>
    <span class="blob blob-2"></span>
    <span class="blob blob-3"></span>
  </div>
  <div class="hero-inner">
    <div class="hero-cols">
      <div class="hero-main">
        <h1 class="hero-title reveal">blog</h1>
        <p class="hero-sub reveal">
          직접 만든 MCP 서버가 쓰고, 제가 배운 걸로 채웁니다.
        </p>
        {
          hasPosts && (
            <div class="hero-cta reveal">
              <a class="btn-cta" href={featuredHref}>
                최신 글 읽기 <span class="cta-arrow" aria-hidden="true">→</span>
              </a>
              <div class="rss-wrap">
                <button
                  class="btn-ghost"
                  type="button"
                  data-rss-toggle
                  aria-expanded="false"
                  aria-controls="rss-pop"
                >
                  RSS 구독
                </button>
                <div class="rss-pop" id="rss-pop" hidden>
                  <p class="rss-help">
                    RSS 리더(Feedly, Inoreader 등)에 아래 주소를 등록하면
                    새 글을 자동으로 받아볼 수 있어요.
                  </p>
                  <div class="rss-row">
                    <code class="rss-url" data-rss-url>{feedUrl}</code>
                    <button class="rss-copy" type="button" data-rss-copy>복사</button>
                  </div>
                </div>
              </div>
            </div>
          )
        }
        {
          hasPosts && (
            <dl class="stats reveal">
              {stats.map((s) => (
                <div class:list={["stat", { "stat-link": s.href }]}>
                  <dt class="stat-value" data-countup={s.value}>{s.value}</dt>
                  <dd class="stat-label">
                    {s.href ? (
                      <a href={s.href} class="stat-a">{s.label}</a>
                    ) : (
                      s.label
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      {hasPosts && <ActivityHeatmap activity={activity} />}
    </div>
    {sections.length > 0 && <SectionPills sections={sections} base={base} />}
  </div>
</section>

<script>
  // 히어로 상호작용(RSS 팝오버·통계 카운트업)만 이 컴포넌트가 담당.
  // 문서 위임 + 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__heroBound) {
    (window as any).__heroBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 통계 카운트업: [data-countup]을 0→값으로. reduced-motion이면 즉시 최종값.
    const runCountUp = () => {
      document.querySelectorAll<HTMLElement>("[data-countup]").forEach((el) => {
        const target = parseInt(el.getAttribute("data-countup") || "0", 10);
        if (!Number.isFinite(target) || reduce || target <= 0) {
          el.textContent = String(Number.isFinite(target) ? target : 0);
          return;
        }
        const dur = 850;
        let startT = 0;
        el.textContent = "0";
        const tick = (now: number) => {
          if (!startT) startT = now;
          const t = Math.min(1, (now - startT) / dur);
          const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      });
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runCountUp);

    // RSS 팝오버: 버튼으로 토글, 주소 복사, 바깥 클릭·Escape로 닫기.
    const closeRss = () => {
      const pop = document.querySelector<HTMLElement>(".rss-pop");
      if (pop && !pop.hidden) {
        pop.hidden = true;
        document
          .querySelector("[data-rss-toggle]")
          ?.setAttribute("aria-expanded", "false");
      }
    };
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const toggle = t?.closest?.<HTMLElement>("[data-rss-toggle]");
      if (toggle) {
        const pop = document.querySelector<HTMLElement>(".rss-pop");
        if (!pop) return;
        const willOpen = pop.hidden;
        pop.hidden = !willOpen;
        toggle.setAttribute("aria-expanded", String(willOpen));
        return;
      }
      const copyBtn = t?.closest?.<HTMLElement>("[data-rss-copy]");
      if (copyBtn) {
        const url =
          document.querySelector("[data-rss-url]")?.textContent?.trim() ?? "";
        navigator.clipboard?.writeText(url).then(
          () => {
            copyBtn.textContent = "복사됨!";
            setTimeout(() => {
              copyBtn.textContent = "복사";
            }, 1500);
          },
          () => {
            // 클립보드를 못 쓰는 환경이면 주소를 선택 상태로 만들어 수동 복사 유도
            const code = document.querySelector("[data-rss-url]");
            if (!code) return;
            const range = document.createRange();
            range.selectNodeContents(code);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          },
        );
        return;
      }
      if (!t?.closest?.(".rss-wrap")) closeRss();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeRss();
    });
  }
</script>

<style>
  /* ══════════════════════════════════════════════════════════
     히어로 — 오로라 블롭 배경 + 도트 패턴 + 그라디언트 제목
     ══════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    padding: var(--space-8) 0 var(--space-8);
    isolation: isolate;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }

  /* 미세 도트 패턴: 뷰포트 전체 폭(풀블리드)으로 깔고 아래로 페이드아웃.
     컨테이너 폭에 갇히지 않도록 100vw를 히어로 중심에 맞춰 배치. */
  .hero::before {
    content: "";
    position: absolute;
    top: -20%;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -2;
    background-image: radial-gradient(
      var(--c-border) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(
      120% 90% at 50% 0%,
      #000 0%,
      transparent 70%
    );
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 0%, transparent 70%);
    opacity: 0.4;
    /* 장식 레이어 — 헤더/콘텐츠 클릭을 절대 가로채지 않게 */
    pointer-events: none;
  }

  /* 오로라 블롭: 뷰포트 전체 폭(풀블리드)에 흐릿한 광원 2~3개 */
  .hero-bg {
    position: absolute;
    top: -40%;
    bottom: -20%;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.3;
    will-change: transform;
  }
  .blob-1 {
    width: 42vw;
    max-width: 460px;
    aspect-ratio: 1;
    top: -8%;
    left: -6%;
    background: radial-gradient(circle, #4e618d, transparent 68%);
  }
  .blob-2 {
    width: 34vw;
    max-width: 380px;
    aspect-ratio: 1;
    top: -14%;
    right: 4%;
    background: radial-gradient(circle, #33415c, transparent 68%);
    opacity: 0.24;
  }
  .blob-3 {
    width: 30vw;
    max-width: 340px;
    aspect-ratio: 1;
    top: 22%;
    left: 34%;
    background: radial-gradient(circle, #6a7ca0, transparent 70%);
    opacity: 0.15;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .blob {
      opacity: 0.22;
    }
    :root:not([data-theme="light"]) .hero::before {
      opacity: 0.25;
    }
  }
  :root[data-theme="dark"] .blob {
    opacity: 0.22;
  }
  :root[data-theme="dark"] .hero::before {
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: no-preference) {
    .blob-1 {
      animation: drift1 18s ease-in-out infinite alternate;
    }
    .blob-2 {
      animation: drift2 22s ease-in-out infinite alternate;
    }
    .blob-3 {
      animation: drift3 26s ease-in-out infinite alternate;
    }
  }
  @keyframes drift1 {
    to {
      transform: translate(8%, 12%) scale(1.12);
    }
  }
  @keyframes drift2 {
    to {
      transform: translate(-10%, 8%) scale(1.08);
    }
  }
  @keyframes drift3 {
    to {
      transform: translate(6%, -10%) scale(1.15);
    }
  }

  /* 제목 그라디언트 램프(--grad-*)는 global.css 토큰 — featured 카드와 공유 */
  .hero-title {
    font-size: clamp(2.75rem, 8vw, 4rem);
    /* background-clip:text에선 배경 박스 높이가 line-height라, 너무 좁으면
       'g' 같은 descender가 배경 밖으로 나가 투명 처리(잘림)된다. 여유 확보. */
    line-height: 1.18;
    padding-bottom: 0.06em;
    margin: 0 0 var(--space-3);
    background: linear-gradient(115deg, var(--grad-1) 0%, var(--grad-2) 50%, var(--grad-3) 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-title {
      animation: sheen 8s ease-in-out infinite alternate;
    }
  }
  @keyframes sheen {
    to {
      background-position: 100% center;
    }
  }
  .hero-sub {
    color: var(--c-muted);
    font-size: var(--fs-lg);
    max-width: 42ch;
    margin: 0;
  }

  /* ── 히어로 2단: 왼쪽 제목·부제·CTA·통계 / 오른쪽 잔디 ── */
  .hero-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    gap: var(--space-6) var(--space-8);
    align-items: end;
  }

  /* ── CTA ── */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
    /* reveal 애니메이션이 형제들마다 스태킹 컨텍스트를 만들므로,
       RSS 팝오버가 아래 통계·pill에 가려지지 않게 CTA 블록을 위로 올린다 */
    position: relative;
    z-index: 5;
  }
  .btn-cta,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.55em 1.1em;
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    /* <button>은 body의 line-height를 상속하지 않아 <a>보다 납작해진다 — 명시해 맞춘다 */
    line-height: inherit;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease,
      border-color 0.15s ease, transform 0.15s ease;
  }
  .btn-cta {
    background: var(--c-accent);
    color: var(--c-accent-contrast);
  }
  .btn-cta:hover {
    background: var(--c-accent-hover);
    color: var(--c-accent-contrast);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .cta-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .btn-cta:hover .cta-arrow {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-cta:hover,
    .btn-cta:hover .cta-arrow {
      transform: none;
    }
  }
  .btn-ghost {
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    color: var(--c-text);
    font-family: inherit;
    cursor: pointer;
  }
  .btn-ghost:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    text-decoration: none;
  }

  /* ── RSS 안내 팝오버 ──
     모바일: 버튼 기준 앵커는 좁은 화면에서 뷰포트를 넘치므로,
     .hero-cta(행 전체) 기준으로 행 아래 중앙에 띄운다. 데스크톱에서만 버튼 기준. */
  .rss-pop {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 50%;
    transform: translateX(-50%);
    z-index: 30;
    width: min(24rem, calc(100vw - var(--space-8)));
    padding: var(--space-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-bg);
    box-shadow: var(--shadow-md);
  }
  /* 데스크톱: 아래 통계·글을 가리지 않게 버튼 오른쪽에 띄운다 */
  @media (min-width: 901px) {
    .rss-wrap {
      position: relative;
    }
    .rss-pop {
      top: 50%;
      left: calc(100% + var(--space-3));
      transform: translateY(-50%);
    }
  }
  .rss-help {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--c-muted);
  }
  .rss-row {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
  }
  .rss-url {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    padding: 0.4em 0.6em;
    font-size: var(--fs-xs);
    white-space: nowrap;
    overflow-x: auto;
  }
  .rss-copy {
    flex: none;
    padding: 0.4em 0.9em;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--c-accent);
    color: var(--c-accent-contrast);
    font-family: inherit;
    font-size: var(--fs-xs);
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .rss-copy:hover {
    background: var(--c-accent-hover);
  }

  /* ── 통계 스트립 ── */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: var(--space-5) 0 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  /* 클릭 가능한 통계: 라벨 링크가 stat 전체를 덮어 숫자까지 클릭되게 */
  .stat-link {
    position: relative;
  }
  .stat-a {
    color: inherit;
    text-decoration: none;
  }
  .stat-a::after {
    content: "";
    position: absolute;
    inset: -0.2em -0.3em;
    border-radius: var(--radius-sm);
  }
  .stat-link:hover .stat-label {
    color: var(--c-accent);
  }
  .stat-value {
    font-size: var(--fs-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(120deg, var(--c-accent), var(--c-accent-hover));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .stat-label {
    margin: 0.15em 0 0;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    letter-spacing: 0.02em;
  }

  /* 태블릿: 히어로 2단을 1단 스택으로 */
  @media (max-width: 900px) {
    .hero-cols {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  /* ── 모바일 (#27) ── */
  @media (max-width: 640px) {
    .hero {
      padding: var(--space-6) 0 var(--space-6);
    }
    .stats {
      gap: var(--space-5);
    }
  }
</style>
