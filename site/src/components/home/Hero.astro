---
import type { Activity } from "../../lib/activity.ts";
import ActivityHeatmap from "./ActivityHeatmap.astro";
import PopularTags from "./PopularTags.astro";

interface Props {
  /** hasPosts가 false면 통계·잔디를 통째로 숨긴다. */
  hasPosts: boolean;
  stats: { value: number; label: string; href?: string }[];
  activity: Activity;
  /** 히어로 하단에 보여줄 인기 태그(글 수 상위). 전체는 /topics/#tags. */
  topTags: { tag: string; count: number }[];
  base: string;
}
const { hasPosts, stats, activity, topTags, base } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-cols">
      <div class="hero-main">
        <h1 class="hero-title reveal"><span class="hero-title-ink">daily.mcp<span class="hero-dot" aria-hidden="true"></span></span></h1>
        <p class="hero-sub reveal">
          직접 만든 MCP 서버가 쓰고, 제가 배운 걸로 채웁니다.
        </p>
        {
          hasPosts && (
            <dl class="stats reveal">
              {stats.map((s) => (
                <div class:list={["stat", { "stat-link": s.href }]}>
                  <dt class="stat-value" data-countup={s.value}>{s.value}</dt>
                  <dd class="stat-label">
                    {s.href ? (
                      <a href={s.href} class="stat-a">{s.label}</a>
                    ) : (
                      s.label
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      {hasPosts && (
        <div class="hero-heat reveal">
          <div class="hero-heat-cap">
            <span class="hero-heat-cap-title">발행 스트릭</span>
            <span class="hero-heat-cap-meta">최근 {activity.weeks}주 · {activity.total}편</span>
          </div>
          <ActivityHeatmap activity={activity} />
        </div>
      )}
    </div>
    {topTags.length > 0 && <PopularTags tags={topTags} base={base} />}
  </div>
</section>

<script>
  // 히어로 상호작용(통계 카운트업)만 이 컴포넌트가 담당.
  // 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__heroBound) {
    (window as any).__heroBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 통계 카운트업: [data-countup]을 0→값으로. reduced-motion이면 즉시 최종값.
    const runCountUp = () => {
      document.querySelectorAll<HTMLElement>("[data-countup]").forEach((el) => {
        const target = parseInt(el.getAttribute("data-countup") || "0", 10);
        if (!Number.isFinite(target) || reduce || target <= 0) {
          el.textContent = String(Number.isFinite(target) ? target : 0);
          return;
        }
        const dur = 850;
        let startT = 0;
        el.textContent = "0";
        const tick = (now: number) => {
          if (!startT) startT = now;
          const t = Math.min(1, (now - startT) / dur);
          const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      });
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runCountUp);
  }
</script>

<style>
  /* ══════════════════════════════════════════════════════════
     히어로 — 에디토리얼 마스트헤드.
     마스트헤드 제목 · 떠 있는 통계 바 · 액자에 담긴 잔디.
     ══════════════════════════════════════════════════════════ */
  .hero {
    padding: var(--space-8) 0 var(--space-8);
  }

  /* 마스트헤드 제목 — 굵은 잉크 색. h1은 레이아웃·진입 reveal을 담당. */
  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 var(--space-3);
  }
  .hero-title-ink {
    color: var(--c-text);
  }
  /* 코랄 액센트 점 — 헤더 워드마크와 동일한 로고 마크(대형) */
  .hero-dot {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.1em;
    border-radius: 50%;
    background: var(--c-accent);
    vertical-align: 0.06em;
  }
  .hero-sub {
    color: var(--c-muted);
    font-size: var(--fs-lg);
    max-width: 42ch;
    margin: 0;
  }

  /* ── 히어로 2단: 왼쪽 제목·부제·통계 / 오른쪽 잔디 ──
     오른쪽 열 폭은 잔디 25주(25×19px − 3px = 472px)에 맞춘 값.
     주 수를 바꾸면 index.astro의 buildActivity minWeeks와 함께 조정한다. */
  .hero-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    gap: var(--space-6) var(--space-8);
    align-items: end;
  }

  /* ── 통계 바 ── 낱개 숫자에서 '떠 있는 카드'로.
     터미널 리드아웃 톤: 카드 상단에 모노 캡션 프롬프트, 첫 통계에 코랄 앵커,
     짧은 중앙 구분선으로 리듬을 준다. */
  .stats {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) 0;
    /* 상단 프롬프트 라벨 자리(::before)만큼 위쪽 패딩을 더 준다. */
    margin: var(--space-6) 0 0;
    padding: calc(var(--space-4) + 0.9rem) var(--space-3) var(--space-4);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    width: max-content;
    max-width: 100%;
  }
  /* 카드 상단 '프롬프트' 캡션 — 터미널 상태줄처럼 코랄 마크 + 모노 라벨.
     통계 바에 daily.mcp의 코드 정체성을 심는 한 줄. */
  .stats::before {
    content: "stats --live";
    position: absolute;
    top: var(--space-3);
    left: var(--space-5);
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--c-muted);
    opacity: 0.85;
    /* 앞의 코랄 점 = 살아있는 표시. */
    padding-left: 0.95em;
  }
  .stats::after {
    content: "";
    position: absolute;
    top: calc(var(--space-3) + 0.34rem);
    left: var(--space-5);
    width: 0.42em;
    height: 0.42em;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 0.14em var(--c-accent-soft);
  }
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    /* 숫자를 라벨 위 중앙에 정렬 — 좌측 정렬이면 단자리 숫자(8·4)가 셀마다
       왼쪽에 쏠려 좌우 여백이 비대칭이 되고 행이 들쭉날쭉해 보인다. */
    align-items: center;
    text-align: center;
    line-height: 1.1;
    padding: 0 var(--space-5);
  }
  /* 짧은 중앙 구분선 — 셀 전체를 가르는 풀높이 선 대신 리듬만 주는 하프라인.
     위아래로 페이드아웃해 딱딱한 1px 선보다 부드럽게. */
  .stat:not(:first-child)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 2.4em;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--c-border) 22%,
      var(--c-border) 78%,
      transparent
    );
  }
  /* 클릭 가능한 통계: 라벨 링크가 stat 전체를 덮어 숫자까지 클릭되게 */
  .stat-link {
    position: relative;
  }
  .stat-a {
    color: inherit;
    text-decoration: none;
  }
  .stat-a::after {
    content: "";
    position: absolute;
    inset: -0.2em -0.3em;
    border-radius: var(--radius-sm);
  }
  .stat-link:hover .stat-label {
    color: var(--c-accent);
  }
  .stat-value {
    /* 마스트헤드·워드마크와 같은 모노 폰트 — 통계를 daily.mcp 정체성에 묶는다. */
    font-family: var(--font-mono);
    font-size: var(--fs-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }
  /* 첫 통계 = 시선 고정점. 코랄로 물들이고 아래 짧은 밑줄 틱으로 앵커링. */
  .stat:first-child .stat-value {
    color: var(--c-accent);
  }
  .stat-label {
    position: relative;
    margin: 0.5em 0 0;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    /* 에디토리얼 캡션 톤 — 넉넉한 트래킹으로 숫자와 리듬을 분리. */
    letter-spacing: 0.08em;
  }

  /* ── 잔디 액자 ── 오른쪽 열에 깊이를 주어 제목 열과 무게가 맞물리게. */
  .hero-heat {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-5);
  }
  /* 카드에 목적을 부여하는 캡션 헤더 — 빈 상자처럼 보이지 않게. */
  .hero-heat-cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--c-border);
  }
  .hero-heat-cap-title {
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--c-text);
  }
  .hero-heat-cap-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* 태블릿: 히어로 2단을 1단 스택으로. 통계 바는 반쪽으로 뜨지 않고 폭을 꽉 채워
     아래 잔디 액자와 좌우 정렬을 맞춘다(4칸 균등 분할). */
  @media (max-width: 900px) {
    .hero-cols {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .stats {
      width: 100%;
    }
    .stat {
      flex: 1;
    }
  }

  /* ── 모바일 (#27) ──
     랜딩 first-fold를 히어로가 통째로 삼키지 않도록: 제목 스케일을 낮추고, 통계는
     낮은 스트립으로, 잔디는 시각 비중을 줄여 실제 글이 더 빨리 보이게 한다. 톤은 유지. */
  @media (max-width: 640px) {
    .hero {
      padding: var(--space-5) 0 var(--space-4);
    }
    /* 큰 마스트헤드가 첫 화면을 잡아먹지 않게 모바일 한정으로 축소(데스크톱 유지). */
    .hero-title {
      font-size: clamp(1.9rem, 8.5vw, 2.4rem);
      margin-bottom: var(--space-2);
    }
    /* 서브카피도 한 톤 낮춰 제목과의 대비를 차분하게. */
    .hero-sub {
      font-size: var(--fs-base);
    }
    .hero-cols {
      gap: var(--space-4);
    }
    /* 좁은 폭: 통계 바가 화면을 꽉 채우고 4칸이 2×2로. 큰 히어로 카드가 아니라
       낮고 컴팩트한 스트립으로 — 숫자·패딩을 줄여 높이를 낮춘다.
       상단 프롬프트 캡션 자리는 유지(위쪽 패딩). */
    .stats {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      margin-top: var(--space-4);
      padding: calc(var(--space-2) + 0.9rem) var(--space-1) var(--space-2);
    }
    .stats::before {
      left: var(--space-4);
    }
    .stats::after {
      left: var(--space-4);
    }
    .stat {
      padding: var(--space-3) var(--space-3);
    }
    .stat-value {
      font-size: var(--fs-xl);
    }
    /* 2×2 격자: 열 사이엔 세로 구분선(짝수 칸 왼쪽), 행 사이엔 가로 하프라인.
       기본 ::before 세로선은 왼쪽 열(홀수)에서 숨기고 오른쪽 열에서만 보인다. */
    .stat:nth-child(odd)::before {
      display: none;
    }
    .stat:nth-child(n + 3)::after {
      content: "";
      position: absolute;
      top: 0;
      left: 10%;
      right: 10%;
      height: 1px;
      background: linear-gradient(
        to right,
        transparent,
        var(--c-border) 20%,
        var(--c-border) 80%,
        transparent
      );
    }
    /* 잔디 액자: 랜딩 최우선이 아니므로 패딩·캡션 여백을 줄여 비중을 낮춘다. */
    .hero-heat {
      padding: var(--space-3) var(--space-4);
    }
    .hero-heat-cap {
      margin-bottom: var(--space-3);
      padding-bottom: var(--space-2);
    }
  }
</style>
