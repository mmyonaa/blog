---
import type { Activity } from "../../lib/activity.ts";
import ActivityHeatmap from "./ActivityHeatmap.astro";
import PopularTags from "./PopularTags.astro";

interface Props {
  /** hasPosts가 false면 통계·잔디를 통째로 숨긴다. */
  hasPosts: boolean;
  stats: { value: number; label: string; href?: string }[];
  activity: Activity;
  /** 히어로 하단에 보여줄 인기 태그(글 수 상위). 전체는 /topics/#tags. */
  topTags: { tag: string; count: number }[];
  base: string;
}
const { hasPosts, stats, activity, topTags, base } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-cols">
      <div class="hero-main">
        <h1 class="hero-title reveal">blog</h1>
        <p class="hero-sub reveal">
          직접 만든 MCP 서버가 쓰고, 제가 배운 걸로 채웁니다.
        </p>
        {
          hasPosts && (
            <dl class="stats reveal">
              {stats.map((s) => (
                <div class:list={["stat", { "stat-link": s.href }]}>
                  <dt class="stat-value" data-countup={s.value}>{s.value}</dt>
                  <dd class="stat-label">
                    {s.href ? (
                      <a href={s.href} class="stat-a">{s.label}</a>
                    ) : (
                      s.label
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      {hasPosts && <ActivityHeatmap activity={activity} />}
    </div>
    {topTags.length > 0 && <PopularTags tags={topTags} base={base} />}
  </div>
</section>

<script>
  // 히어로 상호작용(통계 카운트업)만 이 컴포넌트가 담당.
  // 전역 가드로 한 번만 등록(View Transitions 유지).
  if (!(window as any).__heroBound) {
    (window as any).__heroBound = true;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 통계 카운트업: [data-countup]을 0→값으로. reduced-motion이면 즉시 최종값.
    const runCountUp = () => {
      document.querySelectorAll<HTMLElement>("[data-countup]").forEach((el) => {
        const target = parseInt(el.getAttribute("data-countup") || "0", 10);
        if (!Number.isFinite(target) || reduce || target <= 0) {
          el.textContent = String(Number.isFinite(target) ? target : 0);
          return;
        }
        const dur = 850;
        let startT = 0;
        el.textContent = "0";
        const tick = (now: number) => {
          if (!startT) startT = now;
          const t = Math.min(1, (now - startT) / dur);
          const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      });
    };
    // View Transitions로 홈에 재진입할 때마다 다시 실행(최초 로드 포함).
    document.addEventListener("astro:page-load", runCountUp);
  }
</script>

<style>
  /* ══════════════════════════════════════════════════════════
     히어로 — 스위스 에디토리얼. 블롭·도트·그라디언트 장식 없이 타이포와 여백으로.
     ══════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    padding: var(--space-8) 0 var(--space-8);
    isolation: isolate;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }

  /* 잉크 제목 — 그라디언트·sheen 없이 굵고 납작하게, 마스트헤드처럼. */
  .hero-title {
    font-size: clamp(2.75rem, 8vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 800;
    margin: 0 0 var(--space-3);
    color: var(--c-text);
  }
  .hero-sub {
    color: var(--c-muted);
    font-size: var(--fs-lg);
    max-width: 42ch;
    margin: 0;
  }

  /* ── 히어로 2단: 왼쪽 제목·부제·통계 / 오른쪽 잔디 ──
     오른쪽 열 폭은 잔디 25주(25×19px − 3px = 472px)에 맞춘 값.
     주 수를 바꾸면 index.astro의 buildActivity minWeeks와 함께 조정한다. */
  .hero-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
    gap: var(--space-6) var(--space-8);
    align-items: end;
  }

  /* ── 통계 스트립 ── */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: var(--space-5) 0 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  /* 클릭 가능한 통계: 라벨 링크가 stat 전체를 덮어 숫자까지 클릭되게 */
  .stat-link {
    position: relative;
  }
  .stat-a {
    color: inherit;
    text-decoration: none;
  }
  .stat-a::after {
    content: "";
    position: absolute;
    inset: -0.2em -0.3em;
    border-radius: var(--radius-sm);
  }
  .stat-link:hover .stat-label {
    color: var(--c-accent);
  }
  .stat-value {
    font-size: var(--fs-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    margin: 0.15em 0 0;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    letter-spacing: 0.02em;
  }

  /* 태블릿: 히어로 2단을 1단 스택으로 */
  @media (max-width: 900px) {
    .hero-cols {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  /* ── 모바일 (#27) ── */
  @media (max-width: 640px) {
    .hero {
      padding: var(--space-6) 0 var(--space-6);
    }
    .stats {
      gap: var(--space-5);
    }
  }
</style>
