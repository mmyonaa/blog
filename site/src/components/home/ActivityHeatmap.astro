---
import { heatLevel, HEAT_LEGEND, dayKey, type Activity } from "../../lib/activity.ts";

/** 잔디 클릭 패널용 — 그날 발행한 글 한 편(제목·링크·카테고리 라벨/색).
 *  페이지가 .hm-days-data JSON(dayKey → DayPost[])과 .hm-day 패널 마크업을 심으면
 *  이 컴포넌트의 클릭 핸들러가 채운다(툴팁과 같은 문서 전역 조회 문법). */
export interface DayPost {
  t: string;
  h: string;
  s: string;
  c: string;
}

interface Props {
  activity: Activity;
}
const { activity } = Astro.props;
---

<section class="activity reveal" aria-label="발행 활동">
  <div class="heatmap" role="img" aria-label={`최근 ${activity.weeks}주 발행 활동 · 총 ${activity.total}편`}>
    <div class="heatmap-months" style={`--weeks: ${activity.weeks}`}>
      {activity.months.map((m) => (
        <span class="hm-month" style={`grid-column: ${m.col} / span ${m.span}`}>
          {m.name}
        </span>
      ))}
    </div>
    <div class="heatmap-grid" style={`--weeks: ${activity.weeks}`}>
      {activity.cells.map((c) => (
        <span
          class:list={["hm-cell", `lv${heatLevel(c.count)}`, { "hm-future": c.future }]}
          data-tip={c.future ? undefined : `${c.date.getFullYear()}. ${c.date.getMonth() + 1}. ${c.date.getDate()}. · ${c.count}편`}
          data-day={c.count > 0 ? dayKey(c.date) : undefined}
        />
      ))}
    </div>
  </div>
  <div class="heatmap-legend">
    <span>적음</span>
    {HEAT_LEGEND.map((l) => (
      <span class={`hm-cell lv${l.lv}`} data-tip={l.label} />
    ))}
    <span>많음</span>
  </div>
  <div class="hm-tip" role="status" aria-live="polite" hidden></div>
</section>

<script>
  // 잔디 관련 상호작용만 이 컴포넌트가 담당. 문서 위임 + 전역 가드로 한 번만 등록
  // (View Transitions 유지).
  if (!(window as any).__heatmapBound) {
    (window as any).__heatmapBound = true;

    // 잔디 칸/범례 호버 툴팁: '날짜 · N편'(칸) 또는 레벨 범위(범례)를 표시.
    // 툴팁은 .activity 기준 absolute. (.activity가 reveal 애니메이션으로 항등 transform을
    // 남겨 containing block이 되므로, 그 기준으로 좌표를 계산해야 어긋나지 않는다.)
    const showTip = (cell: HTMLElement) => {
      // 한 페이지에 잔디가 여러 벌(전체/최근 토글)일 수 있어 자기 인스턴스의 툴팁을 쓴다.
      const host = cell.closest<HTMLElement>(".activity");
      const tip = host?.querySelector<HTMLElement>(".hm-tip");
      const text = cell.getAttribute("data-tip");
      if (!tip || !host || !text) return;
      tip.textContent = text;
      tip.hidden = false;
      const c = cell.getBoundingClientRect();
      const h = host.getBoundingClientRect();
      const t = tip.getBoundingClientRect();
      tip.style.left = `${c.left - h.left + c.width / 2 - t.width / 2}px`;
      const above = c.top - h.top - t.height - 6;
      // 카드 위로 넘치면 칸 아래에 표시
      tip.style.top = `${above < 0 ? c.bottom - h.top + 6 : above}px`;
    };
    const hideTip = () => {
      document.querySelectorAll<HTMLElement>(".hm-tip").forEach((t) => (t.hidden = true));
    };
    document.addEventListener("pointerover", (e) => {
      const cell = (e.target as HTMLElement)?.closest?.<HTMLElement>(".hm-cell[data-tip]");
      if (cell) showTip(cell);
    });
    document.addEventListener("pointerout", (e) => {
      const cell = (e.target as HTMLElement)?.closest?.<HTMLElement>(".hm-cell[data-tip]");
      if (cell) hideTip();
    });

    // 잔디 클릭 → 그날 발행한 글 목록 패널(.hm-day). 데이터는 SSG가 심은 JSON.
    document.addEventListener("click", (e) => {
      const cell = (e.target as HTMLElement)?.closest?.<HTMLElement>(".hm-cell[data-day]");
      if (!cell) return;
      // 패널·JSON은 페이지가 심는다(없으면 클릭 무시) — 툴팁과 같은 전역 조회 문법.
      const data = document.querySelector(".hm-days-data")?.textContent;
      const panel = document.querySelector<HTMLElement>(".hm-day");
      if (!data || !panel) return;
      const posts = JSON.parse(data)[cell.dataset.day!] ?? [];
      const esc = (s: string) =>
        s.replace(/[&<>"]/g, (ch) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch]!,
        );
      panel.querySelector(".hm-day-date")!.textContent =
        `${cell.getAttribute("data-tip")}`;
      panel.querySelector(".hm-day-list")!.innerHTML = posts
        .map(
          (p: { t: string; h: string; s: string; c: string }) =>
            `<li style="--hue:${esc(p.c)}"><span class="hm-day-sec">${esc(p.s)}</span><a href="${esc(p.h)}">${esc(p.t)}</a></li>`,
        )
        .join("");
      panel.hidden = false;
      // 같은 칸 재클릭 시 토글
      if (panel.dataset.day === cell.dataset.day) {
        panel.hidden = true;
        panel.dataset.day = "";
      } else {
        panel.dataset.day = cell.dataset.day!;
      }
    });
  }
</script>

<style>
  /* ── 발행 스트릭 잔디(heatmap) ── */
  /* 2단 배치에선 오른쪽 열 하단 정렬이라 위 여백이 필요 없다(스택 시 복원) */
  .activity {
    position: relative;
    margin-top: 0;
    max-width: 100%;
    /* 그리드/플렉스 자식으로 쓰일 때 내용(잔디 고정폭)이 컬럼을 밀어내지 않게. */
    min-width: 0;
  }
  .heatmap {
    padding-bottom: 2px;
  }
  /* 월 라벨과 칸 격자는 같은 열 폭 규칙(상한 16px)을 써서 정렬을 맞춘다.
     넓은 화면에선 16px 고정과 동일하고, 컨테이너가 그보다 좁으면 열이
     균등하게 줄어들어 가로 스크롤 없이 항상 화면 폭에 맞는다. */
  .heatmap-months {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 16px));
    gap: 3px;
    margin-bottom: 5px;
  }
  .hm-month {
    font-size: 0.7rem;
    line-height: 1;
    color: var(--c-muted);
    white-space: nowrap;
    overflow: visible;
  }
  .heatmap-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, auto);
    grid-auto-columns: minmax(0, 16px);
    gap: 3px;
  }
  .hm-cell {
    border-radius: 4px;
    background: var(--c-surface-2);
  }
  /* 격자 칸: 열 폭을 따라가되 정사각형 유지(범례 칸은 아래에서 고정 크기) */
  .heatmap-grid .hm-cell {
    width: 100%;
    aspect-ratio: 1;
  }
  .hm-cell.lv1 {
    background: color-mix(in srgb, var(--c-accent) 32%, var(--c-surface-2));
  }
  .hm-cell.lv2 {
    background: color-mix(in srgb, var(--c-accent) 62%, var(--c-surface-2));
  }
  .hm-cell.lv3 {
    background: var(--c-accent);
  }
  .hm-future {
    visibility: hidden;
  }
  .heatmap-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: var(--space-3);
    font-size: 0.7rem;
    color: var(--c-muted);
  }
  .heatmap-legend .hm-cell {
    width: 13px;
    height: 13px;
  }
  /* 잔디 칸/범례 호버 툴팁 */
  .hm-cell[data-tip] {
    cursor: pointer;
  }
  .hm-tip {
    position: absolute;
    z-index: 50;
    padding: 0.35em 0.6em;
    border-radius: var(--radius-sm);
    background: var(--c-text);
    color: var(--c-bg);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: var(--shadow-md);
  }
  .hm-tip[hidden] {
    display: none;
  }

  /* 히어로 2단이 1단으로 스택되면(≤900px) 위 블록과의 간격 복원 */
  @media (max-width: 900px) {
    .activity {
      margin-top: var(--space-6);
    }
  }
  /* 모바일: 잔디 비중을 낮춘다 — 범례 간격을 좁혀 카드 높이를 줄인다. */
  @media (max-width: 640px) {
    .heatmap-legend {
      margin-top: var(--space-2);
    }
  }
</style>
