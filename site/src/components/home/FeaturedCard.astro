---
import type { CollectionEntry } from "astro:content";
import "../../styles/home-cards.css";
import { tagHref } from "../../lib/tags.ts";
import { sectionHref, sectionLabel, sectionOf, hueOf } from "../../lib/sections.ts";
import { fmtDate } from "../../lib/date.ts";
import { readMin } from "../../lib/reading.ts";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sec = sectionOf(post);

// NEW 배지: 빌드 시점 기준 7일 이내 글일 때만.
const NEW_BADGE_DAYS = 7;
const isNew =
  Date.now() - post.data.pubDate.valueOf() < NEW_BADGE_DAYS * 24 * 60 * 60 * 1000;
---

<article class="featured spot-card reveal" style={`--sec-hue: ${hueOf(sec)}`}>
  <div class="featured-meta">
    <span class="featured-label">
      {isNew && <span class="badge-new">NEW</span>}
      FEATURED · <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time> · {readMin(post.body)}분
    </span>
    <a class="card-sec" href={sectionHref(base, sec)}>
      <span class="sec-dot" aria-hidden="true" />
      {sectionLabel(sec)}
    </a>
  </div>
  <h2 class="featured-title">
    <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
  </h2>
  {post.data.description && <p class="featured-desc">{post.data.description}</p>}
  <span class="read">읽기 <span class="read-arrow" aria-hidden="true">→</span></span>
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.map((t) => (
        <a class="tag" href={tagHref(base, t)}>
          {t}
        </a>
      ))}
    </div>
  )}
</article>

<style>
  /* 공통 카드 룩(카테고리 색 상단 룰·플랫)은 styles/home-cards.css(.spot-card).
     여기엔 featured 전용 강조만 둔다 — 배경·그림자·둥근 모서리 없이 타이포로 승부. */
  .featured {
    /* 리드 기사에만 카테고리 색 상단 룰을 둔다(반복 카드엔 없음). 여백은 넓게. */
    border-top: 2px solid var(--sec-on);
    padding: var(--space-5) 0 var(--space-6);
  }
  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .featured-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--c-muted);
    font-size: var(--fs-xs);
    font-weight: 700;
    /* 신문 킥커: 대문자 + 넓은 자간 */
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .badge-new {
    padding: 0.1em 0.45em;
    /* 알약·그라디언트 없이 각진 잉크 라벨 */
    background: var(--c-text);
    color: var(--c-bg);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .featured-title {
    font-size: var(--fs-3xl);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: var(--space-3) 0 var(--space-3);
  }
  .featured-desc {
    color: var(--c-muted);
    max-width: 60ch;
    margin: 0 0 var(--space-4);
  }
  .read {
    display: inline-block;
    color: var(--c-text);
    font-weight: 700;
    border-bottom: 2px solid var(--sec-on);
    padding-bottom: 0.1em;
    margin-bottom: var(--space-4);
  }
  .featured:hover .read {
    color: var(--sec-on);
  }
  .read-arrow {
    display: inline-block;
  }

  /* 모바일: 상단 룰과 본문 간격만 살짝 좁힘 */
  @media (max-width: 640px) {
    .featured {
      padding: var(--space-4) 0 var(--space-5);
    }
    .featured-title {
      font-size: var(--fs-2xl);
    }
  }
</style>
