---
import type { CollectionEntry } from "astro:content";
import "../../styles/home-cards.css";
import { tagHref } from "../../lib/tags.ts";
import { sectionHref, sectionLabel, sectionOf, hueOf } from "../../lib/sections.ts";
import { fmtDate } from "../../lib/date.ts";
import { readMin } from "../../lib/reading.ts";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sec = sectionOf(post);

// NEW 배지: 빌드 시점 기준 7일 이내 글일 때만.
const NEW_BADGE_DAYS = 7;
const isNew =
  Date.now() - post.data.pubDate.valueOf() < NEW_BADGE_DAYS * 24 * 60 * 60 * 1000;
---

<article class="featured spot-card reveal" style={`--sec-hue: ${hueOf(sec)}`}>
  <div class="card-bar featured-bar">
    <span class="card-dot" aria-hidden="true" />
    <a class="card-sec" href={sectionHref(base, sec)}>{sectionLabel(sec)}</a>
    <span class="featured-kicker">
      FEATURED{isNew && <span class="badge-new">NEW</span>}
    </span>
  </div>
  <div class="featured-body">
    <span class="featured-when">
      <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time> · {readMin(post.body)}분
    </span>
    <h2 class="featured-title">
      <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
    </h2>
    {post.data.description && <p class="featured-desc">{post.data.description}</p>}
    {post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map((t) => (
          <a class="tag" href={tagHref(base, t)}>
            {t}
          </a>
        ))}
      </div>
    )}
    <span class="read">읽기 <span class="read-arrow" aria-hidden="true">→</span></span>
  </div>
</article>

<style>
  /* 공통 터미널 룩(.spot-card·헤더 바·마커)은 styles/home-cards.css.
     featured는 그 위에 얹는 큰 '리드' 터미널 창 — 헤더에 FEATURED 킥커, 넓은 본문. */
  .featured-bar {
    /* 헤더 바를 리드답게 조금 더 도톰하게 */
    padding: 0.6em 1em;
  }
  .featured-kicker {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--c-muted);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .badge-new {
    color: var(--sec-on);
    letter-spacing: 0.08em;
  }
  .badge-new::before { content: "["; opacity: 0.6; }
  .badge-new::after { content: "]"; opacity: 0.6; }
  .featured-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) clamp(1em, 3vw, 1.75em) var(--space-5);
  }
  .featured-when {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .featured-when::before { content: "// "; opacity: 0.7; }
  .featured-title {
    font-size: var(--fs-2xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .featured-desc {
    color: var(--c-muted);
    line-height: 1.6;
    max-width: 70ch;
    margin: 0;
  }
  .featured-desc::before { content: "> "; color: var(--sec-on); }
  .read {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    color: var(--sec-on);
    font-weight: 700;
    margin-top: var(--space-1);
  }
  .read::before { content: "$ "; opacity: 0.7; }
  .read-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .featured:hover .read-arrow {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .featured:hover .read-arrow { transform: none; }
  }

  @media (max-width: 640px) {
    .featured-title {
      font-size: var(--fs-xl);
    }
  }
</style>
