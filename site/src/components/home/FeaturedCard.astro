---
import type { CollectionEntry } from "astro:content";
import "../../styles/home-cards.css";
import { tagHref } from "../../lib/tags.ts";
import { sectionHref, sectionLabel, sectionOf, hueOf, initialOf } from "../../lib/sections.ts";
import { fmtDate } from "../../lib/date.ts";
import { readMin } from "../../lib/reading.ts";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sec = sectionOf(post);

// NEW 배지: 빌드 시점 기준 7일 이내 글일 때만.
const NEW_BADGE_DAYS = 7;
const isNew =
  Date.now() - post.data.pubDate.valueOf() < NEW_BADGE_DAYS * 24 * 60 * 60 * 1000;
---

<article class="featured spot-card reveal" style={`--sec-hue: ${hueOf(sec)}`}>
  <div class="featured-head">
    <a class="card-badge" href={sectionHref(base, sec)} aria-label={sectionLabel(sec)}>
      {initialOf(sec)}
    </a>
    {isNew && <span class="badge-new">NEW</span>}
    <h2 class="featured-title">
      <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
    </h2>
    <span class="featured-when">
      <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time> · {readMin(post.body)}분
    </span>
  </div>
  {post.data.description && <p class="featured-desc">{post.data.description}</p>}
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.map((t) => (
        <a class="tag" href={tagHref(base, t)}>
          {t}
        </a>
      ))}
    </div>
  )}
  <span class="read">읽기 <span class="read-arrow" aria-hidden="true">→</span></span>
</article>

<style>
  /* 공통 클린 카드(.spot-card·배지·헤더)는 styles/home-cards.css.
     featured는 그 위에 얹는 큰 '리드' 카드 — 넓은 패딩, 큰 배지·제목. */
  .featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5) clamp(1.1rem, 3vw, 1.9rem);
  }
  /* 헤더 그리드: 이니셜 배지(col 1)를 제목 행에 아래끝 정렬.
     NEW·제목·날짜는 col 2에 쌓아 제목 기준으로 들여쓴다. */
  .featured-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
    row-gap: 0.15em;
    align-items: start;
  }
  .featured-head .card-badge {
    grid-column: 1;
    grid-row: 2; /* 제목 행 */
    align-self: end; /* 배지 아래끝 = 제목 아래끝 */
  }
  .featured-head .badge-new {
    grid-column: 2;
    grid-row: 1;
  }
  .featured-head .featured-title {
    grid-column: 2;
    grid-row: 2;
    margin: 0; /* 배지 아래끝을 제목 텍스트 아래끝에 정확히 맞춤(마진은 row-gap이 대신) */
  }
  .featured-head .featured-when {
    grid-column: 2;
    grid-row: 3;
  }
  /* 리드 배지는 조금 더 크게 */
  .featured .card-badge {
    width: 3rem;
    height: 3rem;
    font-size: 1.4rem;
    border-radius: var(--radius-md);
  }
  /* NEW — 배경 없이 코랄 텍스트 + 깜빡이는(펄스) 라이브 도트 */
  .badge-new {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--c-accent);
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .badge-new::before {
    content: "";
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--c-accent);
    animation: new-blink 1.3s ease-in-out infinite;
  }
  @keyframes new-blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.25; transform: scale(0.7); }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-new::before { animation: none; }
  }
  .featured-title {
    font-size: var(--fs-xl);
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0.1em 0;
    text-wrap: balance;
  }
  .featured-desc {
    color: var(--c-muted);
    line-height: 1.6;
    max-width: 70ch;
    margin: 0;
  }
  .read {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    color: var(--sec-on);
    font-weight: 700;
  }
  .read-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .featured:hover .read-arrow {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .featured:hover .read-arrow { transform: none; }
  }

  @media (max-width: 640px) {
    .featured-title {
      font-size: var(--fs-lg);
    }
  }
</style>
