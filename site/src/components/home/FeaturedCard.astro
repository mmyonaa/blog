---
import type { CollectionEntry } from "astro:content";
import "../../styles/home-cards.css";
import { tagHref } from "../../lib/tags.ts";
import { sectionHref, sectionLabel, sectionOf, hueOf } from "../../lib/sections.ts";
import { fmtDate } from "../../lib/date.ts";
import { readMin } from "../../lib/reading.ts";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sec = sectionOf(post);

// NEW 배지: 빌드 시점 기준 7일 이내 글일 때만.
const NEW_BADGE_DAYS = 7;
const isNew =
  Date.now() - post.data.pubDate.valueOf() < NEW_BADGE_DAYS * 24 * 60 * 60 * 1000;
---

<article class="featured spot-card reveal" style={`--sec-hue: ${hueOf(sec)}`}>
  <div class="card-top featured-top">
    <a class="card-section" href={sectionHref(base, sec)}>{sectionLabel(sec)}</a>
    <span class="featured-kicker">
      FEATURED{isNew && <span class="badge-new">NEW</span>}
    </span>
  </div>
  <span class="featured-when">
    <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time> · {readMin(post.body)}분
  </span>
  <h2 class="featured-title">
    <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
  </h2>
  {post.data.description && <p class="featured-desc">{post.data.description}</p>}
  {post.data.tags.length > 0 && (
    <div class="tags">
      {post.data.tags.map((t) => (
        <a class="tag" href={tagHref(base, t)}>
          {t}
        </a>
      ))}
    </div>
  )}
  <span class="read">읽기 <span class="read-arrow" aria-hidden="true">→</span></span>
</article>

<style>
  /* 공통 브루탈 룩(.spot-card·보더·하드 섀도·카테고리 블록)은 styles/home-cards.css.
     featured는 그 위에 얹는 큰 '리드' 브루탈 카드 — 도톰한 보더/섀도, 큰 굵은 제목. */
  .featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) clamp(1.1rem, 3vw, 1.9rem);
    /* 리드답게 보더·섀도를 한 단계만 더 */
    border-width: 2px;
    box-shadow: 4px 4px 0 var(--bru-ink);
  }
  .featured:hover {
    box-shadow: 6px 6px 0 var(--sec-on);
  }
  .featured-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .badge-new {
    background: var(--bru-ink);
    color: var(--c-bg);
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.1em 0.4em;
  }
  .featured-title {
    font-size: var(--fs-3xl);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .featured-desc {
    color: var(--c-muted);
    line-height: 1.6;
    max-width: 70ch;
    margin: 0;
  }
  /* 브루탈 CTA 버튼 — 각진 보더 + 작은 하드 섀도, hover 시 카테고리색 반전 */
  .read {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-1);
    padding: 0.4em 0.9em;
    border: 1.5px solid var(--bru-ink);
    background: var(--c-bg);
    color: var(--c-text);
    font-weight: 800;
    box-shadow: 2px 2px 0 var(--bru-ink);
  }
  .featured:hover .read {
    background: var(--sec-on);
    color: var(--c-bg);
  }
  .read-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .featured:hover .read-arrow {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .featured:hover .read-arrow { transform: none; }
  }

  @media (max-width: 640px) {
    .featured-title {
      font-size: var(--fs-2xl);
    }
  }
</style>
