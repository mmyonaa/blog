---
import type { CollectionEntry } from "astro:content";
import { tagHref } from "../lib/tags.ts";
import { fmtDateTime } from "../lib/date.ts";
import { sectionLabel, sectionHref, hueOf, sectionOf } from "../lib/sections.ts";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

/** 카드는 높이를 맞추므로 태그가 많아도 앞 3개만 노출(넘치면 +N). */
const TAG_MAX = 3;
---

<ul class="post-cards">
  {
    posts.map((post) => {
      const section = sectionOf(post);
      const tags = post.data.tags.slice(0, TAG_MAX);
      const overflow = post.data.tags.length - tags.length;
      return (
        <li class="card" style={`--hue: ${hueOf(section)}`}>
          <div class="card-bar">
            <span class="card-dot" aria-hidden="true" />
            <a class="card-section" href={sectionHref(base, section)}>
              {sectionLabel(section)}
            </a>
          </div>
          <div class="card-body">
            <span class="card-date">{fmtDateTime(post.data.pubDate)}</span>
            <h2 class="card-title">
              <a href={href(post.id)}>{post.data.title}</a>
            </h2>
            {post.data.description && <p class="card-desc">{post.data.description}</p>}
            {tags.length > 0 && (
              <div class="tags card-tags">
                {tags.map((t) => (
                  <a class="tag" href={tagHref(base, t)}>
                    {t}
                  </a>
                ))}
                {overflow > 0 && <span class="tag-nmore">+{overflow}</span>}
              </div>
            )}
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .post-cards {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    /* 폭에 따라 1~3열. 카드 최소 폭을 두어 좁은 화면에선 자동으로 1열이 된다. */
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-5);
  }
  /* ── 터미널 룩 ──
     고정폭 폰트 + 터미널 창 헤더 바 + 마커(// > #). 카테고리 색은 헤더의 점·[라벨]로. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--c-surface);
    transition: border-color 0.15s ease;
    /* 실제로 칠하는 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --hue-on: var(--hue);
  }
  :global(:root[data-theme="dark"]) .card {
    --hue-on: color-mix(in srgb, var(--hue) 58%, white);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .card {
      --hue-on: color-mix(in srgb, var(--hue) 58%, white);
    }
  }
  .card:hover {
    border-color: var(--hue-on);
  }
  /* 터미널 창 헤더 — 점 + [카테고리]. 카테고리 색을 옅게 깐 바. */
  .card-bar {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.45em 0.75em;
    border-bottom: 1px dashed var(--c-border);
    background: color-mix(in srgb, var(--hue-on) 7%, transparent);
  }
  .card-dot {
    flex: none;
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--hue-on);
  }
  .card-section {
    color: var(--hue-on);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-decoration: none;
  }
  .card-section::before { content: "["; opacity: 0.6; }
  .card-section::after { content: "]"; opacity: 0.6; }
  .card-section:hover { text-decoration: underline; }
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0.85em 0.9em 1em;
    gap: var(--space-2);
  }
  .card-date {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .card-date::before { content: "// "; opacity: 0.7; }
  .card-title {
    font-size: var(--fs-base);
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .card-title a {
    color: var(--c-text);
  }
  .card-title a:hover {
    color: var(--hue-on);
    text-decoration: none;
  }
  .card-desc {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
    margin: 0;
    /* 요약 길이가 제각각이라 3줄로 자른다 — 카드 높이가 들쭉날쭉해지는 걸 막는다. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-desc::before { content: "> "; color: var(--hue-on); }
  .card-tags {
    /* 태그는 항상 카드 바닥에 붙어 정렬선이 생기게 한다. */
    margin-top: auto;
    padding-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: 0.15em var(--space-3);
  }
  /* 터미널 카드 안에선 태그 '#'을 카테고리 색으로 — 프롬프트 마커처럼. */
  .card-tags .tag { font-family: var(--font-mono); }
  .card-tags .tag::before { color: var(--hue-on); opacity: 1; }
  .card-tags .tag-nmore { font-family: var(--font-mono); }
</style>
