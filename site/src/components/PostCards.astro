---
import type { CollectionEntry } from "astro:content";
import { tagHref } from "../lib/tags.ts";
import { fmtDateTime } from "../lib/date.ts";
import { sectionLabel, sectionHref, hueOf, sectionOf } from "../lib/sections.ts";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

/** 카드는 높이를 맞추므로 태그가 많아도 앞 3개만 노출(넘치면 +N). */
const TAG_MAX = 3;
---

<ul class="post-cards">
  {
    posts.map((post) => {
      const section = sectionOf(post);
      const tags = post.data.tags.slice(0, TAG_MAX);
      const overflow = post.data.tags.length - tags.length;
      return (
        <li class="card" style={`--hue: ${hueOf(section)}`}>
          <div class="card-top">
            <a class="card-section" href={sectionHref(base, section)}>
              {sectionLabel(section)}
            </a>
            <span class="card-date">{fmtDateTime(post.data.pubDate)}</span>
          </div>
          <h2 class="card-title">
            <a href={href(post.id)}>{post.data.title}</a>
          </h2>
          {post.data.description && <p class="card-desc">{post.data.description}</p>}
          {tags.length > 0 && (
            <div class="tags card-tags">
              {tags.map((t) => (
                <a class="tag" href={tagHref(base, t)}>
                  {t}
                </a>
              ))}
              {overflow > 0 && <span class="tag-nmore">+{overflow}</span>}
            </div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .post-cards {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    /* 폭에 따라 1~3열. 카드 최소 폭을 두어 좁은 화면에선 자동으로 1열이 된다. */
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-5) var(--space-5);
  }
  /* ── 네오-브루탈 룩 ──
     굵은 잉크 보더 + 오프셋 하드 섀도 + 각진 모서리 + 솔리드 카테고리 블록.
     잉크(보더·섀도)=var(--c-text)로 라이트/다크 반전. 카테고리 글자색=var(--c-bg). */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--c-surface);
    /* 브루탈 잉크를 순수 텍스트색이 아니라 부드러운 회색으로 낮춘다(진하기 완화). */
    --bru-ink: color-mix(in srgb, var(--c-text) 55%, var(--c-bg));
    border: 1.5px solid var(--bru-ink);
    border-radius: 0;
    box-shadow: 3px 3px 0 var(--bru-ink);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
    /* 실제로 칠하는 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --hue-on: var(--hue);
  }
  :global(:root[data-theme="dark"]) .card {
    --hue-on: color-mix(in srgb, var(--hue) 58%, white);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .card {
      --hue-on: color-mix(in srgb, var(--hue) 58%, white);
    }
  }
  .card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--hue-on);
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover { transform: none; }
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  /* 카테고리 솔리드 블록 */
  .card-section {
    display: inline-block;
    background: var(--hue-on);
    color: var(--c-bg);
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0.2em 0.55em;
    text-decoration: none;
  }
  .card-section:hover { text-decoration: underline; }
  .card-date {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-muted);
  }
  .card-title {
    font-size: var(--fs-lg);
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0.15em 0 0;
  }
  .card-title a {
    color: var(--c-text);
  }
  .card-title a:hover {
    text-decoration: none;
  }
  .card-desc {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
    margin: 0;
    /* 요약 길이가 제각각이라 3줄로 자른다 — 카드 높이가 들쭉날쭉해지는 걸 막는다. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* 태그 — 각진 보더 칩(고정폭), '#' 없이 */
  .card-tags {
    margin-top: auto;
    padding-top: var(--space-1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .card-tags .tag {
    font-family: var(--font-mono);
    border: 1px solid var(--bru-ink);
    border-radius: 0;
    padding: 0.05em 0.45em;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }
  .card-tags .tag::before { content: none; }
  .card-tags .tag:hover {
    background: var(--hue-on);
    color: var(--c-bg);
    border-color: var(--hue-on);
    text-decoration: none;
  }
  .card-tags .tag-nmore {
    font-family: var(--font-mono);
    border: 1px dashed var(--bru-ink);
    padding: 0.05em 0.45em;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }
</style>
