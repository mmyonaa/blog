---
import type { CollectionEntry } from "astro:content";
import { tagHref } from "../lib/tags.ts";
import { fmtDateTime } from "../lib/date.ts";
import { sectionLabel, sectionHref, hueOf, sectionOf, initialOf } from "../lib/sections.ts";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;

/** 카드는 높이를 맞추므로 태그가 많아도 앞 3개만 노출(넘치면 +N). */
const TAG_MAX = 3;
---

<ul class="post-cards">
  {
    posts.map((post) => {
      const section = sectionOf(post);
      const tags = post.data.tags.slice(0, TAG_MAX);
      const overflow = post.data.tags.length - tags.length;
      return (
        <li class="card" style={`--hue: ${hueOf(section)}`}>
          <div class="card-head">
            <a class="card-badge" href={sectionHref(base, section)} aria-label={sectionLabel(section)}>
              {initialOf(section)}
            </a>
            <div class="card-headtext">
              <h2 class="card-title">
                <a href={href(post.id)}>{post.data.title}</a>
              </h2>
              <span class="card-date">{fmtDateTime(post.data.pubDate)}</span>
            </div>
          </div>
          {post.data.description && <p class="card-desc">{post.data.description}</p>}
          {tags.length > 0 && (
            <div class="tags card-tags">
              {tags.map((t) => (
                <a class="tag" href={tagHref(base, t)}>
                  {t}
                </a>
              ))}
              {overflow > 0 && <span class="tag-nmore">+{overflow}</span>}
            </div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .post-cards {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    /* 폭에 따라 1~3열. 카드 최소 폭을 두어 좁은 화면에선 자동으로 1열이 된다.
       min(19rem,100%)로 두어 뷰포트가 19rem보다 좁아도(≤~340px) 열이 넘치지 않게 한다. */
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: var(--space-5) var(--space-5);
  }
  /* ── 심플 클린 카드(Maktub 참고) ──
     색 정사각형 배지에 대문자 이니셜 + 옆에 제목. 서브틀한 테두리·라운드·음영. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    /* 실제로 칠하는 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --hue-on: var(--hue);
  }
  :global(:root[data-theme="dark"]) .card {
    --hue-on: oklch(from var(--hue) 0.78 calc(c * 0.52) h);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .card {
      --hue-on: oklch(from var(--hue) 0.78 calc(c * 0.52) h);
    }
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--hue-on) 45%, var(--c-border));
    box-shadow: var(--shadow-md);
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover { transform: none; }
  }
  /* 헤더: 색 배지(이니셜) + 제목 */
  .card-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .card-headtext {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    min-width: 0;
  }
  /* 배지 글자색 var(--c-bg): --hue-on과 명도가 항상 반대라 대비 확보 */
  .card-badge {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: var(--hue-on);
    color: var(--c-bg);
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1;
    text-decoration: none;
  }
  .card-title {
    font-size: var(--fs-base);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .card-title a {
    color: var(--c-text);
    text-decoration: none;
  }
  .card-title a:hover {
    color: var(--hue-on);
    text-decoration: none;
  }
  .card-date {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .card-desc {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
    margin: 0;
    /* 요약 길이가 제각각이라 3줄로 자른다 — 카드 높이가 들쭉날쭉해지는 걸 막는다. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* 태그 — 낮은 톤 '#태그' 텍스트(전역 .tag) */
  .card-tags {
    margin-top: auto;
    padding-top: var(--space-1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.1em var(--space-3);
  }
  .card-tags .tag-nmore {
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }
</style>
