---
/**
 * 글 조회수(#66) — Supabase post_views를 브라우저가 직접 호출해 표시한다.
 * 표는 RLS로 잠겨 있고 increment_view/get_view 함수만 anon에 열려 있으므로
 * 번들에 노출되는 PUBLIC_ 키로 할 수 있는 일은 "조회수 1 올리기"뿐이다.
 * 키 미설정·요청 실패 시엔 자리를 비워 방문자에게 오류를 노출하지 않는다.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<span class="view-count" data-views-slug={slug}></span>

<script>
  // ClientRouter(SPA 전환)로 글을 옮겨 다녀도 글마다 다시 집계해야 하므로,
  // 리스너는 한 번만 등록하고 astro:page-load마다 현재 문서의 슬러그를 다시 읽는다.
  if (!(window as any).__viewCountBound) {
    (window as any).__viewCountBound = true;
    const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL;
    const SUPA_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    const load = async () => {
      const el = document.querySelector<HTMLElement>("[data-views-slug]");
      if (!el || !SUPA_URL || !SUPA_KEY) return;
      const slug = el.dataset.viewsSlug!;

      // 같은 세션 내 재방문·새로고침은 증가 없이 숫자만 읽는다(탭 닫으면 초기화).
      // sessionStorage 불가 환경(시크릿 모드 등)은 증가로 폴백 — 지표가 원래 근사치라 허용.
      let fn = "increment_view";
      try {
        const key = `viewed:${slug}`;
        if (sessionStorage.getItem(key)) fn = "get_view";
        else sessionStorage.setItem(key, "1");
      } catch {}

      try {
        const res = await fetch(`${SUPA_URL}/rest/v1/rpc/${fn}`, {
          method: "POST",
          headers: {
            apikey: SUPA_KEY,
            Authorization: `Bearer ${SUPA_KEY}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ post_slug: slug }),
        });
        if (res.ok) el.textContent = `조회 ${await res.json()}`;
      } catch {
        /* 실패 시 빈 자리 유지 */
      }
    };
    document.addEventListener("astro:page-load", load);
  }
</script>

<style>
  .view-count {
    font-variant-numeric: tabular-nums;
  }
  /* 숫자가 도착하기 전엔 자리 자체가 없던 것처럼 — 빈 span은 여백을 만들지 않는다 */
  .view-count:empty {
    display: none;
  }
</style>
