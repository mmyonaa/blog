---
// 글 하단 댓글 (#51): Cusdis — 로그인 없이(익명) 작성, 승인 후 공개.
// App ID 미설정이면 섹션을 렌더하지 않는다. 비공개 의견은 /feedback/(#49)으로 안내.
import { CUSDIS_APP_ID, CUSDIS_HOST, COMMENTS_ENABLED } from "../lib/comments.ts";
import { FEEDBACK_ENABLED, FEEDBACK_PAGE } from "../lib/feedback.ts";

interface Props {
  /** 댓글 스레드 식별자. URL이 바뀌어도 스레드가 유지되도록 post slug를 쓴다. */
  pageId: string;
  title: string;
}
const { pageId, title } = Astro.props;

const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
---

{
  COMMENTS_ENABLED && (
    <section class="comments" aria-label="댓글">
      <p class="comments-title">댓글</p>
      <p class="comments-hint">
        로그인 없이 남길 수 있어요. 남긴 댓글은 승인 후 공개됩니다.
        {FEEDBACK_ENABLED && (
          <>
            {" "}공개가 부담스러우면{" "}
            <a href={FEEDBACK_PAGE}>비공개로 의견 보내기 →</a>
          </>
        )}
      </p>
      <div
        id="cusdis_thread"
        data-host={CUSDIS_HOST}
        data-app-id={CUSDIS_APP_ID}
        data-page-id={pageId}
        data-page-url={pageUrl}
        data-page-title={title}
      />
    </section>
  )
}

<style>
  .comments {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-border);
  }
  .comments-title {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 var(--space-2);
  }
  .comments-hint {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-5);
  }
  #cusdis_thread {
    /* 지연 로딩 전 빈 영역이 0px이면 IntersectionObserver 진입이 늦어지고,
       로드 후 레이아웃이 크게 튀므로 최소 높이를 잡아둔다. */
    min-height: 16rem;
  }
</style>

<script>
  // Cusdis 로더. 문서 위임 패턴(한 번만 등록)으로 View Transitions에도 유지되고,
  // 페이지마다 astro:page-load에서 새 컨테이너를 찾아 초기화한다.
  if (!(window as any).__cusdisBound) {
    (window as any).__cusdisBound = true;

    const currentTheme = () =>
      document.documentElement.dataset.theme ??
      (window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light");

    // 사이트 테마 전환 → Cusdis SDK에 전달. 토글·astro:after-swap 재적용 모두
    // <html data-theme> 변경으로 나타나고, documentElement는 View Transitions에서도
    // 같은 노드라 옵저버가 유지된다.
    // setTheme은 SDK가 최초 렌더한 iframe에 postMessage하는데, View Transitions로
    // 문서가 교체되면 그 참조가 분리된 iframe이라 throw한다 → 그 경우 갱신된
    // data-theme으로 스레드를 다시 그려 테마를 반영한다.
    const syncTheme = () => {
      const CUSDIS = (window as any).CUSDIS;
      const box = document.getElementById("cusdis_thread");
      if (!CUSDIS || !box || !box.dataset.loaded) return;
      box.dataset.theme = currentTheme();
      try {
        CUSDIS.setTheme(currentTheme());
      } catch {
        box.querySelector("iframe")?.remove();
        try {
          CUSDIS.initial();
        } catch {
          /* 렌더 실패 시 조용히 넘어간다 */
        }
      }
    };
    new MutationObserver(syncTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", syncTheme);

    const addScript = (src: string) =>
      new Promise<void>((resolve, reject) => {
        const s = document.createElement("script");
        s.src = src;
        s.async = true;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error(src));
        document.head.appendChild(s);
      });

    let sdkLoading: Promise<void> | null = null;
    const load = async (box: HTMLElement) => {
      if (box.dataset.loaded) return;
      box.dataset.loaded = "1";
      box.dataset.theme = currentTheme();
      const host = box.dataset.host!;
      if (!sdkLoading) {
        // 한국어 언어팩은 본체보다 먼저 로드되어야 한다(window.CUSDIS_LOCALE 설정).
        sdkLoading = addScript(`${host}/js/widget/lang/ko.js`)
          .catch(() => {}) // 언어팩 실패는 영어 UI로 진행
          .then(() => addScript(`${host}/js/cusdis.es.js`));
      }
      try {
        await sdkLoading;
        // 본체 스크립트는 로드 시점에 #cusdis_thread를 자동 렌더한다.
        // View Transitions로 컨테이너가 교체된 뒤엔 수동 재렌더가 필요하다.
        const CUSDIS = (window as any).CUSDIS;
        if (CUSDIS && !box.querySelector("iframe")) CUSDIS.initial();
      } catch {
        /* SDK 로드 실패 시 조용히 넘어간다(댓글 없이도 글은 읽혀야 함) */
      }
    };

    // 지연 로딩: 컨테이너가 뷰포트 근처에 오면 그때 SDK를 붙인다.
    const init = () => {
      const box = document.getElementById("cusdis_thread");
      if (!box || box.dataset.loaded) return;
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load(box);
          }
        },
        { rootMargin: "600px 0px" },
      );
      io.observe(box);
    };
    document.addEventListener("astro:page-load", init);
  }
</script>
