---
// 글 하단 댓글(#46): giscus(GitHub Discussions) 위젯 + 익명 의견 안내.
// 댓글은 레포 Discussions(Announcements 카테고리)에 pathname 기준으로 쌓인다.
import { FEEDBACK_FORM_URL } from "../lib/feedback.ts";
---

<section class="comments" aria-label="댓글">
  <p class="comments-title">의견 남기기</p>
  <p class="comments-hint">
    이 글에 대한 의견은 아래 댓글로 남겨주세요 (GitHub 계정 필요).
    {
      FEEDBACK_FORM_URL && (
        <>
          {" "}로그인 없이 남기고 싶다면{" "}
          <a href={FEEDBACK_FORM_URL} target="_blank" rel="noopener noreferrer">
            익명 의견 보내기 →
          </a>
        </>
      )
    }
  </p>
  <div
    class="giscus"
    data-giscus
    data-repo="mmyonaa/mcp"
    data-repo-id="R_kgDOTYH1LQ"
    data-category="Announcements"
    data-category-id="DIC_kwDOTYH1Lc4DBjxi"
  >
  </div>
</section>

<style>
  .comments {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-border);
  }
  .comments-title {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 0 0 var(--space-2);
  }
  .comments-hint {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-5);
  }
  .giscus {
    /* 지연 로딩 전 빈 영역이 0px이면 IntersectionObserver 진입이 늦어지고,
       로드 후 레이아웃이 크게 튀므로 최소 높이를 잡아둔다. */
    min-height: 14rem;
  }
</style>

<script>
  // giscus 로더. 문서 위임 패턴(한 번만 등록)으로 View Transitions에도 유지되고,
  // 페이지마다 astro:page-load에서 새 컨테이너를 찾아 초기화한다.
  if (!(window as any).__giscusBound) {
    (window as any).__giscusBound = true;

    const currentTheme = () =>
      document.documentElement.dataset.theme ??
      (window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light");

    // 사이트 테마 전환 시 giscus iframe에도 postMessage로 전달.
    const syncTheme = () => {
      const frame = document.querySelector<HTMLIFrameElement>(
        "iframe.giscus-frame",
      );
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: currentTheme() } } },
        "https://giscus.app",
      );
    };
    // 토글·astro:after-swap 재적용 모두 <html data-theme> 변경으로 나타난다.
    // documentElement는 View Transitions에서도 같은 노드라 옵저버가 유지된다.
    new MutationObserver(syncTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", syncTheme);

    const load = (box: HTMLElement) => {
      if (box.dataset.loaded) return;
      box.dataset.loaded = "1";
      const s = document.createElement("script");
      s.src = "https://giscus.app/client.js";
      s.async = true;
      s.crossOrigin = "anonymous";
      const cfg: Record<string, string> = {
        repo: box.dataset.repo ?? "",
        repoId: box.dataset.repoId ?? "",
        category: box.dataset.category ?? "",
        categoryId: box.dataset.categoryId ?? "",
        mapping: "pathname",
        strict: "0",
        reactionsEnabled: "1",
        emitMetadata: "0",
        inputPosition: "bottom",
        theme: currentTheme(),
        lang: "ko",
      };
      for (const [k, v] of Object.entries(cfg)) s.dataset[k] = v;
      box.appendChild(s);
    };

    // 지연 로딩: 컨테이너가 뷰포트 근처에 오면 그때 스크립트를 붙인다.
    const init = () => {
      const box = document.querySelector<HTMLElement>("[data-giscus]");
      if (!box || box.dataset.loaded) return;
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load(box);
          }
        },
        { rootMargin: "600px 0px" },
      );
      io.observe(box);
    };
    document.addEventListener("astro:page-load", init);
  }
</script>
