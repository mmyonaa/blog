---
// 카테고리 필터 바. /blog/와 /categories/[section]/에 공통으로 놓는다.
// 클릭하면 해당 카테고리 페이지로 '이동'한다(경로 기반 페이지네이션과 맞물려
// 스케일에 안전). 현재 위치를 pill에 aria-current로 표시하고, '전체'로 초기화.
import { getSectionCounts, sectionHref, hueOf } from "../lib/sections.ts";
import ViewToggle from "./ViewToggle.astro";

const categories = await getSectionCounts();
const total = categories.reduce((n, c) => n + c.count, 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// 현재 카테고리(경로에서 추출). /categories/<id>/... 가 아니면 '전체'.
const current = /\/categories\/([^/]+)/.exec(Astro.url.pathname)?.[1] ?? "";
---

{
  categories.length > 0 && (
    <nav class="filter-links" aria-label="카테고리로 거르기">
      <span class="fl-label">카테고리</span>
      <a
        class="fl-pill fl-all"
        href={`${base}/blog/`}
        aria-current={current === "" ? "true" : undefined}
      >
        전체 <span class="fl-count">{total}</span>
      </a>
      {categories.map((c) => (
        <a
          class="fl-pill"
          href={sectionHref(base, c.id)}
          aria-current={current === c.id ? "true" : undefined}
          style={`--hue: ${hueOf(c.id)}`}
        >
          {c.label} <span class="fl-count">{c.count}</span>
        </a>
      ))}
      <div class="fl-more">
        <ViewToggle />
      </div>
    </nav>
  )
}

<style>
  .filter-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-5) 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--c-border);
  }
  .fl-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--c-muted);
    margin-right: var(--space-1);
  }
  .fl-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.25em 0;
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
    /* 실제로 칠하는 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --hue-on: var(--hue);
  }
  :global(:root[data-theme="dark"]) .fl-pill {
    --hue-on: color-mix(in srgb, var(--hue) 58%, white);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .fl-pill {
      --hue-on: color-mix(in srgb, var(--hue) 58%, white);
    }
  }
  /* 카테고리 색 점 — 카드 상단 띠와 같은 --hue를 써서 목록/필터의 색을 맞춘다. */
  .fl-pill::before {
    content: "";
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--hue-on);
    flex: none;
  }
  /* '전체'는 특정 색이 없으므로 중립 회색 점. */
  .fl-all {
    --hue: var(--c-muted);
  }
  a.fl-pill:hover {
    color: var(--hue-on);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  /* 현재 보고 있는 카테고리 — 색 밑줄로 위치를 분명히 한다. */
  .fl-pill[aria-current="true"] {
    color: var(--hue-on);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .fl-count {
    color: var(--c-muted);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .fl-more {
    margin-left: auto;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .fl-more {
      margin-left: 0;
    }
  }
</style>
