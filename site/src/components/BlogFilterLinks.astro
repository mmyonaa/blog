---
// 카테고리 필터 바. /blog/와 /categories/[section]/에 공통으로 놓는다.
// 클릭하면 해당 카테고리 페이지로 '이동'한다(경로 기반 페이지네이션과 맞물려
// 스케일에 안전). 현재 위치를 pill에 aria-current로 표시하고, '전체'로 초기화.
import { getSectionCounts, sectionHref, hueOf } from "../lib/sections.ts";
import ViewToggle from "./ViewToggle.astro";

const categories = await getSectionCounts();
const total = categories.reduce((n, c) => n + c.count, 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// 현재 카테고리(경로에서 추출). /categories/<id>/... 가 아니면 '전체'.
const current = /\/categories\/([^/]+)/.exec(Astro.url.pathname)?.[1] ?? "";
---

{
  categories.length > 0 && (
    <nav class="filter-links" aria-label="카테고리로 거르기">
      <div class="fl-bar">
        <a
          class="fl-pill fl-all"
          href={`${base}/blog/`}
          aria-current={current === "" ? "true" : undefined}
        >
          전체 <span class="fl-count">{total}</span>
        </a>
        {categories.map((c) => (
          <a
            class="fl-pill"
            href={sectionHref(base, c.id)}
            aria-current={current === c.id ? "true" : undefined}
            style={`--hue: ${hueOf(c.id)}`}
          >
            {c.label} <span class="fl-count">{c.count}</span>
          </a>
        ))}
      </div>
      <div class="fl-more">
        <ViewToggle />
      </div>
    </nav>
  )
}

<style>
  .filter-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-5) 0 var(--space-5);
  }
  /* ── 세그먼트 바 (Maktub 내비 참고) ── 하나의 둥근 컨테이너 안에 탭들이 들어간다. */
  .fl-bar {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem;
    padding: 0.3rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    background: var(--c-surface);
  }
  /* 탭 아이템 — 개별 보더/배경 없이 텍스트. 활성일 때만 색으로 채운다. */
  .fl-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.35em 0.85em;
    border-radius: var(--radius-pill);
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
    /* 실제로 칠하는 색. 다크 그라운드에선 어두운 hue가 안 보여 밝게 보정한다. */
    --hue-on: var(--hue);
  }
  :global(:root[data-theme="dark"]) .fl-pill {
    --hue-on: oklch(from var(--hue) 0.78 calc(c * 0.52) h);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .fl-pill {
      --hue-on: oklch(from var(--hue) 0.78 calc(c * 0.52) h);
    }
  }
  /* '전체'는 특정 색이 없으므로 중립(텍스트색). */
  .fl-all {
    --hue: var(--c-text);
  }
  a.fl-pill:hover {
    background: color-mix(in srgb, var(--hue-on) 12%, transparent);
    color: var(--hue-on);
    text-decoration: none;
  }
  /* 현재 보고 있는 카테고리 — 색으로 채워 위치를 분명히 한다. 글자색은 c-bg로 대비 확보. */
  .fl-pill[aria-current="true"] {
    background: var(--hue-on);
    border-color: var(--hue-on);
    color: var(--c-bg);
  }
  .fl-count {
    color: var(--c-muted);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .fl-pill[aria-current="true"] .fl-count {
    color: var(--c-bg);
    opacity: 0.8;
  }
  .fl-more {
    margin-left: auto;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .fl-more {
      margin-left: 0;
    }
  }
</style>
