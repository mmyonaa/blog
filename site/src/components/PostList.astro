---
import type { CollectionEntry } from "astro:content";
import { tagHref } from "../lib/tags.ts";
import { fmtDateTime } from "../lib/date.ts";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (id: string) => `${base}/blog/${id}/`;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <div class="muted post-date">{fmtDateTime(post.data.pubDate)}</div>
        <h2 class="post-title">
          <a href={href(post.id)}>{post.data.title}</a>
        </h2>
        {post.data.description && <p class="post-desc">{post.data.description}</p>}
        {post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((t) => (
              <a class="tag" href={tagHref(base, t)}>
                {t}
              </a>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    /* 브루탈 잉크를 부드러운 회색으로 낮춘다(진하기 완화). */
    --bru-ink: color-mix(in srgb, var(--c-text) 55%, var(--c-bg));
    padding: var(--space-5) 0;
    border-bottom: 1.5px solid var(--bru-ink);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-muted);
  }
  .post-title {
    font-size: var(--fs-xl);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: var(--space-1) 0 var(--space-2);
  }
  .post-title a {
    color: var(--c-text);
  }
  .post-title a:hover {
    color: var(--c-accent);
    text-decoration: none;
  }
  .post-desc {
    color: var(--c-muted);
    margin: 0 0 var(--space-3);
  }
  /* 태그 — 각진 보더 칩(고정폭), '#' 없이 */
  .tags .tag {
    font-family: var(--font-mono);
    border: 1px solid var(--bru-ink);
    border-radius: 0;
    padding: 0.05em 0.45em;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }
  .tags .tag::before { content: none; }
  .tags .tag:hover {
    background: var(--bru-ink);
    color: var(--c-bg);
    border-color: var(--bru-ink);
    text-decoration: none;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
