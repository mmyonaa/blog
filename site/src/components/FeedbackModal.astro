---
// 익명 의견 모달(#49). 페이지 이동 없이 어디서든 폼을 띄운다.
// [data-feedback-open] 클릭 또는 'feedback:open' 이벤트로 열린다.
// 폼이 비활성(키 없음)이면 아예 렌더하지 않는다 — 트리거도 조건부로 노출한다.
import { FEEDBACK_ENABLED, FEEDBACK_PAGE } from "../lib/feedback.ts";
import FeedbackForm from "./FeedbackForm.astro";

// /feedback/ 페이지는 폼을 본문에 직접 렌더하므로 모달은 띄우지 않는다(중복 방지).
const onFeedbackPage =
  Astro.url.pathname.replace(/\/$/, "") === FEEDBACK_PAGE.replace(/\/$/, "");
---

{
  FEEDBACK_ENABLED && !onFeedbackPage && (
    <div class="feedback-modal" data-feedback-modal hidden>
      <div class="feedback-backdrop" data-feedback-close />
      <div
        class="feedback-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="feedback-modal-title"
      >
        <div class="feedback-head">
          <div>
            <p class="feedback-modal-title" id="feedback-modal-title">
              비공개로 의견 보내기
            </p>
            <p class="feedback-modal-sub">
              작성자에게만 전달돼요. 이름·이메일을 비우면 완전 익명입니다.
            </p>
          </div>
          <button
            type="button"
            class="feedback-x"
            data-feedback-close
            aria-label="닫기"
          >
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <path
                d="M5 5l10 10M15 5L5 15"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>
        <FeedbackForm />
      </div>
    </div>
  )
}

<style>
  .feedback-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: var(--space-8) var(--space-4);
    overflow-y: auto;
  }
  .feedback-modal[hidden] {
    display: none;
  }
  .feedback-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }
  .feedback-panel {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-6);
    animation: feedback-in 0.14s ease;
  }
  @keyframes feedback-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feedback-panel {
      animation: none;
    }
  }
  .feedback-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .feedback-modal-title {
    font-size: var(--fs-lg);
    font-weight: 700;
    margin: 0;
  }
  .feedback-modal-sub {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    margin: var(--space-1) 0 0;
  }
  .feedback-x {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    background: var(--c-surface);
    color: var(--c-muted);
    cursor: pointer;
  }
  .feedback-x:hover {
    color: var(--c-text);
    border-color: var(--c-accent);
  }
</style>

<script>
  // 모달 열고/닫기. 문서 위임(한 번만 등록)으로 View Transitions에도 유지.
  if (!(window as any).__feedbackModalBound) {
    (window as any).__feedbackModalBound = true;

    const modal = () =>
      document.querySelector<HTMLElement>("[data-feedback-modal]");
    const isOpen = () => {
      const m = modal();
      return !!m && !m.hasAttribute("hidden");
    };

    let lastFocus: HTMLElement | null = null;
    const open = () => {
      const m = modal();
      if (!m) return;
      lastFocus = document.activeElement as HTMLElement;
      m.removeAttribute("hidden");
      document.body.style.overflow = "hidden";
      m.querySelector<HTMLTextAreaElement>("textarea[name=message]")?.focus();
    };
    const close = () => {
      const m = modal();
      if (!m) return;
      m.setAttribute("hidden", "");
      document.body.style.overflow = "";
      lastFocus?.focus();
    };

    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-feedback-open]")) {
        e.preventDefault();
        open();
      } else if (t.closest("[data-feedback-close]")) {
        close();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (!isOpen()) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      } else if (e.key === "Tab") {
        // 포커스 트랩: 패널 안에서만 순환
        const panel = document.querySelector<HTMLElement>(".feedback-panel");
        if (!panel) return;
        const f = panel.querySelectorAll<HTMLElement>(
          'a[href], button, input, textarea, [tabindex]:not([tabindex="-1"])',
        );
        if (!f.length) return;
        const first = f[0];
        const last = f[f.length - 1];
        const active = document.activeElement as HTMLElement;
        if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // 네이티브 폴백 제출 후 ?sent=1 복귀 시 FeedbackForm이 모달을 다시 열도록 요청.
    document.addEventListener("feedback:open", open);
  }
</script>
